[oploc1,mournerstewdoorup] 
// Mourning's End Part I: the full uniform passes the mourner on this door too.
if(~check_axis(coord, loc_coord, loc_angle) = false & inv_total(worn, doctor_gown) = 0 & ~mourning_hq_admits = false) {
    mes("The mourner is refusing to open the door.");
    return;
}
~open_and_close_door2(mournerstewdoorupopen, ~check_axis(coord, loc_coord, loc_angle), door_open);

[oploc1,mournerstewdoor] 
if(~check_axis(coord, loc_coord, loc_angle) = false) {
    ~open_and_close_door2(mournerstewdooropen, ~check_axis(coord, loc_coord, loc_angle), door_open);
} else if(~mourning_hq_admits = true) {
    @mourning_hq_front_door;
} else {
    @west_ardougne_mourner_headquarters_doors;
}

[oploc1,ardougnedoor_l] @west_ardougne_open_city_doors;
[oploc1,ardougnedoor_r] @west_ardougne_open_city_doors;

[oploc1,bravekdoorshut]
switch_int(%elenaquest) {
    case ^quest_elena_spoke_to_clerk, ^quest_elena_spoke_to_bravek, ^quest_elena_spoke_cured_bravek, ^quest_elena_freed_elena, ^elena_complete, ^elena_complete_read_scroll : @bravek_enter_room;
    case default : @bravek_go_away_im_busy;
}

[label,west_ardougne_open_city_doors]
mes("You pull on the large wooden doors...");
if(%biohazard = ^biohazard_complete) {
    def_coord $loc_coord = loc_coord;
    mes("...You open them and walk through.");
    // SWING EACH LEAF, do not swap the halves and do not reach for the _open locs.
    //
    // What was here swapped the two halves with each other. Read against the map it does move
    // something - each piece jumps 96 units to the opposite face of its own tile - but it stays
    // square across the gateway, so the gate still reads as shut and the player slides through a
    // closed-looking gate (tracker issue 20).
    //
    // ardougnedoor_l_open and ardougnedoor_r_open look like the answer and are a trap. The MODEL
    // they name is not in this content: models/loc holds one Ardougne door, ardougnedoor_l_open_1,
    // and model.pack lists one. The packer falls back to a shape-suffix search, lands back on that
    // same shut model and registers it under shape 0 - while these four are placed at shape 10
    // (maps/m39_51.jm2). LocType.method565 returns null for a shape that is not in the list, so
    // using those locs here draws NOTHING: four gate-shaped holes in the wall for five ticks.
    //
    // So the leaf is turned instead. A quarter turn about the tile centre takes it from spanning
    // the tile north-south, filling the gateway, to spanning it east-west, clear of it - the same
    // trick ~open_and_close_door2 plays on wall doors, which is all the cache gives us to work
    // with. The direction is not a guess: the opening spans z 3299..3300, so the south leaf turns
    // south and the north leaf turns north, away from where the two meet. Reading the model's own
    // vertices, that is angle 3 for the pair at local z 35 and angle 1 for the pair at local z 36,
    // whichever half and whichever map angle each tile started from.
    if(loc_find(0_39_51_62_36, ardougnedoor_r) = true) {
        loc_add(loc_coord, ardougnedoor_r, 1, loc_shape, 5);
    }
    if(loc_find(0_39_51_61_36, ardougnedoor_l) = true) {
        loc_add(loc_coord, ardougnedoor_l, 1, loc_shape, 5);
    }
    if(loc_find(0_39_51_62_35, ardougnedoor_l) = true) {
        loc_add(loc_coord, ardougnedoor_l, 3, loc_shape, 5);
    }
    if(loc_find(0_39_51_61_35, ardougnedoor_r) = true) {
        loc_add(loc_coord, ardougnedoor_r, 3, loc_shape, 5);
    }
    sound_synth(coffin_open, 1, 0);
    if(coordx(coord) < coordx(loc_coord)) {
        ~forcemove(movecoord($loc_coord, 2, 0, 0));
    } else {
        ~forcemove(movecoord($loc_coord, -2, 0, 0));
    }
    return;
}
p_delay(1);
mes("...But they will not open.");

[label,west_ardougne_mourner_headquarters_doors]
switch_int(%biohazard) {
    case ^biohazard_poisoned_stew, ^biohazard_found_distillator :
        if(inv_total(worn, doctor_gown) > 0) {
            ~chatnpc_specific(nc_name(mourner_armed), mourner_armed, "<p,neutral>In you go doc.");
            if_close;
            ~open_and_close_door2(mournerstewdooropen, ~check_axis(coord, loc_coord, loc_angle), door_open);
            return;
        }
        ~chatnpc_specific(nc_name(mourner_armed), mourner_armed, "<p,neutral>Stay away from there.");
        ~chatplayer("<p,quiz>Why?");
        // https://web.archive.org/web/20060111205550im_/http://www.runeweb.net/fireball/Biohazard%20Images/biohazard10.PNG
        ~chatnpc_specific(nc_name(mourner_armed), mourner_armed, "<p,neutral>Several mourners are ill with food poisoning,|we're waiting for a doctor.");
    case ^biohazard_climbed_ladder, ^biohazard_given_distillator, ^biohazard_spoken_chemist, ^biohazard_found_secret, ^biohazard_reported_elena, ^biohazard_complete : ~mesbox("The door is locked. You can hear the mourners eating... You need to distract them from their stew.");
    case default : ~chatnpc_specific(nc_name(mourner_armed), mourner_armed, "<p,angry>Who are you? Go away!");
}

[label,bravek_go_away_im_busy]
~chatnpc_specific(nc_name(bravek), bravek, "<p,angry>Go away, I'm busy! I'm... Umm... In a meeting!");

[label,bravek_enter_room]
~open_and_close_door2(loc_param(next_loc_stage), ~check_axis(coord, loc_coord, loc_angle), door_open);
