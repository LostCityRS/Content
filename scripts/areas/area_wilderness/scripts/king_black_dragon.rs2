[ai_queue1,king_dragon] ~npc_default_retaliate_ap;

// THE BREATH THAT REACHES SOMEBODY RUNNING AWAY (2026-11-02).
//
// WHY A TIMER AND NOT A TRIGGER. Neither ai_applayer2 nor ai_opplayer2 fires while the npc is
// walking after a player it has not reached - the engine runs them on arrival, not on the way - so
// a player who simply keeps moving was chased in silence. Measured against Dagannoth Supreme,
// which stays in applayer2 and never hands over: a player pinned eight tiles out for sixty ticks
// took 17 hits from Supreme and NONE from the dragon. A timer is the only thing here that gets a
// turn every tick regardless of what mode the chase has put it in, which is the whole point. With
// it the same kite takes 11, against a ceiling of 12 at a 5-tick attack cadence.
//
// AND THE TIMER IS CONFIG, NOT [ai_spawn]. npc_settimer at spawn looks equivalent and is not:
// Npc.resetDefaults writes timerInterval back to the TYPE's timer, and it runs the moment the npc
// gives up on a target it cannot reach - which for a chasing dragon is a couple of ticks into the
// chase, precisely when this is wanted. Armed from an [ai_spawn,king_dragon] the timer fired twice
// and then went quiet for the whole sixty-tick kite. timer=1 in npc/configs/dragons.npc survives
// the reset, because the reset is what reads it.
//
// It does NOT duplicate the two triggers: it checks whether the dragon can reach you, and if it
// can, does nothing and leaves the fight to them. Everything else is the same guard they use, in
// the same order.
//
// %npc_action_delay is what stops this being a second attack rather than the same one from further
// away - ~kbd_dragonfire_far sets it, exactly as the close attacks do, so the dragon still breathes
// on its own cadence whoever asked for it.
[ai_timer,king_dragon]
if (%npc_action_delay > map_clock) {
    return;
}
// Whoever it is fighting. An ai_ trigger does not start with an active player, and a timer is not
// handed one at all, so the fight's own uid is the only way to find them from here.
if (finduid(%npc_attacking_uid) = false) {
    return;
}
// Within the breath's reach. 15 is the dragon's own attackrange in npc/configs/dragons.npc, which
// is what the engine already uses to decide when ai_applayer2 may fire; without this it would burn
// somebody who had left the lair entirely.
if (distance(npc_coord, coord) > ^kbd_breath_range) {
    return;
}
// It can reach them: the ordinary triggers have the fight in hand and will do it better.
if (npc_canreach = true) {
    return;
}
if (~npc_check_notcombat = false) {
    return;
}
if (~npc_check_notcombat_self = false) {
    return;
}
~kbd_dragonfire_far;

[ai_applayer2,king_dragon]
if (%npc_action_delay > map_clock) {
    return;
}
if (~npc_check_notcombat = false) {
    npc_setmode(null);
    return;
}
if (~npc_check_notcombat_self = false) {
    return;
}
// kbd can attack from a distance but can also be safespoted
// - https://imgur.com/9ervTTQ
// - https://imgur.com/otGvibL
// out of melee reach (npc_canreach: beside it, not across a corner or a safespot's wall), it breathes
if (npc_canreach = false) {
    ~kbd_dragonfire_far;
    // AND IT STAYS THERE BREATHING. Without this return it dropped straight into opplayer2 below,
    // which is "go and interact" - so it breathed exactly once, walked into melee, and from then
    // on only ever acted when it could reach you. Reported as "only attacks when it is within
    // melee range". applayer2's own range is the npc's attackrange (15), so staying in it means
    // it keeps breathing at whatever distance it found you, which is what the comment above this
    // branch has always said it does.
    return;
}
npc_sethuntmode(aggressive_melee);
npc_setmode(opplayer2);


[ai_opplayer2,king_dragon]
//mes("<tostring(map_clock)>: Op");
if (%npc_action_delay > map_clock) {
    return;
}
if (~npc_check_notcombat = false) {
    npc_setmode(null);
    return;
}
if (~npc_check_notcombat_self = false) {
    return;
}
// AND THE SAME TEST ON THIS SIDE. ai_applayer2 hands over to opplayer2 once it can reach you, and
// opplayer2 is where it stays - so anything that puts you out of reach AFTER the fight has started
// left it with no branch that attacks: ~kbd_random_attack's three attacks are all close-quarters,
// and the far breath lives in the trigger it had already left. A wall between you and it is the
// case the comment at the top of this file has always described ("can also be safespoted"), and it
// is the one that was reported: it only ever acted when it could reach you.
if (npc_canreach = false) {
    ~kbd_dragonfire_far;
    npc_setmode(applayer2);
    return;
}
~kbd_random_attack;
npc_sethuntmode(cowardly);


// THE BREATH ANIMATION COMES FROM THE CONFIG NOW, and that is the whole of DeathPlateau-Bugs#56
// ("kbds animation is bugged").
//
// There are TWO king black dragon models in this build. npc_king_dragon is the 377-native one -
// black_dragon still uses it - and npc_king_dragon_1..5 is the OSRS import, which is what
// king_dragon wears today. The dragon_firebreath_* seqs this script used to name were authored
// against the 377 mesh. Posed on it with tools/pose377.py they are a clean rear-and-breathe; posed
// on the OSRS mesh the npc actually wears, the tail and legs stretch into flat spikes and the back
// half collapses. The npc was re-modelled and the animations in this file were never told.
//
// npc_param(attack_anim) is osrs_seq_91, which npc/configs/dragons.npc already declares beside the
// matching osrs_seq_89/90/92, and which poses correctly on that mesh. Reading the param rather than
// naming a seq is the point: the next re-model only has to change the config, and this file cannot
// drift away from it again.
//
// WHAT THIS COSTS: the four calls below used to name a middle / left / right / all-heads variant,
// and the OSRS import has one attack animation, so all three heads now move together. That is a
// real loss against a visibly broken animation, and it is the trade this fix makes.
[proc,kbd_random_attack]
// 1/3 chance to do melee/fire/special
def_int $random_attack = random(3);
if ($random_attack = 0) {
    ~kbd_dragonfire_close;
} else if ($random_attack = 1) {
    ~kbd_special_breath;
} else {
    ~dragon_melee;
}
// ------------
// far range fire breath
[proc,kbd_dragonfire_far]
if_close;
def_coord $npc_coord = movecoord(npc_coord, 2, 0, 2);
def_coord $player_coord = coord;
def_coord $projectile_coord;

def_int $z = calc(coordz($npc_coord) - coordz($player_coord));
def_int $x = calc(coordx($npc_coord) - coordx($player_coord));
// do corners first
if (calc($z / 2) <= $x & calc($x / 2) <= $z) { // south-west
    $projectile_coord = movecoord($npc_coord, -1, 0, -1);
} else if (calc($z / 2) <= multiply($x, -1) & calc($x / 2) >= multiply($z, -1)) { // south-east
    $projectile_coord = movecoord($npc_coord, 1, 0, -1);
} else if (calc($x / 2) >= $z & calc($z / 2) >= $x) { // north-east
    $projectile_coord = movecoord($npc_coord, 1, 0, 1);
} else if (calc($z / 2) >= multiply($x, -1) & calc($z / 2 * -1) >= $x) { // north-west
    $projectile_coord = movecoord($npc_coord, -1, 0, 1);
} else if (calc($x / 2) <= $z & calc($z / 2) >= $x) { // south
    $projectile_coord = movecoord($npc_coord, 0, 0, -1);
}  else if (calc($x / 2) <= $z & calc($x / 2) <= multiply($z, -1)) { // east
    $projectile_coord = movecoord($npc_coord, 1, 0, 0);
} else if (calc($z / 2) <= $x & calc($z / 2 * -1) >= $x) { // north
    $projectile_coord = movecoord($npc_coord, 0, 0, 1);
} else { // west
    $projectile_coord = movecoord($npc_coord, -1, 0, 0);
}
def_int $duration = ~player_projectile($projectile_coord, coord, uid, firebreath_travel, 92, 31, 51, 16, -5, 64, 10);

npc_anim(npc_param(attack_anim), 0);
sound_synth(dragonbreath, 1, 30);
spotanim_pl(fireblast_impact, 124, $duration); // https://web.archive.org/web/20040928200427/http://rsblacknights.com/modules/gallery/images/KingBlackDragon/kb3.JPG
%npc_action_delay = add(map_clock, 5);

def_int $damage = 0;

def_int $attack_roll = ~npc_magic_attack_roll;
def_int $defence_roll = ~player_defence_roll_specific(^magic_style);
if (randominc($attack_roll) > randominc($defence_roll)) {
    $damage = randominc(~kbd_fiery_breath_maxhit);
    if (%prayer12 = ^false & ~has_antidragon_shield = false) {
        mes("You're horribly burnt by the dragon's fiery breath!"); // https://youtu.be/R3ozXHcQkgs?list=PLn23LiLYLb1bYAFU3Vdk3N9niuHs-b-4-&t=78
    }
}
queue(combat_damage_player, calc($duration / 30), $damage);
queue*(playerhit_n_retaliate, calc($duration / 30))(npc_uid);
~npc_set_attack_vars;
// ------------


// ------------
// close range fire breath
[proc,kbd_dragonfire_close]
if_close;
spotanim_npc(triple_firebreath_attack, 92, 0);
npc_anim(npc_param(attack_anim), 0);
sound_synth(dragonbreath, 1, 30);
%npc_action_delay = add(map_clock, 5);

def_int $damage = 0;

def_int $attack_roll = ~npc_magic_attack_roll;
def_int $defence_roll = ~player_defence_roll_specific(^magic_style);
if (randominc($attack_roll) > randominc($defence_roll)) {
    $damage = randominc(~kbd_fiery_breath_maxhit);
    if (%prayer12 = ^false & ~has_antidragon_shield = false) {
        mes("You're horribly burnt by the dragon's fiery breath!"); // https://youtu.be/R3ozXHcQkgs?list=PLn23LiLYLb1bYAFU3Vdk3N9niuHs-b-4-&t=78
    }

}
queue(combat_damage_player, 0, $damage);
queue*(playerhit_n_retaliate, 0)(npc_uid);
~npc_set_attack_vars;

// ------------
// toxic breath
[proc,kbd_toxic_breath]
if_close;
spotanim_npc(acidbreath_attack, 92, 0);
npc_anim(npc_param(attack_anim), 0);

sound_synth(toxicbreath, 1, 30);
%npc_action_delay = add(map_clock, 5);

def_int $damage = 0;

def_int $attack_roll = ~npc_magic_attack_roll;
def_int $defence_roll = ~player_defence_roll_specific(^magic_style);
if (randominc($attack_roll) > randominc($defence_roll)) {
    $damage = randominc(~kbd_special_breath_maxhit);
    def_int $random = random(2); // 50% chance upon successful hit to inflict a unique effect (osrs)
    if (~has_antidragon_shield = true) { // Not sure what it is exactly, ash says "Well protect player"
        $random = random(8); // 1/8 chance (osrs).
        if ($random ! 0) {
            mes("Your shield absorbs most of the dragon's toxic breath!"); // https://youtu.be/KhI0x-fSKac?list=PLn23LiLYLb1bYAFU3Vdk3N9niuHs-b-4-&t=157
        }
    }
    if ($random = 0) {
        queue(poison_player, 0, 36); // poison the player starting at 8 damage
    }
}
queue(combat_damage_player, 0, $damage);
queue*(playerhit_n_retaliate, 0)(npc_uid);
~npc_set_attack_vars;

// ------------
// shocking breath
[proc,kbd_shocking_breath]
if_close;
// spotanim_npc(portal, 92, 0);
npc_anim(npc_param(attack_anim), 0);
sound_synth(lightningbreath, 1, 30);
spotanim_pl(nezik_flamestrike, 0, 60);
%npc_action_delay = add(map_clock, 5);

def_int $damage = 0;

def_int $attack_roll = ~npc_magic_attack_roll;
def_int $defence_roll = ~player_defence_roll_specific(^magic_style);
if (randominc($attack_roll) > randominc($defence_roll)) {
    $damage = randominc(~kbd_special_breath_maxhit);
    def_int $random = random(2); // 50% chance upon successful hit to inflict a unique effect (osrs)
    if (%prayer12 = ^true & ~has_antidragon_shield = true) {
        $random = random(8); // 1/8 chance (osrs). Not sure what it is exactly, ash says "Well protect player"
        if ($random ! 0) {
            mes("Your shield absorbs most of the dragon's shocking breath!"); // https://youtu.be/iXYRtqL-GNw?t=9
        }
    }
    if ($random = 0) {
        // mes("You're shocked and weakened!"); // https://youtu.be/R3ozXHcQkgs?list=PLn23LiLYLb1bYAFU3Vdk3N9niuHs-b-4-&t=106
        mes("You're zapped by the dragon's shocking breath!"); // earlier video has this: https://youtu.be/Kc0ZMLmWrYU?list=PLn23LiLYLb1bYAFU3Vdk3N9niuHs-b-4-&t=20
        // reduce every stat except hitpoints by 2
        def_int $i = 1;
        def_stat $stat;
        while ($i <= enum_getoutputcount(stats)) {
            $stat = enum(int, stat, stats, $i);
            if ($stat ! hitpoints) {
                stat_sub($stat, 2, 0);
            }
            $i = calc($i + 1);
        }
    }
}
queue(combat_damage_player, 0, $damage);
queue*(playerhit_n_retaliate, 0)(npc_uid);
~npc_set_attack_vars;
// ------------

// ------------
// icy breath
[proc,kbd_icy_breath]
// find spot anims and dragon anims for this
if_close;

spotanim_npc(icebreath_attack, 92, 0);
npc_anim(npc_param(attack_anim), 0);

sound_synth(kingicebreath, 1, 30);
%npc_action_delay = add(map_clock, 5);

// freeze player
def_int $damage = 0;

def_int $attack_roll = ~npc_magic_attack_roll;
def_int $defence_roll = ~player_defence_roll_specific(^magic_style);
if (randominc($attack_roll) > randominc($defence_roll)) {
    $damage = randominc(~kbd_special_breath_maxhit);
    def_int $random = random(2); // 50% chance upon successful hit to inflict a unique effect (osrs)
    if (~has_antidragon_shield = true) { // Not sure what it is exactly, ash says "Well protect player"
        $random = random(8); // 1/8 chance (osrs). 
        if ($random ! 0) {
            mes("Your shield absorbs most of the dragon's icy breath!"); // https://youtu.be/91eqk3Lu_Qw?list=PLn23LiLYLb1bYAFU3Vdk3N9niuHs-b-4-&t=70
        }
    }
    if ($random = 0) { 
        queue(kbd_freeze_player, 0, 10); // freeze the player
    }
}
queue(combat_damage_player, 0, $damage);
queue*(playerhit_n_retaliate, 0)(npc_uid);
~npc_set_attack_vars;

[queue,kbd_freeze_player](int $duration)
mes("You've been frozen!");
%frozen = calc(map_clock + $duration + 1);
walktrigger(kbd_frozen);

[walktrigger,kbd_frozen]
if (map_clock < %frozen) {
    mes("You're frozen and can't move!"); // https://youtu.be/7nY0kuIooZk?list=PLn23LiLYLb1bYAFU3Vdk3N9niuHs-b-4-&t=218
    p_walk(coord);
    walktrigger(kbd_frozen);
}
// ------------


// ------------
// random attack
[proc,kbd_special_breath]
def_int $random_attack = random(3);
if ($random_attack = 0) {
    ~kbd_toxic_breath;
} else if ($random_attack = 1) {
    ~kbd_icy_breath;
} else {
    ~kbd_shocking_breath;
}


[proc,kbd_fiery_breath_maxhit]()(int)
def_int $maxhit = 65;
if (%prayer12 = ^true) {
    mes("You manage to resist some of the dragon's fiery breath!"); // https://youtu.be/R3ozXHcQkgs?list=PLn23LiLYLb1bYAFU3Vdk3N9niuHs-b-4-&t=78
    $maxhit = 20;
}
if (~has_antidragon_shield = true) {
    mes("Your shield absorbs most of the dragon's fiery breath!");
    $maxhit = 15;
    // A charge, because this is ordinary dragonfire. His toxic, shocking and icy breaths are not,
    // and Old School charges the shield off "adult dragon dragonfire" and wyvern icy breath only.
    // ~dfs_absorb writes a varp, and an ai_ trigger does not start with the protected active
    // player - same p_finduid shape skeletal_wyvern.rs2 documents for its freeze.
    if (p_finduid(uid) = true) {
        ~dfs_absorb;
    }
}
if (map_clock < %dragonresist) {
    mes("Your potion protects you from the heat of the dragon's breath!"); // https://youtu.be/7nY0kuIooZk?list=PLn23LiLYLb1bYAFU3Vdk3N9niuHs-b-4-&t=45
    $maxhit = sub($maxhit, 15);
}
return($maxhit);


[proc,kbd_special_breath_maxhit]()(int)
def_int $maxhit = 50;
if (%prayer12 = ^true) {
    $maxhit = 15;
}
if (~has_antidragon_shield = true) {
    $maxhit = 10;
}
return($maxhit);

[oploc1,dragonkinginlever]
p_delay(0); // delay in osrs? isntead of arrivedelay
anim(human_leverdown, 0); // OSRS uses seq's not in 225, going to assume here
sound_synth(lever, 1, 0);
// Temp note: dur updated
loc_change(hauntedleverdown, 7);
if_close;
p_delay(0);
mes("You pull the lever...");
p_delay(0);


~player_teleport_normal(0_35_73_31_8);
mes("...And teleport into the Dragon's Lair.");

[oploc1,dragonkingoutlever]
p_arrivedelay;
anim(human_leverdown, 0); // OSRS uses seq's not in 225, going to assume here
sound_synth(lever, 1, 0);
// Temp note: dur updated
loc_change(hauntedleverdown, 7);
if_close;
p_delay(0);
mes("You pull the lever...");
p_delay(0);

~player_teleport_normal(0_47_160_59_14); // not sure if its an area or just right next to the lever
mes("...And teleport out of the Dragon's Lair.");
