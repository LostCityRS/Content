// Asset lines (name/model/size/anims/vislevel/resize/ambient/op) generated by
// 3rd/rscache/tools/port_lostcity from cache.osrs239 — see README.md in this
// area for the exact command. Combat stats, params and hunt modes are
// hand-authored from the Kronos encounter data and are NOT regenerated, so
// re-running the exporter overwrites this file and they have to be put back.

[inferno_zuk]
