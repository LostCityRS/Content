// HIS TALK-TO HAS TO BE HIS OWN, and this is the whole of DeathPlateau-Bugs#94. He carries
// category=shop_keeper, so shop/scripts/shop.rs2's [opnpc1,_shop_keeper] answered his Talk-to,
// asked "Can I help you at all?", and then called ~openshop_activenpc - which reads the till off
// npc_param(owned_shop). He is the only shopkeeper in the category WITHOUT that param, because his
// till is picked by the script below rather than configured, so it read null, inv_transmit was
// handed -1, and the script error logged the player out.
//
// Same question, his own three tills. getByTrigger resolves type before category, so declaring
// [opnpc1] here takes his Talk-to off the generic one for good.
[opnpc1,rag_wine_merchant]
if (~shop_keeper_asks = false) {
    return;
}
~openshop_fortunato;

[opnpc3,rag_wine_merchant]
~openshop_fortunato;

[proc,openshop_fortunato]
if(map_members = ^true) {
    // The varp the TODO here was waiting on is %rag_quest, and wine_vinegar_merchant was already
    // stocked for this (rag_vinegar, 500 @ 10gp) - it just had nothing pointing at it. The vinegar
    // appears once the Odd Old Man has asked for it and stays on the shelf afterwards, which is
    // what part two will want anyway.
    if(%rag_quest >= ^rag_started) {
        ~openshop(wine_vinegar_merchant, 600, 1000, 20, "Wine Shop.");
        return;
    }
    ~openshop(wine_merchant, 600, 1000, 20, "Wine Shop.");
} else {
    ~openshop(wine_merchant_free, 600, 1000, 20, "Wine Shop.");
}
