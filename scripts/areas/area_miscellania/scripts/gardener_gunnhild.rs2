// Note: Gunnhild is at 0,30,12 instead of 0,29,10 because of the dummy weed position that she is weeding at.

[opnpc1,misc_gardener]
if (%misc_quest = ^misc_complete) {
    ~chatnpcnoturn("<~man_misc_mesanim>Good day, Your Royal Highness.");
} else {
    ~chatnpcnoturn("<~man_misc_mesanim>Hello.");
}
@multi2(
    "Gardener Gunnhild.", gunnhild_main_talk,
    "Your approval rating.", misc_quest_approval_rating
);

[label,gunnhild_main_talk]
~chatplayer("<p,neutral>Good day. What are you doing?");
~chatnpcnoturn("<~man_misc_mesanim>I'm weeding this herb garden. It's hard work! I also sell a few gardening supplies.");
@multi2(
    "Good luck with that.", gunnhild_good_luck,
    "What do you have for sale?", gunnhild_buy_stuff
);

[label,gunnhild_good_luck]
~chatplayer("<p,neutral>Good luck with that.");
if (%misc_quest = ^misc_complete) {
    ~chatnpcnoturn("<~man_misc_mesanim>Thank you, Your Royal Highness.");
} else {
    ~chatnpcnoturn("<~man_misc_mesanim>Thanks.");
}

// Below here, gunnhild sells rakes and iron sickles.
// Before the patch turned into a weeding patch, it is a bunch of herbs around that you can weed with an IRON SICKLE.
// After the patch turned into a weeding patch, it is a square of unwalkable weeds that you can weed only with a RAKE.
// The conversation is modified so that you can only get an iron sickle before the rake exists in June 2005.

[label,gunnhild_buy_stuff]
~chatplayer("<p,neutral>What do you have for sale?");
// ~chatnpcnoturn("<p,neutral>At the moment I'm selling garden rakes and iron sickles. They're 15gp each, if you'd like one?");
~chatnpcnoturn("<p,neutral>At the moment I'm selling iron sickles. They're 15gp each, if you'd like one?");
@multi3(
    // "I'd like a rake, please.", gunnhild_buy_rake,
    "I'd like an iron sickle, please.", gunnhild_buy_sickle,
    "No, thank you.", gunnhild_no_thanks,
    "What are iron sickles for?", gunnhild_sickle_info
);

// [label,gunnhild_buy_rake]
// ~chatplayer("<p,neutral>I'd like a rake, please.");
// if (inv_total(inv, coins) >= 15) {
//     inv_del(inv, coins, 15);
//     inv_add(inv, rake, 1);
//     ~chatnpcnoturn("<p,neutral>Thank you! Here you go.");
// }

[label,gunnhild_buy_sickle]
if (inv_total(inv, coins) >= 15) {
    ~chatplayer("<p,neutral>I'd like an iron sickle, please.");
    inv_del(inv, coins, 15);
    inv_add(inv, iron_sickle, 1);
    ~chatnpcnoturn("<p,neutral>Thank you! Here you go.");
} else {
    ~chatplayer("<p,neutral>I don't have enough money.");
}

[label,gunnhild_no_thanks]
~chatplayer("<p,neutral>No, thank you.");

[label,gunnhild_sickle_info]
~chatplayer("<~man_misc_mesanim>What are iron sickles for?");
// This is authentic, but before it became a farming patch, this is actually used to cut weeds. // https://runescape.wiki/w/Iron_sickle
// ~chatnpcnoturn("<~man_misc_mesanim>I can't think of anything just now. But you can buy one if you like!");
~chatnpcnoturn("<~man_misc_mesanim>You can use it to cut weeds from the herbs around here."); // Not authentic, guessed.

[oploc1,misc_dummy_heather_normal]
~mesbox("Gardener Gunnhild is already weeding that herb.");