[label,misc_people_default_talk]
~chatplayer("<p,neutral>Hello.");
if (%misc_quest = ^misc_complete) {
    ~chatnpc("<p,neutral>Good day, Your Royal Highness.");
} else {
    ~chatnpc("<p,neutral>Good day.");
}

// Etc people are not affected by misc royalty
[label,etc_people_default_talk]
~chatplayer("<p,neutral>Hello.");
~chatnpc("<p,neutral>Good day.");

[label,misc_people_on_attack]
if (npc_stat(hitpoints) = 0) {
    if (%misc_approval > 6) { %misc_approval = sub(%misc_approval, 6); } else { %misc_approval = 0; }
    %misc_killed = 1;
    switch_int(random(6)) {
        case 0 : npc_say("Aargh!");
        case 1 : npc_say("I'm a gonner!");
        case 2 : npc_say("It's no use, I'm done for!!");
        case 3 : npc_say("Uggh!");
    }
} else if (~player_in_combat_check = false) {
    switch_int(random(6)) {
        case 0 : npc_say("Oi!");
        case 1 : npc_say("Rahr!");
        case 2 : npc_say("No!");
        case 3 : npc_say("Grr!");
    }
}
@player_combat_start;

[label,etc_people_on_attack]
if (npc_stat(hitpoints) = 0) {
    switch_int(random(6)) {
        case 0 : npc_say("Aargh!");
        case 1 : npc_say("I'm a gonner!");
        case 2 : npc_say("It's no use, I'm done for!!");
        case 3 : npc_say("Uggh!");
    }
} else if (~player_in_combat_check = false) {
    switch_int(random(6)) {
        case 0 : npc_say("Oi!");
        case 1 : npc_say("Rahr!");
        case 2 : npc_say("No!");
        case 3 : npc_say("Grr!");
    }
}
@player_combat_start;

