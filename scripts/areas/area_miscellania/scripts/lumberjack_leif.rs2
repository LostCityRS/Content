[opnpc1,misc_lumberjack]
if (%misc_quest = ^misc_complete) {
    ~chatnpcnoturn("<~man_misc_mesanim>Good day, Your Royal Highness.");
} else {
    ~chatnpcnoturn("<~man_misc_mesanim>Hello.");
}
@multi2(
    "Lumberjack Leif.", leif_main_talk,
    "Your approval rating.", misc_quest_approval_rating
);

[label,leif_main_talk]
~chatplayer("<p,neutral>Good day. What are you doing?");
~chatnpcnoturn("<~man_misc_mesanim>I'm cutting down maple trees for their wood. It's a living.");
~chatplayer("<p,neutral>Good luck with that.");
if (%misc_quest = ^misc_complete) {
    ~chatnpcnoturn("<~man_misc_mesanim>Thank you, Your Royal Highness.");
} else {
    ~chatnpcnoturn("<~man_misc_mesanim>Thanks.");
}

[oploc1,misc_dummy_mapletree]
~mesbox("Lumberjack Leif is already chopping that down.");

// This is to intercept woodcutting in miscellania
[proc,leif_intercept_wood](string $fishing_mes, int $exp)(boolean)
if (inzone(^miscellania_lower_bound, ^miscellania_upper_bound, coord) = true) {
    if (%misc_approval < 127) { %misc_approval = add(%misc_approval, 1); }
    if (npc_find(0_39_60_54_29, misc_lumberjack, 2, 0) = true) { 
        npc_say("Thanks!"); 
        if (%misc_approval >= 127) {
            ~chatnpcnoturn("<p,happy> Don't trouble yourself further, Your Highness, you've already done so much!");
        }
    }
    stat_advance(mining, $exp);
    mes("<substring($fishing_mes, 0, sub(string_length($fishing_mes), 1))> and give it to Lumberjack Leif.");
    return (true);
}
return (false);