[ai_queue3,slayer_icefiend_1]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}

// Default drop from config.
obj_add(npc_coord, npc_param(death_drop), 1, ^lootdrop_duration);

// Tertiary
~trail_easycluedrop(^trail_easy_droprate, npc_coord);

def_int $random = random(128);
if ($random < 4) {
    obj_add(npc_coord, waterrune, calc(random(5) + 1), ^lootdrop_duration);
} else if ($random < 5) {
    obj_add(npc_coord, airrune, calc(random(5) + 1), ^lootdrop_duration);
} else if ($random < 9) {
    obj_add(npc_coord, coins, calc(random(30) + 1), ^lootdrop_duration);
} else if ($random < 13) {
    obj_add(npc_coord, coins, calc(random(20) + 1), ^lootdrop_duration);
} else if ($random < 16) {
    obj_add(npc_coord, ~randomjewel, ^lootdrop_duration);
}
