[ai_queue4,_slayer_lizard]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}

// Default drop from config.
obj_add(npc_coord, npc_param(death_drop), 1, ^lootdrop_duration);

def_int $random = random(128);

if ($random < 10) {
    obj_add(npc_coord, ~randomherb, ^lootdrop_duration);
} else if ($random < 14) {
    obj_add(npc_coord, ~randomjewel, ^lootdrop_duration);
} else if ($random < 23) {
    obj_add(npc_coord, ~roll_general_seed_table(nc_vislevel(npc_type)), ^lootdrop_duration);
} else if ($random < 24) {
    obj_add(npc_coord, mithril_ore, 1, ^lootdrop_duration);
} else if ($random < 26) {
    obj_add(npc_coord, silver_bar, 1, ^lootdrop_duration);
} else if ($random < 29) {
    obj_add(npc_coord, copper_ore, 1, ^lootdrop_duration);
} else if ($random < 32) {
    obj_add(npc_coord, silver_ore, 1, ^lootdrop_duration);
} else if ($random < 36) {
    obj_add(npc_coord, tin_ore, 1, ^lootdrop_duration);
} else if ($random < 49) {
    obj_add(npc_coord, coal, 1, ^lootdrop_duration);
} else if ($random < 71) {
    obj_add(npc_coord, iron_ore, 1, ^lootdrop_duration);
} else if ($random < 84) {
    obj_add(npc_coord, kebab, 1, ^lootdrop_duration);
} else if ($random < 97) {
    obj_add(npc_coord, water_skin0, 1, ^lootdrop_duration);
} else if ($random < 127) {
    obj_add(npc_coord, firerune, 5, ^lootdrop_duration);
} else if ($random < 141) {
    obj_add(npc_coord, firerune, 42, ^lootdrop_duration);
} else if ($random < 145) {
    obj_add(npc_coord, naturerune, 5, ^lootdrop_duration);
} else if ($random < 146 & random(4) = 0) {
    obj_add(npc_coord, mystic_gloves_light, 1, ^lootdrop_duration);
}
