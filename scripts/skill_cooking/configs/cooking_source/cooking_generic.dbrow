data=experience,600
data=successchance,500,500
data=successmessage,You roast the stuffed snake. It smells like nothing you have ever eaten.
data=burnmessage,You leave the snake on too long and it goes black all over.

[cooking_generic_jubbly]
// Recipe for Disaster, Freeing Skrach Uglogwee. Raw / cooked / burnt all shipped; nothing had ever
// made the raw one cookable. cantcookmessage_range keeps it on an open fire, which is where an ogre
// would put it and which is all the island has.
table=cooking_generic
data=uncooked,100_jubbly_meat_raw
data=cooked,100_jubbly_meat_cooked
data=burnt,100_jubbly_meat_burned
data=levelrequired,41
data=experience,1400
data=successchance,80,420
