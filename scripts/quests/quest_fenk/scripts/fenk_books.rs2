
[proc,chimney_book]
switch_int (%book_page) {
    case 0 : ~book(
        "Chimney Sweeping on a Budget", 
        "Page 26|that sometimes a sweep|may find themselves|brushless and without the|funds to purchase the|one tool that is most|essential to their trade.|What is a chimney sweep|without his or her brush?|In this kind of situation|any normal long-handled"
    );
}