[proc,has_hero_quest_requirements]()(boolean)
if (%qp < ^hero_required_questpoints | %zanaris < ^zanaris_complete | 
    %dragonquest < ^dragon_complete | %arthur < ^arthur_complete |
    (%blackarmgang < ^blackarmgang_complete & %phoenixgang < ^phoenixgang_complete)) {
  return (false);
}
return (true);

[proc,hero_in_progress]()(boolean)
if (%heroquest > ^hero_not_started & %heroquest < ^hero_complete) {
  return(true);
}
return(false);

[proc,hero_phoenix_in_progress]()(boolean)
if (%heroquest > ^hero_started & %heroquest < ^hero_phoenix_obtained_armband) {
  return(true);
}
return(false);

[proc,wearing_black_armour]()(boolean)
if((inv_total(worn, black_platelegs) > 0) & (inv_total(worn, black_platebody) > 0) & (inv_total(worn, black_full_helm) > 0)) {
    return (true);
}
return (false);

[queue,hero_quest_complete]
%heroquest = ^hero_complete;
~givexp(attack, 30750);
~givexp(defence, 30750);
~givexp(strength, 30750);
~givexp(hitpoints, 30750);
~givexp(ranged, 20750);
~givexp(fishing, 27250);
~givexp(cooking, 28250);
~givexp(woodcutting, 15750);
~givexp(firemaking, 15750);
~givexp(smithing, 22750);
~givexp(mining, 25750);
~givexp(herblore, 13250);
session_log(^log_adventure, "Quest complete: Hero's Quest");
~send_quest_complete(questlist:hero, dragon_battleaxe, 250, ^hero_questpoints, "You have completed the Hero's Quest!");
