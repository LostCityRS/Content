[oploc1,haunteddoorl] @open_manor_entrance(^left);
[oploc1,haunteddoorr] @open_manor_entrance(^right);

[label,open_manor_entrance](int $side)
if(coordz(coord) > coordz(loc_coord)) {
    mes("The doors won't open.");
    return;
}
~open_and_close_double_door2(~check_axis(coord, loc_coord, loc_angle), $side, door_open);
p_delay(0);
mes("The doors slam shut behind you.");

[oploc1,hauntedcompostheap]
~mesbox("I'm not looking through that with my hands!");

[oplocu,hauntedcompostheap]
if(last_useitem ! spade) {
    ~displaymessage(^dm_default);
    return;
}
anim(human_dig, 0);
mes("You dig through the compost heap.");
p_delay(2);
if(inv_total(inv, closet_key) = 0 & %haunted < ^haunted_complete) {
    mes("You find a small key.");
    inv_add(inv, closet_key, 1);
    return;
}
mes("You find nothing of interest.");

[oploc1,closet_door]
mes("The door is locked.");
sound_synth(locked, 0, 0);

[oplocu,closet_door]
if(last_useitem ! closet_key) {
    ~displaymessage(^dm_default);
    return;
}
@ernest_open_key_door;

[label,ernest_open_key_door]
mes("You unlock the door.");
mes("You go through the door.");
sound_synth(locked, 0, 0);
~open_and_close_door2(desertdoor_inactive, ~check_axis(coord, loc_coord, loc_angle), door_open);

[oploc1,hauntedfountain]
anim(human_pickpocket, 0);
sound_synth(fish_swim, 0, 0);
p_delay(0);
if(inv_total(inv, pressure_gauge) > 0 | %haunted = ^haunted_complete) {
    ~chatplayer("<p,neutral>It's full of dead fish!");
    return;
}
~chatplayer("<p,quiz>There seems to be a pressure gauge in here...");
if(%haunted_manor_fountain_poisoned = 1) {
    ~chatplayer("<p,neutral>... and a lot of dead fish.");
    mes("You get the pressure gauge from the fountain.");
    inv_add(inv, pressure_gauge, 1);
} else {
    mes("Something in the water bites you.");
    say("Ow!");
    ~damage_self(1);
    p_delay(0);
    ~chatplayer("<p,confused>... and a lot of piranhas!|I can't get the gauge out.");
}

[opheldu,poison]
if(last_useitem = fish_food) @poison_fish_food;

[opheldu,fish_food]
if(last_useitem = poison) @poison_fish_food;

[label,poison_fish_food]
inv_del(inv, fish_food, 1);
inv_del(inv, poison, 1);
inv_add(inv, poisoned_fish_food, 1);
mes("You poison the fish food.");

[oplocu,hauntedfountain]
if(last_useitem ! poisoned_fish_food) { 
    ~displaymessage(^dm_default);
    return;
}
anim(human_pickpocket, 0);
inv_del(inv, poisoned_fish_food, 1);
mes("You pour the poisoned fish food into the fountain.");
p_delay(1);
mes("The piranhas start eating the food...");
p_delay(2);
mes("... then die and float to the surface.");
%haunted_manor_fountain_poisoned = 1;

[oploc1,_manor_bookcase]
if(coordx(coord) < coordx(loc_coord)) {
    return;
}
mes("You've found a secret door!");
@manor_bookcase_door(loc_param(end_coord));

[oploc1,hauntedleverup]
p_delay(0);
facesquare(movecoord(coord, 1, 0, 0));
mes("The lever opens the secret door!");
anim(human_leverdown, 0);
sound_synth(lever, 0, 0);
// Temp note: dur updated
loc_change(hauntedleverdown, 4);
p_teleport(movecoord(coord, 0, 0, 1));
p_delay(1);
@manor_bookcase_door(movecoord(coord, 2, 0, 0));

// todo: This is borked for opening the doors now. Using the lever is fine.
// Gotta think through how to make this work with find all zone.
[label,manor_bookcase_door](coord $dest)
def_coord $start_coord = coord;
p_delay(0);
// If you search from the north end of the northern bookcase, you will be in a different zone
// than the bookcases, this is a small workaround
loc_findallzone(movecoord(coord, 0, 0, -1));
while (loc_findnext = true) {
    if(loc_type = hauntedbookcasel) {
        // Temp note: dur updated
        loc_change(inviswall, 3);
        loc_add(movecoord(loc_coord, 0, 0, -1), hauntedbookcaseopen, loc_angle, loc_shape, 3);
    } else if(loc_type = hauntedbookcaser) {
        // Temp note: dur updated
        loc_change(inviswall, 3);
        loc_add(movecoord(loc_coord, 0, 0, 1), hauntedbookcaseopen, loc_angle, loc_shape, 3);
        sound_synth(coffin_open, 0, 0);
    }
}
p_teleport($dest);

[oploc1,puzzle_ladder_top]
~reset_haunted_levers;
~climb_ladder(0_48_152_44_26, false);

[oploc1,puzzle_ladder]
~reset_haunted_levers;
~climb_ladder(0_48_52_20_33, true);

[proc,reset_haunted_levers]
%ernestdoors = 0;
%ernestlever = 0;

[proc,haunted_get_new_lever_bit](int $current)(int)
if ($current = 0) {
    return (1);
}
return (0);

[proc,haunted_get_pulled_string_for_bit](int $bit)(string)
if ($bit = 0) {
    return ("up");
}
return ("down");

[proc,haunted_get_pulled_string_for_lever](loc $loc)(string)
switch_loc ($loc) {
    case levera : return (~haunted_get_pulled_string_for_bit(%ernestlever_a));
    case leverb : return (~haunted_get_pulled_string_for_bit(%ernestlever_b));
    case leverc : return (~haunted_get_pulled_string_for_bit(%ernestlever_c));
    case leverd : return (~haunted_get_pulled_string_for_bit(%ernestlever_d));
    case levere : return (~haunted_get_pulled_string_for_bit(%ernestlever_e));
    case leverf : return (~haunted_get_pulled_string_for_bit(%ernestlever_f));
}
return ("Unknown");

[oploc2,_haunted_lever]
mes("The lever is <~haunted_get_pulled_string_for_lever(loc_type)>.");

[proc,change_ernest]
if(npc_find(coord, ernest_the_chicken, 8, 0) = true) {
    npc_changetype_keepall(ernest, 100);
}

[queue,haunted_quest_complete]
session_log(^log_adventure, "Quest complete: Ernest the Chicken");
~send_quest_complete(questlist:haunted, feather, 250, ^haunted_questpoints, "You have completed the\\nErnest The Chicken Quest!", "300 Coins");
inv_add(inv, coins, 300);

[proc,recalculate_ernest_doors]
// 1 -> 2
if(%ernestlever_a = 0
    & %ernestlever_b = 0
    & %ernestlever_d = 1
    & %ernestlever_e = 1
    & %ernestlever_f = 1) {
    %ernestdoor_1to2 = 1;
} else {
    %ernestdoor_1to2 = 0;
}

// 2 -> 3
if(%ernestlever_b = 0
    & %ernestlever_d = 1
    & %ernestlever_f = 1) {
    %ernestdoor_2to3 = 1;
} else {
    %ernestdoor_2to3 = 0;
}

// 4 -> 5
if(%ernestlever_a = 1
    & %ernestlever_b = 1
    & %ernestlever_d = 1) {
    %ernestdoor_4to5 = 1;
} else {
    %ernestdoor_4to5 = 0;
}

// 5 -> 6
if(%ernestlever_d = 1) {
    %ernestdoor_5to6 = 1;
} else {
    %ernestdoor_5to6 = 0;
}

// 8 -> 9
if(%ernestlever_e = 0
    & %ernestlever_f = 1) {
    %ernestdoor_8to9 = 1;
} else {
    %ernestdoor_8to9 = 0;
}

// 2 -> 5
if(%ernestlever_a = 0
    & %ernestlever_b = 0
    & %ernestlever_c = 1
    & %ernestlever_d = 1
    & %ernestlever_e = 0
    & %ernestlever_f = 1) {
    %ernestdoor_2to5 = 1;
} else {
    %ernestdoor_2to5 = 0;
}

// 3 -> 6
if(%ernestlever_b = 0
    & %ernestlever_d = 1
    & %ernestlever_f = 0) {
    %ernestdoor_3to6 = 1;
} else {
    %ernestdoor_3to6 = 0;
}

// 4 -> 7
if(%ernestlever_a = 1
    & %ernestlever_b = 1
    & %ernestlever_c = 0
    & %ernestlever_d = 0
    & %ernestlever_e = 0
    & %ernestlever_f = 0) {
    %ernestdoor_4to7 = 1;
} else {
    %ernestdoor_4to7 = 0;
}

// 5 -> 8
if((%ernestlever_c = 0
        & %ernestlever_d = 1)
    |
   (%ernestlever_a = 0
        & %ernestlever_b = 0
        & %ernestlever_c = 1
        & %ernestlever_d = 1
        & %ernestlever_e = 0
        & %ernestlever_f = 1)) {
    %ernestdoor_5to8 = 1;
} else {
    %ernestdoor_5to8 = 0;
}

[oploc1,_haunted_lever]
p_delay(0);
def_string $name = "";
def_string $dir = "down";

if(loc_type = levera) {
    $name = "A";
    %ernestlever_a = ~haunted_get_new_lever_bit(%ernestlever_a);
    $dir = ~haunted_get_pulled_string_for_bit(%ernestlever_a);
}
else if(loc_type = leverb) {
    $name = "B";
    %ernestlever_b = ~haunted_get_new_lever_bit(%ernestlever_b);
    $dir = ~haunted_get_pulled_string_for_bit(%ernestlever_b);
}
else if(loc_type = leverc) {
    $name = "C";
    %ernestlever_c = ~haunted_get_new_lever_bit(%ernestlever_c);
    $dir = ~haunted_get_pulled_string_for_bit(%ernestlever_c);
}
else if(loc_type = leverd) {
    $name = "D";
    %ernestlever_d = ~haunted_get_new_lever_bit(%ernestlever_d);
    $dir = ~haunted_get_pulled_string_for_bit(%ernestlever_d);
}
else if(loc_type = levere) {
    $name = "E";
    %ernestlever_e = ~haunted_get_new_lever_bit(%ernestlever_e);
    $dir = ~haunted_get_pulled_string_for_bit(%ernestlever_e);
}
else if(loc_type = leverf) {
    $name = "F";
    %ernestlever_f = ~haunted_get_new_lever_bit(%ernestlever_f);
    $dir = ~haunted_get_pulled_string_for_bit(%ernestlever_f);
}

~recalculate_ernest_doors();

anim(human_leverdown, 0);
sound_synth(lever, 0, 0);

mes("You pull lever <$name> <$dir>.");
mes("You hear a clunk.");

[aploc1,_haunted_door]
def_int $distance = 0;
//opens east
if (loc_param(dir) = 1) {
    //you are west
    if (coordx(coord) < coordx(loc_coord)) {
        ~clipped_telewalk(calc(coordx(loc_coord) - coordx(coord)), calc(coordz(loc_coord) - coordz(coord)));
        $distance = 2;
    }
    //you are east
    else {
        ~clipped_telewalk(calc(coordx(loc_coord) - coordx(coord) + 1), calc(coordz(loc_coord) - coordz(coord)));
        $distance = -2;
    }
    loc_del(5);
    loc_add(loc_coord, ernest_doorclosed, 0, loc_shape, 3);
    p_teleport(movecoord(coord, $distance, 0, 0));
}
//opens north
else if (loc_param(dir) = 0) {
    //you are south
    if (coordz(coord) < coordz(loc_coord)) {
        ~clipped_telewalk(calc(coordx(loc_coord) - coordx(coord)), calc(coordz(loc_coord) - coordz(coord)));
        $distance = 2;
    }
    //you are north
    else {
        ~clipped_telewalk(calc(coordx(loc_coord) - coordx(coord)), calc(coordz(loc_coord) - coordz(coord) + 1));
        $distance = -2;
    }
    loc_del(5);
    loc_add(loc_coord, ernest_doorclosed, 0, loc_shape, 3);
    p_teleport(movecoord(coord, 0, 0, $distance));
}
