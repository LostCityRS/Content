[if_button,questlist:hauntedmine]
def_string $text;

switch_int(%hauntedmine) {
    case ^hauntedmine_not_started : // https://youtu.be/MgnF8O_Djts?t=43
        $text = append($text, "@dbl@I can start this quest by speaking to the @dre@Saradominist|");
        $text = append($text, "@dre@Zealot @dbl@outside the @dre@mines of Morytania.|");
        $text = append($text, "@dbl@To complete this quest I need:|");
        
        if (stat_base(agility) < 15) $text = append($text, "@dre@Level 15 Agility.|");
        else $text = append($text, "@str@Level 15 Agility|");

        if (stat_base(crafting) < 35) $text = append($text, "@dre@Level 35 Crafting.|");
        else $text = append($text, "@str@Level 35 Crafting|");

        if (%priestperil < ^priestperil_complete) $text = append($text, "@dre@Access to Morytania.|");
        else $text = append($text, "@str@Access to Morytania.|");

        $text = append($text, "@dbl@I must be able to @dre@defeat a level 95 enemy.|");
    case ^hauntedmine_started : // osrs
        $text = append($text, "@str@I met a fanatic Saradominst just outside the Morytanian|");
        $text = append($text, "@str@mines. He told me that the mines had been sealed, but|");
        $text = append($text, "@str@contained within them crystals of a great power over evil.|");
        $text = append($text, "@dbl@I need to find @dre@some way@dbl@, other than the sealed main entrance,|");
        $text = append($text, "@dre@to get into the mines.");
    case ^hauntedmine_secondary_entrance : // osrs
        $text = append($text, "@str@I met a fanatic Saradominst just outside the Morytanian|");
        $text = append($text, "@str@mines. He told me that the mines had been sealed, but|");
        $text = append($text, "@str@contained within them crystals of a great power over evil.|");
        $text = append($text, "@str@I managed to get into the mines via a thin tunnel high|");
        $text = append($text, "@str@mountains.|");

        $text = append($text, "@dbl@Now I must reach the @dre@lower levels @dbl@where apparently the|");
        $text = append($text, "@dre@crystals @dbl@can be found.|");
    case ^hauntedmine_liftfound : // osrs
        $text = append($text, "@str@I met a fanatic Saradominst just outside the Morytanian|");
        $text = append($text, "@str@mines. He told me that the mines had been sealed, but|");
        $text = append($text, "@str@contained within them crystals of a great power over evil.|");
        $text = append($text, "@str@I managed to get into the mines via a thin tunnel high|");
        $text = append($text, "@str@mountains.|");

        $text = append($text, "@str@Now I must reach the lower levels where apparently the|");
        $text = append($text, "@str@crystals can be found.|");

        $text = append($text, "@dbl@I have found a @dre@lift @dbl@that looks promising, but the @dre@mechanism|");
        $text = append($text, "@dbl@requires a @dre@key @dbl@to be started.|");

    case ^hauntedmine_liftused : // osrs
        $text = append($text, "@str@I met a fanatic Saradominst just outside the Morytanian|");
        $text = append($text, "@str@mines. He told me that the mines had been sealed, but|");
        $text = append($text, "@str@contained within them crystals of a great power over evil.|");
        $text = append($text, "@str@I managed to get into the mines via a thin tunnel high|");
        $text = append($text, "@str@mountains.|");

        $text = append($text, "@str@Now I must reach the lower levels where apparently the|");
        $text = append($text, "@str@crystals can be found.|");

        $text = append($text, "@str@I managed to start the lift which allowed me to get to the lower|");
        $text = append($text, "@str@levels.|");

        $text = append($text, "@dbl@Now I can continue my search for the @dre@crystals@dbl@.|");
    case ^hauntedmine_darkstairsfound : // osrs
        $text = append($text, "@str@I met a fanatic Saradominst just outside the Morytanian|");
        $text = append($text, "@str@mines. He told me that the mines had been sealed, but|");
        $text = append($text, "@str@contained within them crystals of a great power over evil.|");
        $text = append($text, "@str@I managed to get into the mines via a thin tunnel high|");
        $text = append($text, "@str@mountains.|");

        $text = append($text, "@str@Now I must reach the lower levels where apparently the|");
        $text = append($text, "@str@crystals can be found.|");

        $text = append($text, "@str@I managed to start the lift which allowed me to get to the lower|");
        $text = append($text, "@str@levels.|");

        $text = append($text, "@str@Now I can continue my search for the crystals.|");

        $text = append($text, "@dbl@The mines are @dre@too dark @dbl@to @dre@navigate@dbl@ at this @dre@level@dbl@.|");
        $text = append($text, "@dbl@Unfortunately the area is @dre@flooded@dbl@, so it won't be possible to|");
        $text = append($text, "@dre@light@dbl@ a @dre@fire@dbl@ down here. I need to find some other @dre@source of|");
        $text = append($text, "@dre@light@dbl@.");
}
~quest_journal("Haunted Mine", $text);

