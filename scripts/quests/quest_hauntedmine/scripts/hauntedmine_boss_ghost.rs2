// synth_sound	id=1611


// distance 2: starttime=20, endtime=44, angle=0, progress=0, startheight=0, endheight=0
// distance 4: starttime=20, endtime=60, angle=0, progress=0, startheight=0, endheight=0
[proc,hauntedmine_boss_pickaxe_attack]
def_coord $random_coord = map_findsquare(coord, 1, 10, 0); // confirm vis, radius, and min radius
def_int $duration = ~player_projectile($random_coord, coord, uid, pickaxe_travel_spotanim, 0, 0, 20, 0, 8, 0, 8);

spotanim_map(pickaxe_summon_effect_spotanim, $random_coord, 50, 0);
sound_synth(pickaxe_attack, 0, 0);

queue(damage_player, divide($duration, 30), ~random_range(1, 10));

[proc,hauntedmine_boss_minecart_attack](coord $inzone1, coord $inzone2, coord $npc_dest1, coord $npc_dest2)
.npc_findall(~centre_coord($inzone1, $inzone2), hauntedmine_boss_cart, add(divide(distance($inzone1, $inzone2), 2), 1), 0);
while (.npc_findnext = true) {
    if (inzone($inzone1, $inzone2, .npc_coord) = true) {
        sound_synth(cart_away, 0, 0);

        .npc_settimer(1);
        .%npc_attacking_uid = uid;

        .%npc_int2 = ~coord_direction(.npc_coord, coord); // direction
        if (~coord_direction(.npc_coord, $npc_dest1) = .%npc_int2) .%npc_int = distance(.npc_coord, $npc_dest1);
        else if (~coord_direction(.npc_coord, $npc_dest2) = .%npc_int2) .%npc_int = distance(.npc_coord, $npc_dest2);

        return;
    }
}


[proc,hauntedmine_near_crane](coord $coord, coord $crane_sw)(boolean)
if (inzone(movecoord($crane_sw, 0, 0, -1), movecoord($crane_sw, 2, 0, 3), $coord) = true) {
    return(true);
}
if (inzone(movecoord($crane_sw, -1, 0, 0), movecoord($crane_sw, 3, 0, 2), $coord) = true) {
    return(true);
}
return(false);

