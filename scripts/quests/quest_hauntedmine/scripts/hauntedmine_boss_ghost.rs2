[ai_timer,hauntedmine_boss_cart]
if (%npc_int < 1) {
    npc_settimer(0);
    return;
}
%npc_int = sub(%npc_int, 1);
def_coord $tele_coord = ~movecoord_indirection(npc_coord, %npc_int2, 1);

// find and attack player
if (finduid(%npc_attacking_uid) = true & coord = $tele_coord) {
    anim(human_stumble_back, 25); // matches osrs
    if_close; 
    if (p_finduid(uid) = true) {
        sound_synth(cart_hit, 0, 0);
        p_exactmove(coord, ~movecoord_indirection(coord, %npc_int2, 1), 25, 45, modulo(add(%npc_int2, 2), 4));
        if (random(2) = 0) strongqueue(damage_player, 0, random(10)); // seems like a 50% chance to hit 0-10
    }
}

npc_tele($tele_coord); // npc not delayed



