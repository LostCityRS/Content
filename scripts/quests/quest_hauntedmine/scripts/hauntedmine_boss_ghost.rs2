else if (inzone(0_43_69_31_30, 0_43_69_31_37, coord) = true) ~hauntedmine_boss_minecart_attack(0_43_69_31_30, 0_43_69_31_37, 0_43_69_31_30, 0_43_69_31_37);
else if (inzone(0_43_69_33_31, 0_43_69_33_36, coord) = true) ~hauntedmine_boss_minecart_attack(0_43_69_33_31, 0_43_69_33_36, 0_43_69_33_31, 0_43_69_33_36);
else if (inzone(0_43_69_39_31, 0_43_69_39_36, coord) = true) ~hauntedmine_boss_minecart_attack(0_43_69_39_31, 0_43_69_39_36, 0_43_69_39_31, 0_43_69_39_36);
