if (.npc_findexact($crane_sw, crane_posessed_mine) = true) {
    .npc_anim(mining_crane_attack, $delay);
    sound_synth(crane_move_and_snap, 0, 0);
    queue(damage_player, 0, ~random_range(1, 10));
    // todo check retal
}

