[opnpc1,regicide_general_hining]
if(inv_total(inv, trail_clue_hard_riddle018) > 0) {
    if(~obj_gettotal(trail_clue_hard_riddle018_puzzlebox) > 0) {
        if(inv_total(inv, trail_clue_hard_riddle018_puzzlebox) = 0) {
            ~chatplayer("<p,neutral>I don't have the puzzle box with me.");
            ~chatnpc("<p,angry>That's not much use. Go and fetch it.");
            return;
        }
        if(~trail_puzzle_complete(trail_clue_hard_riddle018_puzzlebox) = true) {
            ~chatnpc("<p,neutral>You have done well.");
            inv_del(inv, trail_clue_hard_riddle018_puzzlebox, 1);
            ~progress_clue_hard(trail_clue_hard_riddle018, "General Hining has given you another clue scroll!");
            return;
        }
        // TODO: check mesanim
        ~chatnpc("<p,neutral>Do not waste my time.");
        return;
    }
    ~give_trail_puzzle(trail_clue_hard_riddle018_puzzlebox, "<p,neutral>Before I will help you, you must complete this for me.", "General Hining has given you a puzzle box!");
    return;
}
