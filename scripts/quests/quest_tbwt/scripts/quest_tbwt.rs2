[debugproc,settbwt](int $var)
if (p_finduid(uid) = true)
%tbwt_main = $var;
mes("Set TBWT Main to: <tostring($var)>.");
~send_quest_progress(questlist:tbwt, %tbwt_main, ^tbwt_complete);

[debugproc,settbwtt](int $var, int $var2)
if (p_finduid(uid) = true) {
    if ($var2 = 1) { // Set Timfraku title
        %tbwt_tiadeche = setbit_range_toint(%tbwt_tiadeche, $var, ^tbwt_tiadeche_timfraku_title_start, ^tbwt_tiadeche_timfraku_title_end);
        mes("Set TBWT Timfraku Title(1) to: <tostring($var)>.");
    } else if ($var2 = 2) { // Set Tiadeche progress
        %tbwt_tiadeche = setbit_range_toint(%tbwt_tiadeche, $var, ^tbwt_tiadeche_tiadeche_start, ^tbwt_tiadeche_tiadeche_end);
        %tbwt_tiadeche = clearbit(%tbwt_tiadeche, ^tbwt_tiadeche_tiadeche_received_karambwan);
        mes("Set TBWT Tiadeche(2) progress to: <tostring($var)>.");
    } else if ($var2 = 3) { // Set Tamayu progress
        %tbwt_tiadeche = setbit_range_toint(%tbwt_tiadeche, $var, ^tbwt_tiadeche_tamayu_start, ^tbwt_tiadeche_tamayu_end);
        %tbwt_tiadeche = clearbit(%tbwt_tiadeche, ^tbwt_tiadeche_tamayu_received_acceptable_spear);
        %tbwt_tiadeche = clearbit(%tbwt_tiadeche, ^tbwt_tiadeche_tamayu_received_poisoned_spear);
        %tbwt_tiadeche = clearbit(%tbwt_tiadeche, ^tbwt_tiadeche_tamayu_received_kp_spear);
        mes("Set TBWT Tamayu(3) progress to: <tostring($var)>.");
    } else if ($var2 = 4) { // Set Tinsay progress
        %tbwt_tiadeche = setbit_range_toint(%tbwt_tiadeche, $var, ^tbwt_tiadeche_tinsay_start, ^tbwt_tiadeche_tinsay_end);
        mes("Set TBWT Tinsay(4) progress to: <tostring($var)>.");
    } else if ($var2 = 5) { // Set Lubufu progress
        %tbwt_tiadeche = setbit_range_toint(%tbwt_tiadeche, $var, ^tbwt_tiadeche_lubufu_start, ^tbwt_tiadeche_lubufu_end);
        mes("Set TBWT Lubufu(5) progress to: <tostring($var)>.");
    } else if ($var2 = 6) { // Set Lubufu Karambwanji Count
        %tbwt_tiadeche = setbit_range_toint(%tbwt_tiadeche, $var, ^tbwt_tiadeche_lubufu_karambwanji_count_start, ^tbwt_tiadeche_lubufu_karambwanji_count_end);
        mes("Set TBWT Lubufu Karambwanji Count(6) to: <tostring($var)>.");
    } else if ($var2 = 7) { // Set Lubufu Questioning Count
        %tbwt_tiadeche = setbit_range_toint(%tbwt_tiadeche, $var, ^tbwt_tiadeche_lubufu_questioning_count_start, ^tbwt_tiadeche_lubufu_questioning_count_end);
        mes("Set TBWT Lubufu Questioning Count(7) to: <tostring($var)>.");
    } else if ($var2 = 8) { // Set Tamayu Agility Count
        %tbwt_tiadeche = setbit_range_toint(%tbwt_tiadeche, $var, ^tbwt_tiadeche_tamayu_agility_count_start, ^tbwt_tiadeche_tamayu_agility_count_end);
        mes("Set TBWT Tamayu Agility Count(8) to: <tostring($var)>.");
    } else {
        %tbwt_tiadeche = $var;
        mes("Set entire TBWT Tiadeche varp to: <tostring($var)>.");
    }

    mes("After set - raw varp: <tostring(%tbwt_tiadeche)>");
}

[debugproc,tbwtcs2]
if (p_finduid(uid) = true) {
    @tbwt_tamayu_final_cutscene;
}

[proc,get_tbwt_main_progress]()(int)
return (getbit_range(%tbwt_main, ^tbwt_not_started, ^tbwt_complete));

[proc,set_tbwt_main_progress](int $prog)
%tbwt_main = setbit_range_toint(%tbwt_main, $prog, ^tbwt_not_started, ^tbwt_complete);

[proc,get_tbwt_timfraku_title]()(int)
return (getbit_range(%tbwt_tiadeche, ^tbwt_tiadeche_timfraku_title_start, ^tbwt_tiadeche_timfraku_title_end));

[proc,set_tbwt_timfraku_title](int $title)
%tbwt_tiadeche = setbit_range_toint(%tbwt_tiadeche, $title, ^tbwt_tiadeche_timfraku_title_start, ^tbwt_tiadeche_timfraku_title_end);

[proc,get_tbwt_tiadeche_progress]()(int)
return (getbit_range(%tbwt_tiadeche, ^tbwt_tiadeche_tiadeche_start, ^tbwt_tiadeche_tiadeche_end));

[proc,set_tbwt_tiadeche_progress](int $prog)
%tbwt_tiadeche = setbit_range_toint(%tbwt_tiadeche, $prog, ^tbwt_tiadeche_tiadeche_start, ^tbwt_tiadeche_tiadeche_end);

[proc,get_tbwt_tamayu_progress]()(int)
return (getbit_range(%tbwt_tiadeche, ^tbwt_tiadeche_tamayu_start, ^tbwt_tiadeche_tamayu_end));

[proc,set_tbwt_tamayu_progress](int $prog)
%tbwt_tiadeche = setbit_range_toint(%tbwt_tiadeche, $prog, ^tbwt_tiadeche_tamayu_start, ^tbwt_tiadeche_tamayu_end);

[proc,get_tbwt_tinsay_progress]()(int)
return (getbit_range(%tbwt_tiadeche, ^tbwt_tiadeche_tinsay_start, ^tbwt_tiadeche_tinsay_end));

[proc,set_tbwt_tinsay_progress](int $prog)
%tbwt_tiadeche = setbit_range_toint(%tbwt_tiadeche, $prog, ^tbwt_tiadeche_tinsay_start, ^tbwt_tiadeche_tinsay_end);

[proc,get_tbwt_lubufu_progress]()(int)
return (getbit_range(%tbwt_tiadeche, ^tbwt_tiadeche_lubufu_start, ^tbwt_tiadeche_lubufu_end));

[proc,set_tbwt_lubufu_progress](int $prog)
%tbwt_tiadeche = setbit_range_toint(%tbwt_tiadeche, $prog, ^tbwt_tiadeche_lubufu_start, ^tbwt_tiadeche_lubufu_end);

[proc,get_tbwt_lubufu_karambwanji]()(int)
return (getbit_range(%tbwt_tiadeche, ^tbwt_tiadeche_lubufu_karambwanji_count_start, ^tbwt_tiadeche_lubufu_karambwanji_count_end));

[proc,set_tbwt_lubufu_karambwanji](int $prog)
%tbwt_tiadeche = setbit_range_toint(%tbwt_tiadeche, $prog, ^tbwt_tiadeche_lubufu_karambwanji_count_start, ^tbwt_tiadeche_lubufu_karambwanji_count_end);

[proc,get_tbwt_lubufu_questioning]()(int)
return (getbit_range(%tbwt_tiadeche, ^tbwt_tiadeche_lubufu_questioning_count_start, ^tbwt_tiadeche_lubufu_questioning_count_end));

[proc,set_tbwt_lubufu_questioning](int $prog)
%tbwt_tiadeche = setbit_range_toint(%tbwt_tiadeche, $prog, ^tbwt_tiadeche_lubufu_questioning_count_start, ^tbwt_tiadeche_lubufu_questioning_count_end);

[proc,get_tbwt_tamayu_agility_count]()(int)
return (getbit_range(%tbwt_tiadeche, ^tbwt_tiadeche_tamayu_agility_count_start, ^tbwt_tiadeche_tamayu_agility_count_end));

[proc,set_tbwt_tamayu_agility_count](int $prog)
%tbwt_tiadeche = setbit_range_toint(%tbwt_tiadeche, $prog, ^tbwt_tiadeche_tamayu_agility_count_start, ^tbwt_tiadeche_tamayu_agility_count_end);

[proc,tbwt_get_timfraku_title]()(string)
def_string $title = "adventurer";
switch_int(getbit_range(%tbwt_tiadeche, ^tbwt_tiadeche_timfraku_title_start, ^tbwt_tiadeche_timfraku_title_end)) {
    case 0 : $title = "adventurer";
    case 1 : $title = "explorer";
    case 2 : $title = "wayfarer";
    case 3 : $title = "nobody";
}
return ($title);

[proc,tbwt_get_completed_timfraku_title]()(string)
def_string $title = "Roving adventurer";
switch_int(getbit_range(%tbwt_tiadeche, ^tbwt_tiadeche_timfraku_title_start, ^tbwt_tiadeche_timfraku_title_end)) {
    case 0 : $title = "Roving adventurer";
    case 1 : $title = "Travelling explorer";
    case 2 : $title = "Wandering wayfarer";
    case 3 : $title = "Nobody";
}
return ($title);

[proc,tbwt_get_brother_completion]()(boolean)
if (~get_tbwt_tinsay_progress = ^tbwt_tinsay_complete & ~get_tbwt_tamayu_progress = ^tbwt_tamayu_complete & ~get_tbwt_tiadeche_progress = ^tbwt_tiadeche_complete & ~get_tbwt_lubufu_progress = ^tbwt_lubufu_complete) {
    return (true);
} else {
    return (false);
}

[oploc1,tbwt_bamboo_door]
if (~get_tbwt_main_progress() < ^tbwt_complete) {
    mes("You do not have permission to enter here"); // Intentionally no period - https://imgur.com/a/1LTxz27
    return;
}
~open_and_close_door(loc_param(next_loc_stage), ~check_axis(coord, loc_coord, loc_angle), false);

[opnpcu,lubufu_karambwan]
def_int $lubufu_progress = ~get_tbwt_lubufu_progress();
def_int $main_progress = ~get_tbwt_main_progress();
if ($main_progress >= ^tbwt_complete) {
    if (npc_find(coord, tbwt_lubufu, 20, 0) = true) {
        ~chatnpc("<p,angry>You deceived me you confoundering dolt! Because of you, my entire business is ruined! Don't you dare touch my fishing spot!");
    }
    return;
}
if ($lubufu_progress >= ^tbwt_lubufu_complete) {
    if (last_useitem = tbwt_karambwan_vessel) {
        if (npc_find(coord, tbwt_lubufu, 20, 0) = true) {
            ~chatnpc("<p,neutral>You'll first have to bait that pot with Karambwanji.");
        }
    } else if (last_useitem = tbwt_karambwan_vessel_loaded_with_karambwanji) {
        p_opnpc(1);
    } else {
        ~displaymessage(^dm_default);
    }
    return;
}
if (npc_find(coord, tbwt_lubufu, 20, 0) = true) {
    ~chatnpc("<p,angry>Keep off my fishing spot, whippersnapper!");
}

[opnpc1,lubufu_karambwan]
if (~get_tbwt_lubufu_progress() < ^tbwt_lubufu_complete & ~get_tbwt_main_progress() < ^tbwt_complete) {
    if (npc_find(coord, tbwt_lubufu, 20, 0) = true) {
        ~chatnpc("<p,angry>Keep off my fishing spot, whippersnapper!");
    }
} else {
    if (~get_tbwt_main_progress() >= ^tbwt_complete) {
        if (npc_find(coord, tbwt_lubufu, 20, 0) = true) {
            ~chatnpc("<p,angry>You deceived me you confoundering dolt! Because of you, my entire business is ruined! Don't you dare touch my fishing spot!");
        }
    } else {
        @attempt_fish_karambwan;
    }
}

[opheldu,karamja_rum]
if(last_useitem = banana) {
    anim(rum_stuffing, 0);
    inv_del(inv, banana, 1);
    inv_del(inv, karamja_rum, 1);
    inv_add(inv, tbwt_banana_in_karamja_rum, 1);
    mes("You stuff the banana into the neck of the bottle. You begin to wonder why.");
} else if (last_useitem = tbwt_sliced_banana) {
    inv_del(inv, tbwt_sliced_banana, 1);
    inv_del(inv, karamja_rum, 1);
    inv_add(inv, tbwt_sliced_banana_in_karamja_rum, 1);
    mes("You add the banana slices to the Karamjan rum.");
} else if (last_useitem = silk) {
    inv_del(inv, silk, 1);
    inv_add(inv, tbwt_cleaning_cloth, 1);
    mes("You pour some of the Karamjan rum over the silk.");
}

[opheldu,tbwt_monkey_corpse]
def_obj $item = last_useitem;
if ((oc_category($item) = weapon_polearm) | (oc_category($item) = weapon_spear) | (oc_category($item) = weapon_slash) | (oc_category($item) = weapon_stab) | ($item = knife)) {
    mes("You don't know how to skin a monkey ... yet.");
    return;
} else if ($item = seaweed) {
    inv_del(inv, tbwt_monkey_corpse, 1);
    inv_del(inv, seaweed, 1);
    inv_add(inv, tbwt_seaweed_in_monkey_corpse, 1);
    mes("You stuff the seaweed into the monkey corpse, creating a stuffed monkey.");
    return;
}

[opheldu,tbwt_monkey_skin]
def_obj $item = last_useitem;
if ($item = seaweed) {
    inv_del(inv, tbwt_monkey_skin, 1);
    inv_del(inv, seaweed, 1);
    inv_add(inv, tbwt_seaweed_in_monkey_skin_sandwich, 1);
    mes("You sandwich the seaweed into the monkey skin.");
    return;
}

[opheldu,banana]
def_obj $item = last_useitem;
if ((oc_category($item) = weapon_polearm) | (oc_category($item) = weapon_spear) | (oc_category($item) = weapon_slash) | (oc_category($item) = weapon_stab) | ($item = knife)) {
    anim(banana_slicing, 0);
    mes("You deftly chop the bananas into slices.");
    inv_del(inv, banana, 1);
    inv_add(inv, tbwt_sliced_banana, 1);
}

[opheldu,tbwt_raw_karambwanji_paste]
if (last_useitem = tbwt_jogre_bones) {
    inv_del(inv, tbwt_jogre_bones, 1);
    inv_del(inv, tbwt_raw_karambwanji_paste, 1);
    inv_add(inv, tbwt_jogre_bones_in_raw_karambwanji_paste, 1);
    mes("You smother the raw Karambwanji paste over the Jogre bones.");
} else if(last_useitem = tbwt_burnt_jogre_bones) {
    inv_del(inv, tbwt_burnt_jogre_bones, 1);
    inv_del(inv, tbwt_raw_karambwanji_paste, 1);
    inv_add(inv, tbwt_burnt_jogre_bones_in_raw_karambwanji_paste, 1);
    mes("You smother the raw Karambwanji paste over the burnt Jogre bones.");
}

[opheldu,tbwt_cooked_karambwanji_paste]
if (last_useitem = tbwt_jogre_bones) {
    inv_del(inv, tbwt_jogre_bones, 1);
    inv_del(inv, tbwt_cooked_karambwanji_paste, 1);
    inv_add(inv, tbwt_jogre_bones_in_cooked_karambwanji_paste, 1);
    mes("You smother the cooked Karambwanji paste over the Jogre bones.");
} else if(last_useitem = tbwt_burnt_jogre_bones) {
    inv_del(inv, tbwt_burnt_jogre_bones, 1);
    inv_del(inv, tbwt_cooked_karambwanji_paste, 1);
    inv_add(inv, tbwt_burnt_jogre_bones_in_cooked_karambwanji_paste, 1);
    mes("You smother the cooked Karambwanji paste over the burnt Jogre bones.");
}

[opheld1,tbwt_seaweed_in_monkey_skin_sandwich]
mes("You really, really do not want to eat that.");

[opheldu,tbwt_raw_karambwanji]
if (last_useitem = pestle_and_mortar) ~attempt_grind_ingredient(last_useslot, last_slot);
else if (last_useitem = tbwt_karambwan_vessel) ~tbwt_load_karambwan_vessel(last_useslot, last_slot);

[opheldu,tbwt_karambwan_vessel]
if (last_useitem = tbwt_raw_karambwanji) ~tbwt_load_karambwan_vessel(last_useslot, last_slot);

[proc,tbwt_load_karambwan_vessel](int $use_slot, int $last_slot)
def_obj $used_on = inv_getobj(inv, $last_slot);
def_obj $used_with = inv_getobj(inv, $use_slot);
if ($used_on = tbwt_raw_karambwanji) {
    inv_delslot(inv, $last_slot);
} else {
    inv_delslot(inv, $use_slot);
}
if ($used_on = tbwt_karambwan_vessel) {
        inv_delslot(inv, $last_slot);
    } else {
        inv_delslot(inv, $use_slot);
    }
inv_add(inv, tbwt_karambwan_vessel_loaded_with_karambwanji, 1);
mes("You load the Karambwan vessel with the raw Karambwanji.");

[queue,twbt_quest_complete]
session_log(^log_adventure, "Quest complete: Tai Bwo Wannai Trio");
~set_tbwt_main_progress(^tbwt_complete);
~send_quest_complete(questlist:tbwt, tbwt_raw_karambwan, 250, ^tbwt_questpoints, "You have completed the\\n'Tai Bwo Wannai Trio' Quest!"); // https://web.archive.org/web/20051228165555/http://runescape.salmoneus.net/quests/TaiBwoTrio/taibwocomplt.png
queue(tbwt_timfraku_talk_to_sons, 0, 0);

[oploc1,tbwt_tribal_statue]
if (~get_tbwt_tinsay_progress < ^tbwt_tinsay_claimed_final_reward) {
    mes("You do not have permission to pray here.");
} else {
    @pray_at_altar(stat_base(prayer));
}

