[apnpc1,troll_eadgar]
if(inzone(0_44_157_0_0, 0_44_157_63_63, npc_coord) = true) {
    if (npc_range(coord) > 4) { // osrs
        p_aprange(4);
        return;
    }
    if(%troll_freed_eadgar = ^true) {
        ~chatnpc("<p,happy>Don't worry about me, I'll be out in a jiffy. Talk to me at my home.");
        return;
    }
    ~chatplayer("<p,happy>How are you doing in there?");
    ~chatnpc("<p,scared>I'm fine! Just dandy! A bit cold, I keep asking them to install a fireplace but they don't listen.");
    ~chatplayer("<p,neutral>I haven't found the key.");
    ~chatnpc("<p,scared>It's on the guard's belt, silly. Free me and I can cook you something good!");
    return;
}
if (npc_range(coord) > 1) { 
    p_aprange(1);
    return;
}
if(%eadgar_quest = ^eadgar_spoken_burntmeat) {
    @eadgar_talked_to_troll_cook_yet;
}
if(%eadgar_quest = ^eadgar_caught_parrot) {
    @eadgar_got_parrot_yet;
}
// if we've shown the parrot to eadgar but haven't hidden it yet
// this blocks turning in the other scarecrow supplies
// TODO probably special dialog if you trigger this with no parrot in inv + also haven't hidden one?
// also mesanims
if(%eadgar_quest = ^eadgar_spoken_eadgar3 & %eadgar_quest < ^eadgar_hid_parrot) {
    ~chatplayer("<p,quiz>What should I do with this parrot?");
    ~chatnpc("<p,neutral>I told you, put it somewhere it'll learn to say the sort of thing the trolls will expect it to say.");
    ~chatnpc("<p,neutral>That is likely to be screaming. There's bound to be a good spot somewhere in the troll prison.");
    ~chatnpc("<p,quiz>Anything else I can do for you?");
    @eadgar_scarecrow_tree; // first available entrypoint to this i think, need to determine if there are any others
}
if(%eadgar_quest = ^eadgar_hid_parrot) {
    @eadgar_hid_parrot;
}
if(%eadgar_quest = ^eadgar_spoken_eadgar3) {
    ~chatnpc("<p,quiz>How are you getting on?");
    @eadgar_scarecrow_items;
}
~chatplayer("<p,happy>Hi!");
switch_int(random(4)) {
    case 0 : ~chatnpc("<p,happy>Welcome to Mad Eadgar's! Happiness in a bowl!");
    case 1 : ~chatnpc("<p,happy>Welcome to Mad Eadgar's! You'll never want to leave!");
    case 2 : ~chatnpc("<p,happy>Welcome to Mad Eadgar's! We don't serve trolls!");
    case 3 : ~chatnpc("<p,happy>Welcome to Mad Eadgar's! Serving all day, every day!");
}
~chatnpc("<p,happy>Would you care to sample our delicious home cooking?");
if(%eadgar_quest = ^eadgar_spoken_sanfew) {
    switch_int(~p_choice4("I need to find some goutweed.", 1, "Why do you live so close to the trolls?", 2, "What do you have to offer?", 3, "No thanks, Eadgar.", 4)) {
        case 1 : @eadgar_need_goutweed;
        case 2 : @eadgar_live_so_close;
        case 3 : @eadgar_what_do_you_have;
        case 4 : @eadgar_nothanks;
    } 
} else {
    @eadgar_default_tree;
}

[label,eadgar_default_tree]
switch_int(~p_choice3("Why do you live so close to the trolls?", 1, "What do you have to offer?", 2, "No thanks, Eadgar.", 3)) {
    case 1 : @eadgar_live_so_close;
    case 2 : @eadgar_what_do_you_have;
    case 3 : @eadgar_nothanks;    
}

[label,eadgar_need_goutweed]
// dialog source https://youtu.be/tEsRQ9fXIU?t=150
// mesanims should be good here
// need this from rsprox https://oldschool.runescape.wiki/w/Transcript:Eadgar%27s_Ruse#Taking_to_Eadgar_again_before_talking_to_Burntmeat
~chatplayer("<p,neutral>I need to find some goutweed. Sanfew said you might be able to help.");
~chatnpc("<p,quiz>Sanfew, you say? Ah, haven't seen him in a while...");
~chatnpc("<p,neutral>Goutweed is used as an ingredient in troll cooking. You should ask one of their cooks.");
%eadgar_quest = ^eadgar_spoken_eadgar;

[label,eadgar_live_so_close]
~chatplayer("<p,confused>Why do you live so close to the trolls? Isn't it dangerous?");
~chatnpc("<p,happy>Well, I suppose I do keep getting captured by the trolls and thrown in prison...But they always release me in the end, I'm far too old and skinny for their tastes.");
~chatnpc("<p,happy>In any case, this is my home, and I'm not leaving it. And this area has the tastiest goats!");

[label,eadgar_what_do_you_have]
~chatplayer("<p,confused>What do you have to offer?");
~chatnpc("<p,happy>The chef's recommendation for today is mountain goat stew. I'll give some stew in exchange for logs for my fire. They're hard to come by around here.");
switch_int(~p_choice2("I'd like some mountain goat stew, please.", 1, "No thanks, Eadgar.", 2)) {
    case 1 :
        ~chatplayer("<p,neutral>I'd like some mountain goat stew, please.");
        if(inv_totalcat(inv, category_22) = 0) {
            ~chatnpc("<p,angry>You don't have any logs! I may be mad, but I'm not stupid!");
            return;
        }
        ~inv_delcat(inv, category_22);
        ~chatnpc("<p,happy>Here you go! Enjoy!");
        if_close;
        mes("You get a bowl of mountain goat stew.");
        anim(human_eat, 0);
        sound_synth(eat, 0, 0);
        p_delay(1);
        mes("You eat the mountain goat stew.");
        if (stat(hitpoints) < stat_base(hitpoints)) {
            mes("It heals some health.");
            stat_heal(hitpoints, 20, 0);
        }
    case 2 : @eadgar_nothanks;
}

[label,eadgar_nothanks]
~chatplayer("<p,neutral>No thanks, Eadgar.");
~chatnpc("<p,happy>Your loss!");

[label,eadgar_talked_to_troll_cook_yet]
// source from osrs vids, todo mesanims from rsprox
~chatnpc("<p,quiz>Oh, it's you. Have you talked to the troll cook yet?");
// varp check here I'd imagine, with a dialog branch for if you haven't talked to burntmeat yet
~chatplayer("<p,sad>I talked to the troll cook but he wouldn't tell me anything, and now he wants me to find him some tasty human for his stew.");
~chatnpc("<p,sad>Oh dear, that's no good. You can't just go hand over a human to those trolls...");
~chatnpc("<p,happy>Aha! I have a plan!");
~chatplayer("<p,neutral>Really?");
~chatnpc("<p,happy>Yes! It's bound to work. First of all, I will need a parrot!");
~chatplayer("<p,quiz>A PARROT? Where am I going to find one of those?");
~chatnpc("<p,neutral>At the zoo, where else?");
%eadgar_quest = ^eadgar_spoken_eadgar2;
~chatnpc("<p,quiz>Anything else I can do for you?");
@eadgar_default_tree;

[label,eadgar_got_parrot_yet]
~chatnpc("<p,quiz>Oh, it's you. Have you got me a parrot yet?");
if(inv_total(inv, eadgar_drunk_parrot) > 0) {
    //parrot: Raaawk! Polly wanna cracker!
    ~chatplayer("<p,quiz>Here it is! How are you going to explain your plan?");
    ~chatnpc("<p,happy>Yes, yes, of course. It's quite ingenious really!");
    ~chatnpc("<p,neutral>What we need is something that looks like a human,|sounds like a human, smells like a human and tastes|like a human."); //linebreaks from from runeweb, one of the few 2004-era images we have of this quest
    ~chatplayer("<p,quiz>How ae we going to make it look like a human?");
    ~chatnpc("<p,neutral>We'll just make a scarecrow. We'll need logs, and 10 sheaves of wheat for stuffing.");
    ~chatplayer("<p,quiz>How are we going to make it sound like a human?");
    ~chatnpc("<p,neutral>That's what the parrot's for, of course.");
    // parrot: Who's a pretty boy then?
    ~chatnpc("<p,neutral>Although the trolls might get suspicious if it doesn't say what they expect a human to say...");
    ~chatnpc("<p,neutral>You should hide it for a while somewhere it can pick up some more appropriate catchphrases.");
    ~chatplayer("<p,quiz>How are we going to make it smell like a human?");
    ~chatnpc("<p,neutral>Well, we'll need to dress it up anyway; if we use dirty clothes it'll smell human to the trolls.");
    ~chatnpc("<p,neutral>I'm a man of few clothes myself, so you might want to ask old Sanfew about that one.");
    ~chatplayer("<p,quiz>And how are we going to make it taste like a human?");
    ~chatnpc("<p,neutral>That's easy, we'll just stuff it with a few chickens. Everything tastes like chicken! Five raw chickens should be enough!");
    %eadgar_quest = ^eadgar_spoken_eadgar3;
    ~chatnpc("<p,quiz>That's the plan. Anything else I can do for you?");
    @eadgar_default_tree;
} else {
    // presumably this checks for whether or not the parrot is in the inventory?
    // will have to check if osrs even increments the varp for this quest stage
    // or if it's purely based on having the parrot in your inventory
}

[oploc1,eadgar_rack]
mes("todo"); // presumably this does something before starting the quest
// then before and after storing the parrot
// during the interim quest stages (troll thistle potion)
// then maybe before and after picking it up again?
// and then possibly after the quest?

[oplocu,eadgar_rack]
switch_obj(last_useitem) {
    case eadgar_drunk_parrot : @eadgar_hide_parrot;
    case default : ~displaymessage(^dm_default);
}

[label,eadgar_hide_parrot]
if(%eadgar_quest = ^eadgar_spoken_eadgar3) {
    inv_del(inv, eadgar_drunk_parrot, 1);
    mes("You hide the parrot under the torture rack."); //osrs
    %eadgar_quest = ^eadgar_hid_parrot;
} else {
    mes("You can't think of a reason to place a defenceless parrot on a torture rack."); // not the real mes, need rsprox
}

[label,eadgar_hid_parrot]
~chatplayer("<p,neutral>I hid the parrot under the rack in the troll prison.");
~chatnpc("<p,neutral>Good work. How about those other items?");
@eadgar_scarecrow_items;

[label,eadgar_scarecrow_tree]
mes("todo");
// there's another fairly extensive dialog tree if eadgar is talked to after bringing him the parrot
// "What should I do with this parrot?" -> Eadgar answers, then after "Anything else I can do for you?"
// there's a bunch of recap dialog options about how to make the scarecrow seem human

[label,eadgar_scarecrow_items]
def_int $logs_num = inv_total(inv, logs);
def_int $chickens_num = inv_total(inv, raw_chicken);
def_int $grain_num = inv_total(inv, grain);
def_int $clothes_num = inv_total(inv, eadgar_dirty_druid_robe);
def_string $logs_str = "";
def_string $chickens_str = "";
def_string $grain_str = "";
def_string $clothes_str = "";

// there has got to be a more portable way to do this, maybe some integer-to-string routine
// i'm not aware of or at least this could be a proc that returns a value?
// for now we are duplicating code intern style, yolo
switch_int ($logs_num) {
    case 0 : $logs_str = "no logs";
    case 1 : $logs_str = "one log";
    case default : $logs_str = "the logs"; // if >= 2
}
switch_int ($chickens_num) {
    case 0 : $chickens_str = "no chickens";
    case 1 : $chickens_str = "one chicken";
    case 2 : $chickens_str = "two chickens";
    case 3 : $chickens_str = "three chickens";
    case 4 : $chickens_str = "four chickens";
    case default : $chickens_str = "five chickens"; // >= 5
}
switch_int ($grain_num) {
    case 0 : $grain_str = "no";
    case 1 : $grain_str = "one bundle of";
    case 2 : $grain_str = "two bundles of";
    case 3 : $grain_str = "three bundles of";
    case 4 : $grain_str = "four bundles of";
    case 5 : $grain_str = "five bundles of";
    case 6 : $grain_str = "six bundles of";
    case 7 : $grain_str = "seven bundles of";
    case 8 : $grain_str = "eight bundles of";
    case 9 : $grain_str = "nine bundles of";
    case default : $grain_str = "ten bundles of"; // >= 10
}
switch_int ($clothes_num) {
    case 0 : $clothes_str = "no dirty clothes";
    case default : $clothes_str = "the dirty clothes";
}

// items are removed here
inv_del(inv, logs, $logs_num);
inv_del(inv, raw_chicken, $chickens_num);
inv_del(inv, grain, $grain_num);
inv_del(inv, eadgar_dirty_druid_robe, $clothes_num);
~chatplayer("<p,neutral>I have <$logs_str>, <$chickens_str>, <$grain_str> grain and <$clothes_str>.");

// i have no idea how this is tracked, it seems impossible to do with the quest varp
// there must be varbits involved here somewhere
// for now, we continue!

// if not all items are delivered, dialog goes back to default tree after eadgar tells you
// what else is needed
// is clicking on eadgar after showing him the parrot but before hiding it the only way to
// see the scarecrow dialog tree?

// dialog from soup's vid, todo mesanims though these should be mostly good
~chatnpc("<p,happy>That's everything!");
// kinda odd this is two separate chatnpc's, is something being checked here?
~chatnpc("<p,happy>Good, good, everything is almost finished.");
~chatnpc("<p,neutral>Of course, we can't just give him the dummy and expect to get anything useful out of him.");
~chatplayer("<p,quiz>Oh?");
~chatnpc("<p,neutral>No, of course not. We need to make sure he'll tell you what you need to know.");
~chatplayer("<p,quiz>And how do we do that?");
~chatnpc("<p,neutral>I happen to know that the trolls are susceptible to a certain kind of plant that grows around this mountain. I call it Troll Thistle. If properly prepared, it can be made into a sort of Troll truth potion.");
~chatplayer("<p,quiz>How do you prepare it?");
~chatnpc("<p,neutral>You'll have to dry it in a fire, then grind it and mix it into a potion with Ranarr weed.");
~chatplayer("<p,neutral>Okay, I'll be back with that soon.");
@eadgar_default_tree;
