// returns the maximum (final) patrol stage for the given guard
// keep in mind the stages are zero-indexed to match %npc_int even though the guards' names start at 1
// $type: which npc (troll_sguard1-8)
// returns: the zero-indexed number of the final patrol stage for that guard
// for example, with guard #4 (six patrol stages) the final stage would be 5 at the sixth index (%npc_int 0 through 5)
[proc,troll_sguard_max_patrol_stage](npc $type)(int)
if($type = troll_sguard1) { return(3); } else
if($type = troll_sguard2) { return(3); } else
if($type = troll_sguard3) { return(3); } else
if($type = troll_sguard4) { return(5); } else
if($type = troll_sguard5) { return(6); } else
if($type = troll_sguard6) { return(7); } else
if($type = troll_sguard7) { return(3); } else
if($type = troll_sguard8) { return(6); }

// returns the facing direction for the given guard during the given stage of the patrol
// uses the guard's current coordinates, since every tile is unique to a single patrol stage
// and even reused tiles have unique facing directions 
// $type: troll_sguard1-8
// returns: 0 = north, 1 = south, 2 = east, 3 = west, 4 = northeast, 5 = southwest

[proc,troll_sguard_patrol_direction](npc $type)(int)
if($type = troll_sguard1) {
    switch_int(%npc_int) {
        case 0 : return(0); // north
        case 1 : return(2); // east
        case 2 : return(1); // south
        case 3 : return(3); // west
    }
} else if($type = troll_sguard2) {
    switch_int(%npc_int) {
        case 0 : return(3); // west
        case 1 : return(1); // south
        case 2 : return(2); // east
        case 3 : return(0); // north
    }
} else if($type = troll_sguard3) {
    switch_int(%npc_int) {
        case 0 : return(3); // west
        case 1 : return(1); // south
        case 2 : return(2); // east
        case 3 : return(0); // north
    }    
} else if($type = troll_sguard4) {
    switch_int(%npc_int) {
        case 0 : return(0); // north 
        case 1 : return(2); // east
        case 2 : return(1); // south
        case 3 : return(3); // west
        case 4 : return(1); // south
        case 5 : return(3); // west
    }    
} else if($type = troll_sguard5) {
    switch_int(%npc_int) {
        case 0 : return(1); // south
        case 1 : return(2); // east
        case 2 : return(5); // diagonal southwest
        case 3 : return(2); // east
        case 4 : return(4); // diagonal northeast
        case 5 : return(0); // north
        case 6 : return(3); // west
    }    
} else if($type = troll_sguard6) {
    switch_int(%npc_int) {
        case 0 : return(0); // north
        case 1 : return(3); // west
        case 2 : return(1); // south
        case 3 : return(3); // west
        case 4 : return(1); // south
        case 5 : return(2); // east
        case 6 : return(0); // north
        case 7 : return(2); // east
    }    
} else if($type = troll_sguard7) {
    switch_int(%npc_int) {
        case 0 : return(2); // east
        case 1 : return(0); // north
        case 2 : return(3); // west
        case 3 : return(1); // south
    }    
} else if($type = troll_sguard8) {
    switch_int(%npc_int) {
        case 0 : return(2); // east
        case 1 : return(1); // south
        case 2 : return(5); // southwest
        case 3 : return(3); // west
        case 4 : return(4); // northeast
        case 5 : return(3); // west
        case 6 : return(0); // north
    }    
}

// returns the destination coordinate for this stage of the patrol
// $type: which npc (troll_sguard1-8)
[proc,troll_sguard_patrol_coord](npc $type)(coord)
if($type = troll_sguard1) {
    switch_int(%npc_int) {
        case 0 : return(0_44_157_34_44); // north
        // stage 1 headed north (coordx(npc_coord) >= 34 & coordx(npc_coord) <= 43))
        case 1 : return(0_44_157_43_44); // east
        // stage 2 headed east (coordz(npc_coord) <= 44 & coordz(npc_coord) >= 41))
        case 2 : return(0_44_157_43_41); // south
        // stage 3 headed south (coordx(npc_coord) <= 43 & coordx(npc_coord) >= 34))
        case 3 : return(0_44_157_34_41); // west
        // stage 4 headed west (coordz(npc_coord) >= 41 & coordz(npc_coord) <= 44))
    }
} else if($type = troll_sguard2) {
    switch_int(%npc_int) {
        case 0 : return(0_44_157_34_41); // west
        // stage 1 headed west (coordz(npc_coord) <= 41 & coordz(npc_coord) >= 38))
        case 1 : return(0_44_157_34_38); // south
        // stage 2 headed south (coordx(npc_coord) >= 34 & coordx(npc_coord) <= 39))
        case 2 : return(0_44_157_39_38); // east
        // stage 3 headed east (coordz(npc_coord) >= 38 & coordz(npc_coord) <= 43))
        case 3 : return(0_44_157_39_41); // north
        // stage 4 headed north (coordx(npc_coord) <= 39 & coordx(npc_coord) >= 34))
    }
} else if($type = troll_sguard3) {
    switch_int(%npc_int) {
        case 0 : return(0_44_157_39_41); // west
        // stage 1 headed west (coordz(npc_coord) <= 41 & coordz(npc_coord) >= 38))
        case 1 : return(0_44_157_39_38); // south
        // stage 2 headed south (coordx(npc_coord) >= 39 & coordx(npc_coord) <= 43))
        case 2 : return(0_44_157_43_38); // east
        // stage 3 headed east (coordz(npc_coord >= 38 & coordz(npc_coord) <= 41))
        case 3 : return(0_44_157_43_41); // north
        // stage 4 headed north (coordx(npc_coord) <= 43 & coordx(npc_coord) >= 39))
    }    
} else if($type = troll_sguard4) {
    switch_int(%npc_int) {
        case 0 : return(0_44_157_34_38); // north 
        case 1 : return(0_44_157_38_38); // east
        case 2 : return(0_44_157_38_34); // south
        case 3 : return(0_44_157_36_34); // west
        case 4 : return(0_44_157_36_30); // south
        case 5 : return(0_44_157_34_30); // west
    }    
} else if($type = troll_sguard5) {
    switch_int(%npc_int) {
        case 0 : return(0_44_157_45_32); // south
        case 1 : return(0_44_157_47_32); // east
        case 2 : return(0_44_157_44_29); // southwest
        case 3 : return(0_44_157_45_29); // east
        case 4 : return(0_44_157_48_32); // northeast
        case 5 : return(0_44_157_48_37); // north
        case 6 : return(0_44_157_45_37); // west
    }    
} else if($type = troll_sguard6) {
    switch_int(%npc_int) {
        case 0 : return(0_44_157_39_34); // north
        case 1 : return(0_44_157_36_34); // west
        case 2 : return(0_44_157_36_30); // south
        case 3 : return(0_44_157_34_30); // west
        case 4 : return(0_44_157_34_27); // south
        case 5 : return(0_44_157_37_27); // east
        case 6 : return(0_44_157_37_29); // north
        case 7 : return(0_44_157_39_29); // east
    }    
} else if($type = troll_sguard7) {
    switch_int(%npc_int) {
        case 0 : return(0_44_157_42_28); // east
        case 1 : return(0_44_157_42_34); // north
        case 2 : return(0_44_157_39_34); // west
        case 3 : return(0_44_157_39_28); // south
    }    
} else if($type = troll_sguard8) {
    switch_int(%npc_int) {
        case 0 : return(0_44_157_48_37); // east
        case 1 : return(0_44_157_48_32); // south
        case 2 : return(0_44_157_45_29); // southwest
        case 3 : return(0_44_157_44_29); // west
        case 4 : return(0_44_157_47_32); // northeast
        case 5 : return(0_44_157_45_32); // west
        case 6 : return(0_44_157_45_37); // north
    }    
}


