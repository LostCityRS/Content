[proc,troll_sguard_next_patrol_stage]
~troll_sguard_idle;
%npc_int = add(%npc_int, 1);

[proc,troll_sguard_idle]
// i don't really know what these do yet and haven't taken the time to look at them
// for now i've put them here so i can use them as a rain dance while also being easy to remove later
//
// something in here makes the trolls pause for 1 tick before changing directions, but if i wholesale remove them
// then the trolls break in weird ways (random backtracking) *and they still pause while turning*
//npc_setmode(none);
//npc_walk(npc_coord);

[proc,troll_sguard_reset_patrol]
%npc_int = 0;

// returns the maximum (final) patrol stage for the given guard
// keep in mind the stages are zero-indexed to match %npc_int even though the guards' names start at 1
// $guard: which guard 1-8
// returns: the zero-indexed number of the final patrol stage for that guard
// for example, with guard #4 (six patrol stages) the final stage would be 5 at the sixth index (%npc_int 0 through 5)
[proc,troll_sguard_max_patrol_stage](int $guard)(int)
switch_int($guard) {
    case 1 : return(3);
    case 2 : return(3);
    case 3 : return(3);
    case 4 : return(5);
    case 5 : return(6);
    case 6 : return(7);
    case 7 : return(3);
    case 8 : return(6);
}

// returns the destination coordinate for this stage of the patrol
// $guard: which guard (1-8 in npc defs)
// $stage: zero-indexed stage of %npc_int (and thus stage of the patrol) we are wanting the destination for
[proc,troll_sguard_patrol_coord](int $guard, int $stage)(coord)
switch_int($guard) {
    case 1 :
        switch_int($stage) {
            case 0 : return(0_44_157_34_44);
            case 1 : return(0_44_157_43_44);
            case 2 : return(0_44_157_43_41);
            case 3 : return(0_44_157_34_41);
        }
    case 2 :
        switch_int($stage) {
            case 0 : return(0_44_157_34_41);
            case 1 : return(0_44_157_34_38);
            case 2 : return(0_44_157_39_38);
            case 3 : return(0_44_157_39_41);
        }
    case 3 :
        switch_int($stage) {
            case 0 : return(0_44_157_39_41);
            case 1 : return(0_44_157_39_38);
            case 2 : return(0_44_157_43_38);
            case 3 : return(0_44_157_43_41);

        }
    case 4 : 
        switch_int($stage) {
            case 0 : return(0_44_157_34_38);
            case 1 : return(0_44_157_38_38);
            case 2 : return(0_44_157_38_34);
            case 3 : return(0_44_157_36_34);
            case 4 : return(0_44_157_36_30);
            case 5 : return(0_44_157_34_30);
        }
    case 5 :
        switch_int($stage) {
            case 0 : return(0_44_157_45_32);
            case 1 : return(0_44_157_47_32);
            case 2 : return(0_44_157_44_29);
            case 3 : return(0_44_157_45_29);
            case 4 : return(0_44_157_48_32);
            case 5 : return(0_44_157_48_37);
            case 6 : return(0_44_157_45_37);
        }
    case 6 : 
        switch_int($stage) {
            case 0 : return(0_44_157_39_34);
            case 1 : return(0_44_157_36_34);
            case 2 : return(0_44_157_36_30);
            case 3 : return(0_44_157_34_30);
            case 4 : return(0_44_157_34_27);
            case 5 : return(0_44_157_37_27);
            case 6 : return(0_44_157_37_29);
            case 7 : return(0_44_157_39_29);
        }
    case 7 : 
        switch_int($stage) {
            case 0 : return(0_44_157_42_28);
            case 1 : return(0_44_157_42_34);
            case 2 : return(0_44_157_39_34);
            case 3 : return(0_44_157_39_28);
        }
    case 8 : 
        switch_int($stage) {
            case 0 : return(0_44_157_48_37);
            case 1 : return(0_44_157_48_32);
            case 2 : return(0_44_157_45_29);
            case 3 : return(0_44_157_44_29);
            case 4 : return(0_44_157_47_32);
            case 5 : return(0_44_157_45_32);
            case 6 : return(0_44_157_45_37);
        }
}

[ai_timer,_troll_sguard]
def_string $guard_str = nc_debugname(npc_type);
def_int $guard_num = -1;

// there is no switch statement for strings :(
if(compare($guard_str, "troll_sguard1") = 0) { $guard_num = 1; } else
if(compare($guard_str, "troll_sguard2") = 0) { $guard_num = 2; } else
if(compare($guard_str, "troll_sguard3") = 0) { $guard_num = 3; } else
if(compare($guard_str, "troll_sguard4") = 0) { $guard_num = 4; } else
if(compare($guard_str, "troll_sguard5") = 0) { $guard_num = 5; } else
if(compare($guard_str, "troll_sguard6") = 0) { $guard_num = 6; } else
if(compare($guard_str, "troll_sguard7") = 0) { $guard_num = 7; } else
if(compare($guard_str, "troll_sguard8") = 0) { $guard_num = 8; }

// this would probably be cleaner as a switch statement
if(%npc_int = ~troll_sguard_max_patrol_stage($guard_num)) { // handle the last patrol stage separately since we need to reset varn to 0
    if(npc_coord = ~troll_sguard_patrol_coord($guard_num, %npc_int)) {
        ~troll_sguard_reset_patrol;  
    }
}
if(npc_coord = ~troll_sguard_patrol_coord($guard_num, %npc_int)) { // handle all other patrol stages the same way
    ~troll_sguard_next_patrol_stage; // if we're already there, go to the next stage
} else {
    ~troll_sguard_idle;
    npc_walk(~troll_sguard_patrol_coord($guard_num, %npc_int)); // if we're not already there, walk there!    
}
