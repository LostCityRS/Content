        }
huntall(npc_coord, 1, 0);
 if(huntnext = true) {
    if(p_finduid(uid) = true) {
        def_int $direction = ~troll_sguard_patrol_direction(npc_type);
        // determine if the player's coord is on the tile in front of the guard by determining the facing direction
        // coordinates are mapped as localX and localZ, with X being west/east and Z being north/south
        // each patrol stage is a straight line so will only have one facing direction (~troll_sguard_patrol_direction)
        switch_int($direction) {
            case 4 : //northeast
                if(coordx(coord) > coordx(npc_coord) & coordz(coord) > coordz(npc_coord)) { ~eadgar_troll_whack; }
            case 5 : //southwest
                if(coordx(coord) < coordx(npc_coord) & coordz(coord) < coordz(npc_coord)) { ~eadgar_troll_whack; }
            case 0 : //north
                if(coordz(coord) > coordz(npc_coord) & coordx(coord) = coordx(npc_coord)) { ~eadgar_troll_whack; }
            case 1 : //south
                if(coordz(coord) < coordz(npc_coord) & coordx(coord) = coordx(npc_coord)) { ~eadgar_troll_whack; }
            case 2 : //east
                if(coordx(coord) > coordx(npc_coord) & coordz(coord) = coordz(npc_coord)) { ~eadgar_troll_whack; }
            case 3 : //west
                if(coordx(coord) < coordx(npc_coord) & coordz(coord) = coordz(npc_coord)) { ~eadgar_troll_whack; }
        }
    }
 }
if(npc_coord = ~troll_sguard_patrol_coord(npc_type)) { // if we've arrived at this stage's destination
    if(%npc_int = ~troll_sguard_max_patrol_stage(npc_type)) { // and if this stage is the final stage
        %npc_int = 0; // then restart the loop
    } else {
        %npc_int = add(%npc_int, 1); // otherwise advance to the next stage
    }
} 
npc_walk(~troll_sguard_patrol_coord(npc_type)); // finally, walk whichever stage we're at for this cycle
