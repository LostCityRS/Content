// thistle locations - from loc ID 3812 (eadgar_troll_thistle_base in m45_57.jm2)
// 0_45_57_03_22
// 0_45_57_07_27
// 0_45_57_11_28
// 0_45_57_12_28
// 0_45_57_22_26

[ai_timer,eadgar_troll_thistle]
npc_settimer(10);
npc_say("Baa!");
// should teleport around to the different spots at some interval
// also need to figure out facing direction

// what happens if this is attempted before the quest?
// after starting the quest but before eadgar tells us about troll thistle?
[opnpc1,eadgar_troll_thistle]
mes("You pick the Troll Thistle.");
npc_del;
inv_add(inv, eadgar_troll_thistle, 1);

// if multiple are held, does it grind in the selected slot or first slot available?
[opheldu,eadgar_dried_troll_thistle]
~attempt_grind_ingredient(last_useslot, last_slot);
// is this possible before the happy-path quest stage, or after quest / after next varp?
// when used on a ranarr vial before grinding: "It's too big to fit in the vial."

[opheldu,eadgar_ground_troll_thistle]
if(~attempt_brew_potion(last_useslot, last_slot) = true) {
    mes("This should fire!"); // todo why doesn't this work?
    %eadgar_quest = ^eadgar_made_potion;
}
if(%eadgar_quest < ^eadgar_made_potion) { // why doesn't my conditional fire unless i have runnable code beneath it wtfff
    %eadgar_quest = ^eadgar_made_potion;
}
// osrs wiki says "You don't need to make any more." after the quest
// todo check if this is the case immediately after the varp ticks over, or if it requires completion
// for that matter is it possible to attempt making the potion before reaching the stage where it's required
// and if so, is there a mes for that?
