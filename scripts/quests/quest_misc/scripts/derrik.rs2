[opnpc1,misc_smithy]
@derrik_normal;

[label,derrik_normal]
~chatnpc("<p,neutral>Good day, Sir. Can I help you with anything?");
if (%misc_quest = 80) {
    @multi3(
        "Can I use your anvil?", derrik_useanvil,
        "I have a slightly strange request...", derrik_strangerequest,
        "Nothing, thanks.", derrik_nothing
    );
} else {
    @multi2(
        "Can I use your anvil?", derrik_useanvil,
        "Nothing, thanks.", derrik_nothing
    );
}

[label,derrik_useanvil]
~chatplayer("<p,confused>Can I use your anvil?");
~chatnpc("<p,neutral>You may.");

[label,derrik_nothing]
~chatplayer("<p,neutral>Nothing, thanks.");

[label,derrik_strangerequest]
~chatplayer("<p,neutral>The King needs to sign a treaty, but is unable to because he lacks a pen large enough for him to hold. Could you make me a nib of the right size?");
~chatnpc("<p,neutral>Hm... I may be able to manage that. What sort of size?");
~chatplayer("<p,neutral>About the size of a helm should do it.");
~chatnpc("<p,neutral>All right, but I'll need an iron bar to make it from.");
if (inv_total(inv, iron_bar) >= 1) {
    @derrik_ironbar;
} else {
    @derrik_noironbar;
}

[label,derrik_ironbar]
~chatplayer("<p,neutral>I have one here.");
~chatnpc("<p,neutral>Good. Just a minute...");
if (inv_total(inv, iron_bar) >= 1) {
    inv_del(inv, iron_bar, 1);
    inv_add(inv, misc_giant_nib, 1);
}
~chatnpc("<p,neutral>Here you go! One giant pen nib!");

[label,derrik_noironbar]
~chatplayer("<p,neutral>I don't have one with me.");
~chatnpc("<p,neutral>Well, come back when you have one.");