[opnpc1,misc_prince_brand]
if (%misc_quest >= 100) {
    @brand_afterthronequest;
} else if (%misc_quest = 40) {
    @brand_duringthronequeststage40;
} else if (%misc_quest = 50 | %misc_quest = 60) {
    if (inv_total(inv, misc_awful_anthem) >= 1 | inv_total(inv, misc_good_anthem) >= 1) {
        @brand_duringthronequest;
    } else {
        @brand_duringthronequeststage50;
    }
} else if (%misc_quest >= 10) {
    @brand_duringthronequest;
} else {
    @brand_beforethronequest;
}

[proc,brand_random_nonsense]()(string)
switch_int (random(14)) {
    case 0 : return ("Beards? Dangerous, flammable and make you look mad!");
    case 1 : return ("Care to sign my petition for pet frogs?");
    case 2 : return ("Cattle prod? Weapon of choice I reckon.");
    case 3 : return ("Don't threaten me with a dead fish!");
    case 4 : return ("He is clearly 1 cup short of a full service.");
    case 5 : return ("I'm a little teapot, short and stout...");
    case 6 : return ("I'm rubber you're glue.........!");
    case 7 : return ("Lies!!! It's all lies!!!");
    case 8 : return ("Look over there! A King Black Dragon!");
    case 9 : return ("Lumbridge? No, I wouldn't be seen dead there.");
    case 10 : return ("Nah, that Kalphite was weedier than your garden.");
    case 11 : return ("Selling ring of poverty 30 mil!");
    case 12 : return ("Sneaky sneaky stick da chompy.");
    case 13 : return ("What level do you need to cook cats?");
}

[label,brand_beforethronequest]
~chatnpc("<p,neutral>Good day, <text_gender("Sir", "Madam")>.");
~chatplayer("<p,neutral>Good day, Your Royal Highness.");

[label,brand_duringthronequeststage40]
~chatplayer("<p,neutral>I need someone to compose a new anthem for Etceteria.");
~chatnpc("<p,neutral>You've come to the right bard! I'll write one for you immediately!");
~chatplayer("<p,neutral>You can take your time, really...");
~chatnpc("<p,neutral>No problem, I'm already done! Here, listen!");
~chatnpc("<p,neutral>'Etceteria, Etceteria, Oh what a great country it is, Etceteria, Etceteria, So I wrote a song about it.'");
~chatnpc("<p,neutral>'It's somewhere in the sea, And it looks very nice, If it weren't for your ancestors, It wouldn't be there at all,'");
~chatnpc("<p,neutral>'And when things aren't going too well, We sing this lovely song, And then we'll all feel so much better, It won't take very long.'");
inv_add(inv, misc_awful_anthem, 1);
if (%misc_quest = 40) {
    %misc_quest = 50;
}
~chatnpc("<p,neutral>Here's a copy, you can keep it!");
~chatplayer("<p,shifty>...that's lovely, thanks.");
~chatnpc("<p,neutral>Don't mention it, <text_gender("Sir", "Madam")>.");

[label,brand_duringthronequeststage50]
~chatplayer("<p,neutral>I lost my copy of the *ahem* theme you composed...");
~chatnpc("<p,neutral>Fear not! I made many, many more!");
inv_add(inv, misc_awful_anthem, 1);
~chatnpc("<p,neutral>Here's a copy, you can keep it!");
~chatplayer("<p,neutral>...that's lovely, thanks.");
~chatnpc("<p,neutral>Don't mention it, <text_gender("Sir", "Madam")>.");

[label,brand_duringthronequest]
if (gender = ^gender_male) {
    @brand_beforethronequest;
} else {
    switch_int (%misc_affection) {
        case 0 : @brand_throneofmiscellaniamarriagestage0;
        case 1 : @brand_throneofmiscellaniamarriagestage1;
        case 2 : @brand_throneofmiscellaniamarriagestage2;
        case 3 : @brand_throneofmiscellaniamarriagestage3;
        case 4 : @brand_throneofmiscellaniamarriagestage4;
    }
}

[label,brand_whattheheck]
~chatplayer(~brand_random_nonsense());
~chatnpc("<p,confused>...What?");

[label,brand_throneofmiscellaniamarriagestage0]
~chatnpc("<p,neutral>Good day, Madam.");
~chatplayer("<p,neutral>Good day, Your Royal Highness.");
~chatplayer("<p,neutral>As I'm sure you are aware, your father the King is seeking someone to rule the Kingdom in his stead. I have put myself forward, but in order for me to become ruler...");
~chatnpc("<p,neutral>...you have to marry somebody in the royal family, namely myself?");
~chatplayer("<p,neutral>Yes, Your Royal Highness.");
~chatnpc("<p,laugh>Ahahahaha!");
~chatnpc("<p,confused>Come now, what interest would I have in a crass adventurer like yourself? What would you know of the poetry that flows through my veins like an avalanche through a peaceful mountain village?");
~chatplayer("<p,shifty>I think you may find I know good poetry when I see it, Your Royal Highness...");
~chatnpc("<p,neutral>This may be the case. I am willing to give you a chance; if you impress me enough, I will consider accepting to marry you.");
%misc_affection = 1;

[label,brand_throneofmiscellaniamarriagestage1]
if (%misc_s1_d1 = 1 & %misc_s1_d2 = 1 & %misc_s1_d3 = 1 & %misc_s1_give = 1 & %misc_s1_emote = 1) {
    @brand_randomset1finish;
}
if (%misc_s1_d1 = 0) {
    @brand_randomset1branch1;
} else if (%misc_s1_d2 = 0) {
    @brand_randomset1branch2;
} else if (%misc_s1_d3 = 0) {
    @brand_randomset1branch3;
} else {
    @brand_beforethronequest;
}

