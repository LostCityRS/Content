    @brand_whyareyoumale;
} else {
    @brand_engageddialogue;
}

[label,brand_engageddialogue]
~chatnpc("<p,neutral>Hello, dear.");
~chatplayer("<p,neutral>Hello. Have you found a priest for our marriage yet?");
~chatnpc("<p,neutral>I'm afraid not, dear. I don't think there is one to be had on these islands for love nor money...");
~chatnpc("<p,neutral>Do not fear, though; I shall call for you as soon as one is found.");

[label,brand_whyareyoumale]
