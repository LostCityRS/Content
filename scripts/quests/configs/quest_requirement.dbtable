// WHAT A QUEST NEEDS BEFORE IT CAN BE STARTED, declared once.
//
// The requirements used to exist only as guard clauses in whichever script starts the quest. That
// stops a player and does nothing else: the journal could not say what was missing, so a player
// who could not start a quest was told so by a single line of dialogue at the quest giver and
// nowhere else, and tools/questaudit.py had to grep for `stat(x) <` and could not tell a start
// requirement from a gate halfway through the quest.
//
// The rows are quest_requirement.dbrow, generated by tools/genquestreq.py from the OSRS wiki -
// edit the generator, not the rows.
//
//   quest        the questlist component, which is what every other quest system here is keyed by
//   questpoints  the quest point total needed, 0 for most
//   skills       (skill, level) pairs - a stat and the level it must be at
//   quests       (component, name) pairs for each quest that must be finished first. The component
//                is for code, the name is for the journal: a component carries no text a script
//                can read back, so the name it is drawn under has to travel with it.
//   other        anything the wiki states in prose - an access, an item, a fight. Printed as
//                written and never checked, because there is nothing here to check it against.
//   name         the quest list's own label for it. Indexed, because ~quest_journal is handed the
//                name and nothing else - all three hundred of its call sites pass a string, and
//                keying on it means none of them had to change.
[quest_requirement]
column=quest,component,INDEXED,REQUIRED
column=name,string,INDEXED,REQUIRED
column=questpoints,int
column=skills,stat,int,LIST
column=quests,component,string,LIST
column=other,string,LIST
