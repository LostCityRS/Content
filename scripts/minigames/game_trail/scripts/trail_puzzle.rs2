[opheld1,_trail_puzzle] @trail_open_puzzle;

[label,trail_open_puzzle]
if(inv_freespace(trail_puzzleinv) > 1) {
    inv_clear(trail_puzzleinv); // prob shouldn't ever need this
    ~init_trail_puzzle;
}
// com_2, THE 5x5 GRID. This said com_3, which is the Hint button - a model, and the client
// only gives an inventory array to the two inv component types. UPDATE_INV_FULL writes
// straight into that array with no null check, so the packet threw inside readPacket and
// the catch at the bottom of it calls logout(): opening a puzzle box threw the player out
// of the game. tools/invtransmit.py checks every transmit in the tree for the same thing.
inv_transmit(trail_puzzleinv, trail_puzzle:com_2);
// AND NEVER THE ANSWER. %trail_puzzle_hint is temp, so it cannot survive a logout, but it can
// survive closing the window with the hint up - and the next box opened would show a solved
// picture of a board that had just been shuffled.
%trail_puzzle_hint = ^false;
if_openmain(trail_puzzle);

[proc,init_trail_puzzle]
inv_setslot(trail_puzzleinv, 0, trail_slidingpuzzleb01, 1);
inv_setslot(trail_puzzleinv, 1, trail_slidingpuzzleb02, 1);
inv_setslot(trail_puzzleinv, 2, trail_slidingpuzzleb03, 1);
inv_setslot(trail_puzzleinv, 3, trail_slidingpuzzleb04, 1);
inv_setslot(trail_puzzleinv, 4, trail_slidingpuzzleb05, 1);
inv_setslot(trail_puzzleinv, 5, trail_slidingpuzzleb06, 1);
inv_setslot(trail_puzzleinv, 6, trail_slidingpuzzleb07, 1);
inv_setslot(trail_puzzleinv, 7, trail_slidingpuzzleb08, 1);
inv_setslot(trail_puzzleinv, 8, trail_slidingpuzzleb09, 1);
inv_setslot(trail_puzzleinv, 9, trail_slidingpuzzleb10, 1);
inv_setslot(trail_puzzleinv, 10, trail_slidingpuzzleb11, 1);
inv_setslot(trail_puzzleinv, 11, trail_slidingpuzzleb12, 1);
inv_setslot(trail_puzzleinv, 12, trail_slidingpuzzleb13, 1);
inv_setslot(trail_puzzleinv, 13, trail_slidingpuzzleb14, 1);
inv_setslot(trail_puzzleinv, 14, trail_slidingpuzzleb15, 1);
inv_setslot(trail_puzzleinv, 15, trail_slidingpuzzleb16, 1);
inv_setslot(trail_puzzleinv, 16, trail_slidingpuzzleb17, 1);
inv_setslot(trail_puzzleinv, 17, trail_slidingpuzzleb18, 1);
inv_setslot(trail_puzzleinv, 18, trail_slidingpuzzleb19, 1);
inv_setslot(trail_puzzleinv, 19, trail_slidingpuzzleb20, 1);
inv_setslot(trail_puzzleinv, 20, trail_slidingpuzzleb21, 1);
inv_setslot(trail_puzzleinv, 21, trail_slidingpuzzleb22, 1); 
inv_setslot(trail_puzzleinv, 22, trail_slidingpuzzleb23, 1);
inv_setslot(trail_puzzleinv, 23, trail_slidingpuzzleb24, 1);

~shuffle_trail_puzzle;

// This achieves randomization by essentially simulating 101 moves using the adj slot to each piece starting from the bottom right
// (since the puzzle is init'd in a completed state: https://x.com/JagexAsh/status/1301202083845201921)
[proc,shuffle_trail_puzzle]
def_int $moves = 101;
def_int $current_idx = 24;
while($moves > 0) {
    // horizontal
    def_int $next_idx = ~random_puzzle_slot($current_idx);
    if($next_idx ! -1) {
        inv_movetoslot(trail_puzzleinv, trail_puzzleinv, $next_idx, $current_idx);
    }
    $moves = calc($moves - 1);
    $current_idx = $next_idx;
}

[proc,random_puzzle_slot](int $slot)(int)
def_int $left_slot = -1;
def_int $right_slot = -1;
def_int $down_slot = -1;
def_int $up_slot = -1;
def_int $adj_slots = 0;
if (modulo($slot, 5) ! 0) {
    $left_slot = calc($slot - 1);
    $adj_slots = calc($adj_slots + 1);
}
if (modulo($slot, 5) ! 4) {
    $right_slot = calc($slot + 1);
    $adj_slots = calc($adj_slots + 1);
}

// vertical
if($slot >= 5) {
    $up_slot = calc($slot - 5);
    $adj_slots = calc($adj_slots + 1);
}
if($slot <= 19) {
    $down_slot = calc($slot + 5);
    $adj_slots = calc($adj_slots + 1);
} 

// Randomly select one of the available adjacent slots
if ($adj_slots > 0) {
    def_int $random_index = random($adj_slots);
    if ($left_slot ! -1) {
        if ($random_index = 0) {
            return ($left_slot);
        }
    } 

    if ($right_slot ! -1) {
        if ($random_index = 0 & $left_slot = -1) {
            return ($right_slot);
        } else if ($random_index = 1) {
            return ($right_slot);
        }
    } 

    if ($up_slot ! -1) {
        if ($random_index <= 1 & $right_slot = -1) {
            return ($up_slot);
        } else if ($random_index = 2) {
            return ($up_slot);
        }
    }

    if ($down_slot ! -1) {
        if ($random_index <= 2 & $up_slot = -1) {
            return ($down_slot);
        } else if ($random_index = 3) {
            return ($down_slot);
        }
    }
}
return ($down_slot);

[proc,trail_puzzle_complete]()(boolean)
if (inv_getobj(trail_puzzleinv, 0) = trail_slidingpuzzleb01 &
        inv_getobj(trail_puzzleinv, 1) = trail_slidingpuzzleb02 &
        inv_getobj(trail_puzzleinv, 2) = trail_slidingpuzzleb03 &
        inv_getobj(trail_puzzleinv, 3) = trail_slidingpuzzleb04 &
        inv_getobj(trail_puzzleinv, 4) = trail_slidingpuzzleb05 &
        inv_getobj(trail_puzzleinv, 5) = trail_slidingpuzzleb06 &
        inv_getobj(trail_puzzleinv, 6) = trail_slidingpuzzleb07 &
        inv_getobj(trail_puzzleinv, 7) = trail_slidingpuzzleb08 &
        inv_getobj(trail_puzzleinv, 8) = trail_slidingpuzzleb09 &
        inv_getobj(trail_puzzleinv, 9) = trail_slidingpuzzleb10 &
        inv_getobj(trail_puzzleinv, 10) = trail_slidingpuzzleb11 &
        inv_getobj(trail_puzzleinv, 11) = trail_slidingpuzzleb12 &
        inv_getobj(trail_puzzleinv, 12) = trail_slidingpuzzleb13 &
        inv_getobj(trail_puzzleinv, 13) = trail_slidingpuzzleb14 &
        inv_getobj(trail_puzzleinv, 14) = trail_slidingpuzzleb15 &
        inv_getobj(trail_puzzleinv, 15) = trail_slidingpuzzleb16 &
        inv_getobj(trail_puzzleinv, 16) = trail_slidingpuzzleb17 &
        inv_getobj(trail_puzzleinv, 17) = trail_slidingpuzzleb18 &
        inv_getobj(trail_puzzleinv, 18) = trail_slidingpuzzleb19 &
        inv_getobj(trail_puzzleinv, 19) = trail_slidingpuzzleb20 &
        inv_getobj(trail_puzzleinv, 20) = trail_slidingpuzzleb21 &
        inv_getobj(trail_puzzleinv, 21) = trail_slidingpuzzleb22 &
        inv_getobj(trail_puzzleinv, 22) = trail_slidingpuzzleb23 &
        inv_getobj(trail_puzzleinv, 23) = trail_slidingpuzzleb24) {
    return (true);
}
return (false);

// MONKEY MADNESS watches this trigger. Its hangar panel opens the same puzzle (see
// [oploc1,bunker_controlpanal] in quests/quest_mm/scripts/quest_mm.rs2), and this is the only place
// that knows a piece has just moved. Both guards matter: the stage, and standing in the hangar -
// without the second one a player who happened to be at that stage would solve the panel by
// finishing a clue puzzle in Varrock.
[opheld5,_trail_puzzle_piece]
// NOT WHILE THE ANSWER IS ON SCREEN. This moves pieces by their slot in trail_puzzleinv, and the
// Hint shows a different board through the same component - so a click here would move a piece of
// the player's board chosen by its position in the solved one. Put their board back and move
// nothing, which is more forgiving than ignoring the click and leaving them wondering.
if (%trail_puzzle_hint = ^true) {
    %trail_puzzle_hint = ^false;
    inv_transmit(trail_puzzleinv, trail_puzzle:com_2);
    return;
}
def_int $slot = last_slot;
def_int $open_slot = -1;
    
// horizontal
if (modulo($slot, 5) ! 0) {
    if (inv_getobj(trail_puzzleinv, calc($slot - 1)) = null) $open_slot = calc($slot - 1);
}
if (modulo($slot, 5) ! 4) {
    if (inv_getobj(trail_puzzleinv, calc($slot + 1)) = null) $open_slot = calc($slot + 1);
}

// vertical
if($slot >= 5) {
    if (inv_getobj(trail_puzzleinv, calc($slot - 5)) = null) $open_slot = calc($slot - 5);
}
if($slot <= 19) {
    if (inv_getobj(trail_puzzleinv, calc($slot + 5)) = null) $open_slot = calc($slot + 5);
} 

if($open_slot ! -1) {
    sound_synth(slide_puzzle, 1, 0);
    inv_movetoslot(trail_puzzleinv, trail_puzzleinv, $slot, $open_slot);
}

// MONKEY MADNESS watches this trigger. Its hangar panel opens the same puzzle (see
// [oploc1,bunker_controlpanal] in quests/quest_mm/scripts/quest_mm.rs2) and this is the only
// place that knows a piece has just moved. It has to be LAST: ~mesbox pauses, and a pausing
// call corrupts last_slot, which the slide code above still needs.
//
// Both guards matter - the stage, and standing in the hangar. Without the second one a player
// who happened to be at that stage would open the hangar doors by finishing a clue puzzle in
// Varrock.
if (%mm_main = ^mm_in_hangar & %mm_hangar_puzzle_complete = ^false
    & inzone(^mm_hangar_zone_min, ^mm_hangar_zone_max, coord) = true) {
    if (~trail_puzzle_complete = true) {
        %mm_hangar_puzzle_complete = ^true;
        ~mesbox("The last square slides home. Somewhere above you a great many bolts come undone at once, and the hangar doors start to move.");
    }
}

// ------------------------------------------------------------------ the Hint button
//
// com_3 IS THE HINT BUTTON and has never had a trigger - on the clue boxes or on Monkey Madness's
// hangar panel, which opens this same interface. Clicking it answered "no if_button trigger for
// trail_puzzle:com_3" and did nothing, which is what a player reported from the hangar
// (DeathPlateau-Bugs#35). Two independent sources in the repo name com_3 as Hint: the comment in
// [label,trail_open_puzzle] above, and the client's own Component.java, which records that the
// content once transmitted the PIECES to com_3 by mistake and logged players out for it.
//
// WHAT IT SHOWS, on Corey's call (option B, 23 November): the completed picture, in the grid
// itself. The cache has no solved-picture panel to open - trail_puzzle is com_0..com_9 and none of
// them is one - so the Hint swaps the grid's inventory for a board that is filled in order and
// never shuffled, and swaps it back. A TOGGLE rather than a timer: a hint that vanishes after
// three seconds is worse than no hint, and the player closing the window is handled on open.
[if_button,trail_puzzle:com_3]
if (%trail_puzzle_hint = ^true) {
    %trail_puzzle_hint = ^false;
    inv_transmit(trail_puzzleinv, trail_puzzle:com_2);
    return;
}
%trail_puzzle_hint = ^true;
~trail_puzzle_fill_hint;
inv_transmit(trail_puzzlehint, trail_puzzle:com_2);

// Filled every time rather than once, because the alternative is a second board whose contents
// depend on whether anybody has opened a puzzle this session. 24 pieces in slots 0-23 and slot 24
// left empty, which is the order [proc,init_trail_puzzle] builds before it shuffles - that proc
// cannot be reused here because it writes into the live board.
[proc,trail_puzzle_fill_hint]
inv_setslot(trail_puzzlehint, 0, trail_slidingpuzzleb01, 1);
inv_setslot(trail_puzzlehint, 1, trail_slidingpuzzleb02, 1);
inv_setslot(trail_puzzlehint, 2, trail_slidingpuzzleb03, 1);
inv_setslot(trail_puzzlehint, 3, trail_slidingpuzzleb04, 1);
inv_setslot(trail_puzzlehint, 4, trail_slidingpuzzleb05, 1);
inv_setslot(trail_puzzlehint, 5, trail_slidingpuzzleb06, 1);
inv_setslot(trail_puzzlehint, 6, trail_slidingpuzzleb07, 1);
inv_setslot(trail_puzzlehint, 7, trail_slidingpuzzleb08, 1);
inv_setslot(trail_puzzlehint, 8, trail_slidingpuzzleb09, 1);
inv_setslot(trail_puzzlehint, 9, trail_slidingpuzzleb10, 1);
inv_setslot(trail_puzzlehint, 10, trail_slidingpuzzleb11, 1);
inv_setslot(trail_puzzlehint, 11, trail_slidingpuzzleb12, 1);
inv_setslot(trail_puzzlehint, 12, trail_slidingpuzzleb13, 1);
inv_setslot(trail_puzzlehint, 13, trail_slidingpuzzleb14, 1);
inv_setslot(trail_puzzlehint, 14, trail_slidingpuzzleb15, 1);
inv_setslot(trail_puzzlehint, 15, trail_slidingpuzzleb16, 1);
inv_setslot(trail_puzzlehint, 16, trail_slidingpuzzleb17, 1);
inv_setslot(trail_puzzlehint, 17, trail_slidingpuzzleb18, 1);
inv_setslot(trail_puzzlehint, 18, trail_slidingpuzzleb19, 1);
inv_setslot(trail_puzzlehint, 19, trail_slidingpuzzleb20, 1);
inv_setslot(trail_puzzlehint, 20, trail_slidingpuzzleb21, 1);
inv_setslot(trail_puzzlehint, 21, trail_slidingpuzzleb22, 1);
inv_setslot(trail_puzzlehint, 22, trail_slidingpuzzleb23, 1);
inv_setslot(trail_puzzlehint, 23, trail_slidingpuzzleb24, 1);
