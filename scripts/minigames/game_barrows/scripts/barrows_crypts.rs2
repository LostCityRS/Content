[oploc1,barrow_ahrim_sarcophagus]
mes("You don't find anything.");

if (~barrows_entrance_get = ^barrows_entrance_ahrim) {
    @barrows_catacombs_enter;
} else if (%barrows_killed_ahrim = 0 & ~barrows_hunt_brother(barrows_ahrim) = false) {
    ~barrows_spawn_brother(barrows_ahrim, ^barrows_speech_disturb);
}

