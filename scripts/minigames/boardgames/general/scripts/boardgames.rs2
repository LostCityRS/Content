// TODOS: Challenge room logic (Noteworthy Glitch https://www.youtube.com/watch?v=js7TproAYSY)
//        Sitting at table & spectate game logic (Noteworthy glitch https://www.youtube.com/watch?v=GxdihzOz03s)
//        Upstairs high ranked areas
//        Misc. Doors / ladders / stairs / npcs (bartender)
[proc,set_boardgames_timepermove](int $time)
if (.p_finduid(%duel2accept) = false) {
    mes("That player is no longer available.");
    if_close;
    return;    
}
if(.%duel2accept = uid) {
    mes("You can not change the time per move when accepting a challenge.");
} else {
    %boardgames_timepermove = $time;
}

[proc,set_boardgames_piece](int $piece)
if (.p_finduid(%duel2accept) = false) {
    mes("That player is no longer available.");
    if_close;
    return;    
}
if(.%duel2accept = uid & .%boardgames_piece = $piece) {
    mes("Your opponent is using this piece, please choose another.");
} else {
    %boardgames_piece = $piece;
}

[proc,toggle_boardgames_ranked]
if (.p_finduid(%duel2accept) = false) {
    mes("That player is no longer available.");
    if_close;
    return;    
}
if(.%duel2accept = uid) {
    mes("You can not change the ranked option when accepting a challenge.");
} else {
    if (%boardgames_rankedgame = ^false) {
        %boardgames_rankedgame = ^true;
    } else {
        %boardgames_rankedgame = ^false;
    }
}

[proc,reset_boardgames_varp]
%boardgames_timepermove = 0;
%boardgames_piece = 0;
%boardgames_myturn = 0;
%boardgames_tablenum = 0;
%boardgames_viewing = 0;
%boardgames_closemode = 0;
%boardgames_closereason = 0;
%boardgames_numturns = 0;
%boardgames_rankedgame = 0;
%boardgames_ingame = 0;
%boardgames_drawrequested = 0;

[proc,boardgames_hide_tabs]
if_settab(null, 0);
if_settab(null, 1);
if_settab(null, 2);
if_settab(null, 3);
if_settab(null, 4);
if_settab(null, 5);
if_settab(null, 6);
if_settab(null, 11);
if_settab(null, 12);

[proc,.boardgames_hide_tabs]
if (.p_finduid(.uid) = true) {
    .if_settab(null, 0);
    .if_settab(null, 1);
    .if_settab(null, 2);
    .if_settab(null, 3);
    .if_settab(null, 4);
    .if_settab(null, 5);
    .if_settab(null, 6);
    .if_settab(null, 11);
    .if_settab(null, 12);
}

[mapzone,0_34_77]
set_player_op("Challenge", 1, ^false);

[mapzoneexit,0_34_77]
set_player_op(null, 1, ^false);

[opplayer1,_]
if (.busy = true) {
    mes("Other player is busy at the moment."); // https://youtu.be/YkJQDvB14-U?t=26
    return;
}

if (~in_games_room(coord) = true & ~in_games_room(.coord) = true) {
    // guessing it uses some varp as duel arena challenges
    %duel2accept = .uid;
    if(.%duel2accept ! uid) {
        if_settext(boardgames_challenge:draughts_rank, "<tostring(%boardgames_draughts_rank)> vs <tostring(.%boardgames_draughts_rank)>");
        if_settext(boardgames_challenge:runelink_rank, "<tostring(%boardgames_runelink_rank)> vs <tostring(.%boardgames_runelink_rank)>");
        if_settext(boardgames_challenge:runesquares_rank, "<tostring(%boardgames_runesquares_rank)> vs <tostring(.%boardgames_runesquares_rank)>");
        if_settext(boardgames_challenge:runeversi_rank, "<tostring(%boardgames_runeversi_rank)> vs <tostring(.%boardgames_runeversi_rank)>");
        if_openmain(boardgames_challenge);
    } else {
        %boardgames_game = .%boardgames_game;
        %boardgames_rankedgame = .%boardgames_rankedgame;
        %boardgames_timepermove = .%boardgames_timepermove;
        if (.%boardgames_piece = 1) {
            %boardgames_piece = 2;
        } else {
            %boardgames_piece = 1;
        }
        ~open_boardgames_options;
    }
}

// TODO: Duel Arena uses this too. Probably move it somewhere else

[proc,in_games_room](coord $coord)(boolean)
if (~inzone_coord_pair_table(games_room_zones, $coord) = true) {
    return(true);
}
return(false);

[if_button,boardgames_challenge:draughts_radio]
%boardgames_game = 0;
%if1 = 0;

[if_button,boardgames_challenge:draughts_text]
%boardgames_game = 0;
%if1 = 0;

[if_button,boardgames_challenge:runelink_radio]
%boardgames_game = 1;
%if1 = 1;

[if_button,boardgames_challenge:runelink_text]
%boardgames_game = 1;
%if1 = 1;

[if_button,boardgames_challenge:runesquares_radio]
%boardgames_game = 2;
%if1 = 2;

[if_button,boardgames_challenge:runesquares_text]
%boardgames_game = 2;
%if1 = 2;

[if_button,boardgames_challenge:runeversi_radio]
%boardgames_game = 3;
%if1 = 3;

[if_button,boardgames_challenge:runeversi_text]
%boardgames_game = 3;
%if1 = 3;

[if_button,boardgames_challenge:select]
%boardgames_closinginterface = 1; // Why does this exist?
%boardgames_timepermove = 1;
%boardgames_rankedgame = 1;
%boardgames_piece = 1;
%boardgames_closinginterface = 0;
~open_boardgames_options;

[proc,get_sandtimer_seq]()(seq)
switch_int (%boardgames_timepermove) {
    case 0 : return (sandtimer_15secs);
    case 1 : return (sandtimer_30secs);
    case 2 : return (sandtimer_60secs);
    case 3 : return (sandtimer_120secs);
}

[proc,get_sandtimer_interval]()(int)
switch_int (%boardgames_timepermove) {
    case 0 : return (25);
    case 1 : return (50);
    case 2 : return (100);
    case 3 : return (200);
}

[proc,get_boardgames_timepermove]()(string)
switch_int (%boardgames_timepermove) {
    case 0 : return ("15 seconds");
    case 1 : return ("30 seconds");
    case 2 : return ("1 minute");
    case 3 : return ("2 minutes");
}

[proc,get_boardgames_game]()(string)
switch_int (%boardgames_game) {
    case 0 : return ("Draughts");
    case 1 : return ("Runelink");
    case 2 : return ("Runesquares");
    case 3 : return ("Runeversi");
}

[proc,get_boardgames_rune_obj](int $choice)(obj)
switch_int ($choice) {
    case 1 : return (boardgames_firerune);
    case 2 : return (boardgames_waterrune);
    case 3 : return (boardgames_earthrune);
    case 4 : return (boardgames_airrune);
    case 5 : return (boardgames_mindrune);
    case 6 : return (boardgames_bodyrune);
    case 7 : return (boardgames_naturerune);
    case 8 : return (boardgames_chaosrune);
    case 9 : return (boardgames_lawrune);
    case 10 : return (boardgames_cosmicrune);
    case 11 : return (boardgames_bloodrune);
    case 12 : return (boardgames_soulrune);
}

//OSRS uses the runelink objs for other games (draughts). Should be same here.
[proc,get_boardgames_player_rune](int $choice)(namedobj)
switch_int ($choice) {
    case 1 : return (boardgames_runelink_firerune);
    case 2 : return (boardgames_runelink_waterrune);
    case 3 : return (boardgames_runelink_earthrune);
    case 4 : return (boardgames_runelink_airrune);
    case 5 : return (boardgames_runelink_mindrune);
    case 6 : return (boardgames_runelink_bodyrune);
    case 7 : return (boardgames_runelink_naturerune);
    case 8 : return (boardgames_runelink_chaosrune);
    case 9 : return (boardgames_runelink_lawrune);
    case 10 : return (boardgames_runelink_cosmicrune);
    case 11 : return (boardgames_runelink_bloodrune);
    case 12 : return (boardgames_runelink_soulrune);
}

[proc,get_boardgames_rank]()(string)
switch_int (%boardgames_game) {
    case 0 : return (tostring(%boardgames_draughts_rank));
    case 1 : return (tostring(%boardgames_runelink_rank));
    case 2 : return (tostring(%boardgames_runesquares_rank));
    case 3 : return (tostring(%boardgames_runeversi_rank));
}

[proc,open_boardgames_options]
switch_int (%boardgames_game) {
    case 0 : if_openmain(boardgames_draughts_options);
    case 1 : if_openmain(boardgames_runelink_options);
    case 2 : if_openmain(boardgames_runesquares_options);
    case 3 : if_openmain(boardgames_runeversi_options);
}

[proc,send_boardgames_challenge_request]
def_string $time = ~get_boardgames_timepermove();
def_string $game = ~get_boardgames_game();
def_string $rank = ~get_boardgames_rank();
if(%boardgames_rankedgame = 1) {
    .mes("<displayname>:(<$rank>) wants a ranked game of <$game>, <$time> per move.:chalreq:");
} else {
    .mes("<displayname>:wants an unranked game of <$game>, <$time> per move.:chalreq:");
}

[proc,calculate_rank_change](int $loser, int $winner)(int)
def_int $rank_change = add(50, divide(sub($loser, $winner), 16));

if($rank_change > 100) {
    $rank_change = 100;
} else if ($rank_change < 1) {
    $rank_change = 1;
}

return ($rank_change);