/**
 * Managing Miscellania is a daily minigame that lets you control Miscellania and Etceteria
 *
 * There seems to be 3 updates:
 * - Throne of Miscellania (Without flax) early 2005
 * - Throne of Miscellania (With flax) late 2005
 * - Royal Trouble (With Etceteria) 2006
 *
 */
[proc,open_manage_miscellania_interface]
if_openmain(inter_210);
%if1 = calc(10 - %misc_points_mine - %misc_points_wood - %misc_points_herb - %misc_points_fish);
%if2 = 0;
%misc_coffers = 100000;
if_settext(inter_210:com_87, tostring(%misc_coffers));

// Mining Up
[if_button,inter_210:com_11]
if (%if1 > 0) {
    %if1 = max(sub(%if1, 1), 0);
    %misc_points_mine = min(add(%misc_points_mine, 1), 10);
}

// Mining Down
[if_button,inter_210:com_12]
if (%misc_points_mine > 0) {
    %misc_points_mine = max(sub(%misc_points_mine, 1), 0);
    %if1 = min(add(%if1, 1), 10);
}
// Wood Up
[if_button,inter_210:com_46]
if (%if1 > 0) {
    %if1 = max(sub(%if1, 1), 0);
    %misc_points_wood = min(add(%misc_points_wood, 1), 10);
}

// Wood Down
[if_button,inter_210:com_47]
if (%misc_points_wood > 0) {
    %misc_points_wood = max(sub(%misc_points_wood, 1), 0);
    %if1 = min(add(%if1, 1), 10);
}
// Herb Up
[if_button,inter_210:com_27]
if (%if1 > 0) {
    %if1 = max(sub(%if1, 1), 0);
    %misc_points_herb = min(add(%misc_points_herb, 1), 10);
}

// Herb Down
[if_button,inter_210:com_28]
if (%misc_points_herb > 0) {
    %misc_points_herb = max(sub(%misc_points_herb, 1), 0);
    %if1 = min(add(%if1, 1), 10);
}
// Fishing Up
[if_button,inter_210:com_62]
if (%if1 > 0) {
    %if1 = max(sub(%if1, 1), 0);
    %misc_points_fish = min(add(%misc_points_fish, 1), 10);
}

// Fishing Down
[if_button,inter_210:com_63]
if (%misc_points_fish > 0) {
    %misc_points_fish = max(sub(%misc_points_fish, 1), 0);
    %if1 = min(add(%if1, 1), 10);
}

// Fishing Cooked
[if_button,inter_210:com_108]
%misc_cooked = togglebit(%misc_cooked, 0);

// Help Button
[if_button,inter_210:com_95]
%if2 = togglebit(%if2, 0);

// Deposit
[if_button,inter_210:com_88]

// Withdraw
[if_button,inter_210:com_89]


// We will use varp_360 for the last time calculation.
[proc,calculate_miscellania_goods]
def_int $current_time_mins = date_minutes;
def_int $last_time_mins = %varp_360;
def_int $coffer_total = %misc_coffers;
def_int $approval_rating = %misc_approval;
def_int $resource_pts = 0;

// --- Safety check: Limit to 30 days ---
def_int $max_catchup_mins = multiply(30, ^MISCELLANIA_INTERVAL);
if ($current_time_mins > add($last_time_mins, $max_catchup_mins)) {
    $last_time_mins = sub($current_time_mins, $max_catchup_mins);
}

// --- Main Calculation Loop
def_int $i = 1;
while ($i <= 30) {
    if (sub($current_time_mins, $last_time_mins) >= ^MISCELLANIA_INTERVAL) {
        if ($coffer_total > 0) {
            // reductionAmount = 5 + cofferTotal * tax / 100
            def_int $reduction_amount = add(5, divide(multiply($coffer_total, ^MISCELLANIA_TAX_RATE), 100));
            $coffer_total = sub($coffer_total, $reduction_amount);
            
            // workerEffectiveness = reductionAmount * 100 / 8333 * effectiveness / 100
            // We multiply first to keep precision in integer math
            def_int $worker_effectiveness = divide(multiply(divide(multiply($reduction_amount, 100), 8333), ^MISCELLANIA_EFFECTIVENESS_RATE), 100);
            
            // resourcePts += workerEffectiveness/100 * approvalRating * 127/100
            def_int $added_pts = divide(multiply(multiply(divide($worker_effectiveness, 100), $approval_rating), 127), 100);
            $resource_pts = add($resource_pts, $added_pts);
            
            // Cap at 262143
            if ($resource_pts > 262143) {
                $resource_pts = 262143;
            }
        }
        
        // Reduce Approval: 1% if Royal Trouble complete, 2.5% (represented as 25/1000) otherwise
        def_int $loss_factor = 25;
        // if (%royal_trouble = ^royal_trouble_complete) { $loss_factor = 10; } // Only when royal_trouble is added
        
        // approvalRating -= (approvalRating * factor / 1000)
        def_int $approval_loss = divide(multiply($approval_rating, $loss_factor), 1000);
        $approval_rating = sub($approval_rating, $approval_loss);
        
        $last_time_mins = add($last_time_mins, ^MISCELLANIA_INTERVAL);
        $i = add($i, 1);
    } else {
        // Break condition (Runescript lacks break, so we force the counter)
        $i = 31;
    }
}

// --- Save Back State ---
%misc_coffers = $coffer_total;
%misc_approval = $approval_rating;
%varp_360 = $last_time_mins;

// --- Rewards Calculation ---
// Runescript doesn't have HashMaps. We directly call ~add_to_misc_reward_buffer(item, quantity)

// Wood (InverseCost = 160)
def_int $wood_qty = divide(multiply(multiply(160, $resource_pts), %misc_points_wood), 2048);
if ($wood_qty > 0) {
//     ~add_to_misc_reward_buffer(^maple_logs, $wood_qty);
//     ~add_misc_chance_reward(^NESTS_TABLE, divide($wood_qty, 100));
}

// Coal (InverseCost = 98)
def_int $coal_qty = divide(multiply(multiply(98, $resource_pts), %misc_points_mine), 2048);
if ($coal_qty > 0) {
//     ~add_to_misc_reward_buffer(^coal, $coal_qty);
//     ~add_misc_chance_reward(^GEMS_TABLE, divide(add($coal_qty, 100), 200));
}

// Fish (InverseCost = 158)
def_int $fish_qty = divide(multiply(multiply(158, $resource_pts), %misc_points_fish), 2048);
if ($fish_qty > 0) {
// TODO: remember to care about cooked checkbox.
//     def_obj $tuna = ^raw_tuna;
//     def_obj $sword = ^raw_swordfish;
//     if (%attribute_option_fishing = 1) {
//         $tuna = ^tuna;
//         $sword = ^swordfish;
//     }
//     ~add_to_misc_reward_buffer($tuna, divide($fish_qty, 2));
//     ~add_to_misc_reward_buffer($sword, divide(multiply($fish_qty, 15), 100));
//     ~add_misc_chance_reward(^LOOTS_TABLE, divide(divide($fish_qty, 2), 100));
}

// Herbs (InverseCost = 11) / Flax later at (InverseCost = 224)
def_int $herb_qty = divide(multiply(multiply(11, $resource_pts), %misc_points_herb), 2048);
if ($herb_qty > 0) {
//     if (%attribute_option_herbs = 1) {
//         ~add_to_misc_reward_buffer(^flax, $herb_qty);
//         ~add_misc_chance_reward(^SEEDS_TABLE, divide($herb_qty, 600));
