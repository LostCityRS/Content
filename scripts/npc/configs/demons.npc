[mm_demon]
name=Jungle Demon
desc=A Greater Jungle Demon. A magical aura emanates from its hide.
model1=npc_greater_demon
recol1s=11264
recol1d=7460
recol2s=29596
recol2d=29416
recol3s=1024
recol3d=29416
recol4s=15393
recol4d=8517
recol5s=2048
recol5d=29416
recol6s=0
recol6d=16549
size=3
walkanim=demon_walk
readyanim=demon_ready
resizeh=150
resizev=140
turnspeed=16
op2=Attack
vislevel=195
// FIXED 2026-09-09 (first playtest): it had walkanim and readyanim from the cache but none of the
// three combat anims, so attacking, blocking and dying all fell back to defaults. Same three params
// [greater_demon] uses in this file.
param=attack_anim,demon_attack
param=defend_anim,demon_block
param=death_anim,demon_death_greater

// FIXED 2026-09-08 (Monkey Madness stage three): op2=Attack and no combat stats at all - the quest's
// final boss was unkillable. Levels and bonuses read off the OSRS wiki page for the Jungle Demon,
// the same source this repo's drop tables already cite: 170 in Hitpoints, Attack, Strength, Defence
// and Magic, +50 attack and +50 strength, and +50 to slash and magic defence with nothing elsewhere.
// attackrate 6 rather than the engine default of 4 - the wiki gives 6 ticks - and a max hit of 32.
// Anything the wiki does not supply is omitted so the engine default applies.
hitpoints=170
attack=170
strength=170
defence=170
magic=170
param=attackrate,6
param=attackbonus,50
param=strengthbonus,50
param=slashdefence,50
param=magicdefence,50
param=damagetype,^slash_style
param=death_drop,ashes

// AND IT CASTS. Reported as "jungle demon only attacks with melee and not both mage and melee"
// (DeathPlateau-Bugs#48), and the OSRS wiki's Jungle Demon page is explicit: it "alternates between
// all four wave spells for its magic attacks", and both styles hit up to 32. It had no attackrange
// at all, so it could only ever reach [ai_opplayer2] standing next to you, and no magicattack_anim,
// so a cast would have fallen back to the SPELL's animation - a player's cast on a demon rig, which
// is the same mistake as the skeletons in DeathPlateau-Bugs#68.
//
// Both numbers are [koldemon]'s, above in this file: Kolodion's demon form is the same
// npc_greater_demon mesh at the same size=3, fighting with melee and magic, and it already carries
// attackrange=5 and demon_casting. So these are read off an npc the cache itself configured for
// this rather than guessed, and demon_casting is the greater demon's own cast - it exists in the
// 377 seqs and [koldemon] is its only other user.
//
// The AI that chooses between them is [proc,mm_demon_attack] in
// quests/quest_mm/scripts/mm_stage3.rs2, beside the rest of the final battle.
attackrange=5
param=magicattack_anim,demon_casting

param=attack_sound,demon_attack
param=death_sound,demon_death
param=defend_sound,demon_hit
