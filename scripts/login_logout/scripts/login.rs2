[login,_]
mes("Welcome to RuneScape.");

%musicplay = 1; // set to auto on login

bas_readyanim(human_ready);
bas_turnonspot(human_turnonspot);
bas_walk_f(human_walk_f);
bas_walk_b(human_walk_b);
bas_walk_l(human_walk_l);
bas_walk_r(human_walk_r);
bas_running(human_running);
buildappearance(worn);

inv_transmit(inv, inventory:inv);
inv_transmit(worn, wornitems:worn);

if_settab("combat-unarmed", ^tab_combat);
if_settab(stats, ^tab_stats);
if_settab(questlist, ^tab_quests);
if_settab(inventory, ^tab_inv);
if_settab(wornitems, ^tab_worn);
if_settab(prayer, ^tab_prayer);
if_settab(magic, ^tab_magic);
if_settab(friends, ^tab_friend);
if_settab(ignore, ^tab_ignore);
if_settab(logout, ^tab_logout);
if_settab(controls, ^tab_controls);

if (lowmemory = false) {
    if_settab(options, ^tab_options);
    if_settab(music, ^tab_music);
} else {
    if_settab(options_ld, ^tab_options);
    if_settab(music_ld, ^tab_music);
}

if (map_production = true) {
    if_openfull(inter_353, inter_313);
    if_settext(inter_353:com_1,"Did you know, all the weapon stats are listed on our new");
    if_settext(inter_353:com_2,"Knowledge Base?");
    // todo: Set if player has pin? 
    if_settext(inter_313:com_19,"You do not have a Bank PIN. Please visit a bank\\nif you would like one.");
    last_login_info;
}
