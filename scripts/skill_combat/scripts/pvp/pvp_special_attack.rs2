[label,pvp_special_attack]
if (.%death = ^true) {
    p_stopaction;
    return;
}
if (stat(hitpoints) = 0) {
    return;
}
if (inv_getobj(worn, ^wearpos_rhand) ! granite_maul & %action_delay > map_clock) {
    p_opplayer(2);
    return;
}
if (~sa_enough_energy = false) {
    // If players attempt to use a special attack with insufficient energy then they'll find that instead 
    // of a special attack failing and no attack occurring, a regular attack will instead be performed.
    // - https://oldschool.runescape.wiki/w/Update:PvM_QoL_updates_%26_Wilderness_Rejuvenation_improvements
    // p_stopaction; // based on the way ive implemented specs, this is necessary to produce the behavior above.
    return;
}
if (~duel_arena_spec_check = false) {
    return;
}
if (%damagetype = ^ranged_style) {
    if (~duel_arena_ranged_check = false) {
        return;
    }
} else {
    if (~duel_arena_melee_check = false) {
        return;
    }
}
def_obj $weapon = inv_getobj(worn, ^wearpos_rhand);
// Quick Smash ignores the attack delay and adds none (pvp_specs_osrs.rs2)
if ($weapon = granite_maul) {
    @pvp_granite_maul_sa;
}
// weps like shortbow are always their default attackrate (regardless of style)
// - https://youtu.be/hAsKD72uJEE?si=BU4yzV9lxb_7uQKg&t=188
%action_delay = add(map_clock, oc_param($weapon, attackrate));
p_opplayer(2);

// THE ORNAMENTED VERSIONS ARE LISTED BESIDE THEIR PLAIN ONES (DeathPlateau-Bugs#54, reported as
// "using orn kit on weps that has specs").
//
// An ornament kit turns an item into a DIFFERENT obj - dragon_scimitar becomes dragon_scimitar_or -
// and the ornamented obj correctly keeps param=specwep and param=sa_energy, so the special bar
// lights up and the click spends the energy. This switch is what decides what actually happens, and
// it named only the plain ids, so the five kitted spec weapons drained the bar and did nothing.
//
// Only five of the build's 26 ornament pairs are spec weapons, and all five were affected: the
// dragon scimitar and the four godswords. The other kits are armour and cosmetics.
switch_obj($weapon) {
    case dragon_dagger, dragon_dagger_p, dragon_dagger_p+, dragon_dagger_p++ : @pvp_dragon_dagger_sa;
    case dragon_longsword : @pvp_dragon_longsword_sa;
    case dragon_mace : @pvp_dragon_mace_sa;
    case magic_shortbow, magic_shortbow_i : @pvp_magic_shortbow_sa;
    case magic_longbow : @pvp_magic_longbow_sa;
    case rune_thrownaxe : @pvp_rune_thrownaxe_sa;
    case dragon_spear, dragon_spear_p, dragon_spear_p+, dragon_spear_p++, tbwt_dragon_spear_kp : @pvp_dragon_spear_sa;
    case rune_claws : @pvp_rune_claws_sa;
    case abyssal_whip : @pvp_abyssal_whip_sa;
    case abyssal_tentacle : @pvp_abyssal_tentacle_sa;
    case arkan_blade : @pvp_arkan_blade_sa;
    case granite_hammer : @pvp_granite_hammer_sa;
    case dragon_warhammer : @pvp_dragon_warhammer_sa;
    case dragon_sword : @pvp_dragon_sword_sa;
    case abyssal_bludgeon : @pvp_abyssal_bludgeon_sa;
    case dragon_scimitar, dragon_scimitar_or : @pvp_dragon_scimitar_sa;
    case zamorakian_spear : @pvp_zamorakian_spear_sa;
    case dragon_halberd : @pvp_dragon_halberd_sa;
    case dragon_2h_sword : @pvp_dragon_2h_sword_sa;
    case armadyl_godsword, armadyl_godsword_or : @pvp_armadyl_godsword_sa;
    case bandos_godsword, bandos_godsword_or : @pvp_bandos_godsword_sa;
    case saradomin_godsword, saradomin_godsword_or : @pvp_saradomin_godsword_sa;
    case zamorak_godsword, zamorak_godsword_or : @pvp_zamorak_godsword_sa;
    case saradomin_sword : @pvp_saradomin_sword_sa;
    case toxic_blowpipe, toxic_blowpipe_empty : @pvp_blowpipe_sa; // toxic_blowpipe/scripts/blowpipe_combat.rs2
}
