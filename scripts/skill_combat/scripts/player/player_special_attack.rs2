[label,player_special_attack]
// order of checks is from osrs
if (~npc_is_attackable() = false) {
    return;
}
if (~sa_enough_energy = false) {
    return;
}
// Quick Smash ignores the attack delay and adds none (pvm_specs_osrs.rs2)
if (inv_getobj(worn, ^wearpos_rhand) = granite_maul) {
    @pvm_granite_maul_sa;
}
if (%action_delay > map_clock) {
    p_opnpc(2);
    return;
}
if (npc_stat(hitpoints) = 0) {
    p_stopaction;
    return;
}
def_obj $weapon = inv_getobj(worn, ^wearpos_rhand);
%action_delay = add(map_clock, oc_param($weapon, attackrate));
p_opnpc(2);
// THE ORNAMENTED VERSIONS ARE LISTED BESIDE THEIR PLAIN ONES (DeathPlateau-Bugs#54, reported as
// "using orn kit on weps that has specs").
//
// An ornament kit turns an item into a DIFFERENT obj - dragon_scimitar becomes dragon_scimitar_or -
// and the ornamented obj correctly keeps param=specwep and param=sa_energy, so the special bar
// lights up and the click spends the energy. This switch is what decides what actually happens, and
// it named only the plain ids, so the five kitted spec weapons drained the bar and did nothing.
//
// Only five of the build's 26 ornament pairs are spec weapons, and all five were affected: the
// dragon scimitar and the four godswords. The other kits are armour and cosmetics.
 switch_obj($weapon) {
    case dragon_dagger, dragon_dagger_p, dragon_dagger_p+, dragon_dagger_p++ : @pvm_dragon_dagger_sa;
    case dragon_longsword : @pvm_dragon_longsword_sa;
    case dragon_mace : @pvm_dragon_mace_sa;
    case magic_shortbow, magic_shortbow_i : @pvm_magic_shortbow_sa;
    case magic_longbow : @pvm_magic_longbow_sa;
    case armadyl_crossbow : @pvm_armadyl_crossbow_sa;
    case rune_thrownaxe : @pvm_rune_thrownaxe_sa;
    case dragon_spear, dragon_spear_p, dragon_spear_p+, dragon_spear_p++, tbwt_dragon_spear_kp : @pvm_dragon_spear_sa;
    case abyssal_whip : @pvm_abyssal_whip_sa;
    case abyssal_tentacle : @pvm_abyssal_tentacle_sa;
    case arkan_blade : @pvm_arkan_blade_sa;
    case granite_hammer : @pvm_granite_hammer_sa;
    case dragon_warhammer : @pvm_dragon_warhammer_sa;
    case dragon_sword : @pvm_dragon_sword_sa;
    // The two Dorgeshuun specials, both of which cannot miss against a monster nobody has hurt
    // yet (skill_combat/scripts/player/specs/scripts/bone_weapons.rs2).
    case bone_dagger : @pvm_bone_dagger_sa;
    case dorgeshuun_crossbow : @pvm_dorgeshuun_crossbow_sa;
    case abyssal_bludgeon : @pvm_abyssal_bludgeon_sa;
    case rune_claws : @pvm_rune_claws_sa;
    case dragon_scimitar, dragon_scimitar_or : @pvm_dragon_scimitar_sa;
    case zamorakian_spear : @pvm_zamorakian_spear_sa;
    case dragon_halberd : @pvm_dragon_halberd_sa;
    case dragon_2h_sword : @pvm_dragon_2h_sword_sa;
    case armadyl_godsword, armadyl_godsword_or : @pvm_armadyl_godsword_sa;
    case bandos_godsword, bandos_godsword_or : @pvm_bandos_godsword_sa;
    case saradomin_godsword, saradomin_godsword_or : @pvm_saradomin_godsword_sa;
    case zamorak_godsword, zamorak_godsword_or : @pvm_zamorak_godsword_sa;
    case saradomin_sword : @pvm_saradomin_sword_sa;
    case toxic_blowpipe, toxic_blowpipe_empty : @pvm_blowpipe_sa; // toxic_blowpipe/scripts/blowpipe_combat.rs2
}
