[if_button,combat_spiked:specbar] @toggle_sa;
[if_button,combat_thrown:specbar] @toggle_sa;
[if_button,combat_spear:specbar] @toggle_sa;
[if_button,combat_heavysword:specbar] @toggle_sa;
[if_button,combat_pickaxe:specbar]
if (~duel_arena_spec_check = false) {
    return;
}
if (~sa_enough_energy = false) {
    return;
}
def_obj $weapon = inv_getobj(worn, ^wearpos_rhand);
if ($weapon = dragon_pickaxe) {
    // Rock Knocker (OSRS): +3 Mining
    if (p_finduid(uid) = true) {
        ~set_sa_vars(oc_param($weapon, sa_energy));
        say("Smashing!");
        // OSRS 7138. dragon_pickaxe_anim is 2661, the pickaxe's ordinary swing.
        anim(osrs_dpick_spec, 0);
        ~skilling_spec_boost(mining);
    }
    return;
}
@toggle_sa;

// +3 on top of the base level, and it does show past 99 (e.g. 102), as in OSRS. Success rolls
// still treat anything above 99 as 99 - the engine's stat_random clamps the level itself.
[proc,skilling_spec_boost](stat $stat)
stat_boost($stat, 3, 0);
// THE STAFF TAB'S BAR, which until now did not exist: 474's interface 90 draws one and
// portcombat474.py used to delete it, because no staff in 2008 had a special attack. The staff of
// the dead and the staff of light do - Power of Death and Power of Light - and like Excalibur and
// the two dragon tools above, theirs is not an attack: it takes no target and lands no hit, so it
// runs here on the click instead of going through player_special_attack.
// The two staves are on the BLADED tab - combat_staff_2.if relabelled, see
// player_attackstyles.rs2 - so that is where the click comes from. combat_staff_2's own bar stays
// wired to the same handler for the day a plain staff gets a special; until then its layer is
// hidden, because no weapon_staff obj carries specwep.
[if_button,combat_bladed_staff:specbar] @staff_specbar;
[if_button,combat_staff_2:specbar] @staff_specbar;

[label,staff_specbar]
if (~duel_arena_spec_check = false) {
    return;
}
if (~sa_enough_energy = false) {
    return;
}
// ~sotd_spec_weapon rather than a name test of its own: there are four of these staves now -
// the staff of the dead, the staff of light and the toxic staff charged and uncharged - and that
// proc is the one place the list lives (bosses/godwars/scripts/gwd_staves.rs2).
def_obj $weapon = inv_getobj(worn, ^wearpos_rhand);
if (~sotd_spec_weapon($weapon) = true) {
    if (p_finduid(uid) = true) { // as above: settings-shaped, so it does not queue
        @sotd_power_of_death; // bosses/godwars/scripts/gwd_staves.rs2
    }
    return;
}
// Any other staff has no special, so its bar is hidden and this cannot be reached - but if one
// ever does, it toggles like the rest.
@toggle_sa;

[if_button,combat_whip:specbar] @toggle_sa;
[if_button,combat_claw:specbar] @toggle_sa;
[if_button,combat_unarmed:specbar] @toggle_sa;
