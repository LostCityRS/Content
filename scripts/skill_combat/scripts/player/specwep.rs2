[proc,sa_enabled]()(boolean)
if (%sa_attack = ^true & oc_param(inv_getobj(worn, ^wearpos_rhand), specwep) = ^true & map_members = ^true) {
    return(true);
}
return(false);

[proc,sa_enough_energy]()(boolean)
if (%sa_energy < oc_param(inv_getobj(worn, ^wearpos_rhand), sa_energy)) {
    mes("You don't have enough power left.");
    %sa_attack = ^false;
    return(false);
}
return(true);

[proc,set_sa_vars](int $energy_used)
if (%sa_energy = ^sa_max_energy) {
    settimer(sa_regen, ^sa_regen_interval);
}
%sa_energy = max(sub(%sa_energy, $energy_used), 0);
%sa_attack = ^false;

[proc,sa_reset]
%sa_energy = ^sa_max_energy;
cleartimer(sa_regen);

[proc,sa_login]
if (%sa_energy < ^sa_max_energy) {
    settimer(sa_regen, ^sa_regen_interval);
}

// Special attack energy now restores while interfaces such as the bank are open.
// - https://oldschool.runescape.wiki/w/Update:Easter_%26_Slayer_Updates
[timer,sa_regen]
%sa_energy = min(add(%sa_energy, ^sa_regen_amount), ^sa_max_energy);
if (%sa_energy = ^sa_max_energy) {
    cleartimer(sa_regen);
}


// todo: queue if cannot access? or should sa_enabled be unprotected?
[label,toggle_sa]
if (%sa_attack = ^false) {
    %sa_attack = ^true;
} else {
    %sa_attack = ^false;
}

[if_button,combat_blunt:specbar] @toggle_sa;
[if_button,combat_axe:specbar]
// order is guessed (based off OSRS)
if (~duel_arena_spec_check = false) {
    return;
}
if (~sa_enough_energy = false) {
    return;
}
def_obj $weapon = inv_getobj(worn, ^wearpos_rhand);
if($weapon = dragon_battleaxe) {
    if(p_finduid(uid) = true) { // strongqueued in osrs, assuming its like settings stuff and doesnt queue
        ~set_sa_vars(oc_param($weapon, sa_energy));
        say("Raarrrrrgggggghhhhhhh!");
        anim(rampage, 0);
        spotanim_pl(sp_attackglow_red, 0, 0);
        def_int $drained_attack = calc(stat(attack) / 10);
        def_int $drained_defence = calc(stat(defence) / 10);
        def_int $drained_ranged = calc(stat(ranged) / 10);
        def_int $drained_magic = calc(stat(magic) / 10);
        def_int $sum = calc($drained_attack + $drained_defence + $drained_ranged + $drained_magic);
        sound_synth(rampage, 1, 0);
        stat_drain(attack, $drained_attack, 0);
        stat_drain(defence, $drained_defence, 0);
        stat_drain(ranged, $drained_ranged, 0);
        stat_drain(magic, $drained_magic, 0);
        stat_boost(strength, calc(10 + ($sum / 4)), 0);
    }
    return;
}
if ($weapon = dragon_axe) {
    // Lumber Up (OSRS): +3 Woodcutting
    if (p_finduid(uid) = true) {
        ~set_sa_vars(oc_param($weapon, sa_energy));
        say("Chop chop!");
        anim(dragon_smallaxe_anim, 0);
        spotanim_pl(dragon_smallaxe_swoosh_spotanim, 96, 0);
        ~skilling_spec_boost(woodcutting);
    }
    return;
}
@toggle_sa;

[if_button,combat_crossbow:specbar] @toggle_sa;
[if_button,combat_bow:specbar] @toggle_sa;
// The stab tab, which the dragon harpoon shares with the daggers. Fishstabber is a visible +3
// Fishing and lands no hit, so like Lumber Up, Rock Knocker, Excalibur and the two staves it runs
// here on the click instead of being armed for the next attack.
//
// THE CHECKS ARE INSIDE THE BRANCH, not above it as they are on the axe and pickaxe tabs, and the
// difference matters: those two tabs hold nothing but immediate specials, while this one also
// holds the dragon dagger, whose special IS an attack and has to be ARMED by @toggle_sa. Putting
// ~sa_enough_energy first would stop a dagger being armed at low energy, which is a change to the
// dagger and no part of adding a harpoon.
[if_button,combat_stabsword:specbar]
def_obj $weapon = inv_getobj(worn, ^wearpos_rhand);
if ($weapon = dragon_harpoon) {
    // Fishstabber (OSRS): +3 Fishing, for the whole bar.
    if (~duel_arena_spec_check = false) {
        return;
    }
    if (~sa_enough_energy = false) {
        return;
    }
    if (p_finduid(uid) = true) { // as the others: settings-shaped, so it does not queue
        ~set_sa_vars(oc_param($weapon, sa_energy));
        say("Here fishy fishies!");
        // NO ANIMATION, ON PURPOSE AND FOR NOW. Fishstabber's own animation is not in this build
        // and two attempts to supply one were both wrong in play, so rather than guess a third
        // time this plays none: the forced speech and the boost, and nothing that looks like
        // something else. Everything known about finding the real one is written down here so the
        // next attempt starts where this one stopped.
        //
        //   IT WAS human_sword_stab FIRST, which is the animation this harpoon ALREADY ATTACKS
        //   WITH (param=stabattack_anim) - so the special looked like an ordinary poke. That is
        //   the exact defect tools/sim/specanims.ts exists for; the tool specials were simply not
        //   in the table it checks, and they are now.
        //
        //   THEN IT WAS osrs_dpick_spec, on the reasoning that Old School registers ONE tool
        //   flourish under nine byte-identical seq ids (334, 3410, 7138, 7267, 8329, 8330, 8781,
        //   11821, 11822 - all frames 53-63 of group 10975, six cycles a frame) and the harpoon
        //   must be among them. It is not: the wiki's own captures settle it, because Rock
        //   Knocker is a hunched downward swing and Fishstabber is upright with the arms spread.
        //   Those nine are the axe and pickaxe family.
        //
        //   WHY IT CANNOT SIMPLY BE LOOKED UP: nothing in the OSRS cache links an item to its
        //   special attack - that mapping is server-side - and the wiki publishes the animation
        //   as a gif without an id. 7138 being known for the pickaxe is a note from an earlier
        //   session, not something the cache will tell you.
        //
        //   HOW TO FIND IT: tools/models/PlayerRender poses from loose .anim files, so it can
        //   draw animations this fork IMPORTED but none of the 377 originals, whose frames are
        //   packed (sanctuary has 0 of its 11 frames on disk). So convert candidate OSRS seqs
        //   into a scratch directory with animconvosrs.convert_seqs - no pack entries, nothing
        //   touched in the tree - render each with obj_dragon_harpoon_manwear in the weapon slot,
        //   and compare against the wiki's Fishstabber.gif. --dump gives posed face coordinates,
        //   so "arms spread" is measurable as the model's X-extent rather than judged by eye.
        ~skilling_spec_boost(fishing);
    }
    return;
}
@toggle_sa;

[if_button,combat_hacksword:specbar] 
if (~duel_arena_spec_check = false) {
    return;
}
if (~sa_enough_energy = false) {
    return;
}
def_obj $weapon = inv_getobj(worn, ^wearpos_rhand);
if($weapon = excalibur) {
    if(p_finduid(uid) = true) { // strongqueued in osrs, assuming its like settings stuff and doesnt queue
        ~set_sa_vars(oc_param($weapon, sa_energy));
        say("For Camelot!");
        anim(sanctuary, 0);
        spotanim_pl(sp_attackglow_blue, 0, 0);
