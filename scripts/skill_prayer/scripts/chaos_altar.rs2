// Offering bones at the Wilderness chaos altar - the Prayer training method, not the Pray-at that
// every altar already has (altar.rs2). https://oldschool.runescape.wiki/w/Chaos_altar_(Prayer)
//
// 3.5x the bone's own experience, and "there is a 50% chance that the bone offered will not be
// consumed". A saved bone stays in the pack and is offered again by the loop below, which is the
// wiki's "can continue to roll ... until the roll fails" - and why the average works out at seven
// times burying rather than three and a half.
//
// Keyed to the tile (^chaos_altar_coord), not the loc: this build has five [chaosaltar] locs and
// only the one in the hut at level 38 is the training altar. The others, the level 12 church
// included, stay plain Pray-at altars, as they are in Old School.

[oplocu,chaosaltar]
if (loc_coord ! ^chaos_altar_coord) {
    ~displaymessage(^dm_default);
    return;
}
if (oc_category(last_useitem) ! bones) {
    ~displaymessage(^dm_default);
    return;
}
if (oc_param(last_useitem, bone_exp) <= 0) {
    ~displaymessage(^dm_default);
    return;
}
@chaos_altar_offer;

// The repeat. p_oploc(3) below re-queues through this, and nothing else reaches it: the altar
// declares no op3 and the right-click menu has no entry for it.
[oploc3,chaosaltar]
if (loc_coord ! ^chaos_altar_coord) {
    return;
}
@chaos_altar_offer;

// ONE OFFERING PER CALL, PACED BY map_clock, AND NEVER p_delay. This was a `while` loop with a
// p_delay(2) in it, and its comment claimed the delay yielded so that walking away or clicking
// something else would end it. p_delay does not yield that way: it sets player.delayed, and both
// MoveClickHandler and OpLocHandler THROW AWAY the player's input while that is set. So the loop
// ran to the bottom of the pack with every click and every step discarded, which is what was
// reported - "cant be stopped until invo is empty" (DeathPlateau-Bugs#39).
//
// This is the chaos altar, so the lockout is not merely annoying: it is the single most PKed
// training spot in the game, and a player part way through a pack could not eat, pray, or run.
//
// The shape is farming's rake (skill_farming/scripts/farming_useitem.rs2), which carries the same
// warning in its own comment, and ordinary woodcutting uses the same map_clock idiom. The script
// returns every pass, so the player is never delayed and their next click wins.
[label,chaos_altar_offer]
def_obj $bone = ~chaos_altar_next_bone;
if ($bone = null) {
    anim(null, 0);
    return;
}
if (%action_delay > map_clock) {
    p_oploc(3);
    return;
}
%action_delay = calc(map_clock + ^chaos_altar_offer_ticks);
anim(human_pray, 0);
sound_synth(bones_down, 1, 0);
// THE EXPERIENCE IS PAID EITHER WAY, as it is when Zealot's robes save a buried bone
// (bury_bone.rs2) - the saving is a bonus on top, not a refund of the offering.
~prayer_xp(calc(oc_param($bone, bone_exp) * ^chaos_altar_xp_num / ^chaos_altar_xp_den));
// TWO ROLLS, IN THIS ORDER, and the order is the published one. Zealot's robes were not consulted
// here at all, so the set did nothing at the altar it is most used at (DeathPlateau-Bugs#95). The
// wiki is explicit about how the two stack, quoting Mod Ash: "If you FAIL that 50% roll, you get a
// roll for the robes to save the bones" - which is 52.5% with the full set, not 55%, because the
// robes only see the bones the altar has already decided to take.
if (random(^chaos_altar_save_chance) = 0) {
    mes("The gods are pleased with your offering, and return the bones to you.");
} else if (~zealots_saves = true) {
    // Same wording as burying, which is the only other place this set speaks (bury_bone.rs2). The
    // wiki records the effect and no message for it, so the message is ours and is kept identical
    // rather than invented twice.
    mes("Your robes preserve the bones.");
} else {
    inv_del(inv, $bone, 1);
    mes("You offer the bones to Zamorak.");
}
if (~chaos_altar_next_bone ! null) {
    p_oploc(3);
    return;
}
anim(null, 0);

// The next bone to offer: the first one in the pack, in slot order.
//
// IT IS NOT THE BONE THAT WAS CLICKED, and that is a change. The old loop offered only the type
// handed to it, because it had last_useitem to hold on to; op3 has no useitem, so a repeat has to
// either carry the type in a varp or read the pack. Reading the pack is what Old School does -
// the altar consumes bones in inventory order - and it means a mixed pack is worked through
// rather than stopping when one kind runs out. Flagged on the pull request as the one behaviour
// change here.
[proc,chaos_altar_next_bone]()(obj)
def_int $slot = 0;
while ($slot < inv_size(inv)) {
    def_obj $candidate = inv_getobj(inv, $slot);
    if ($candidate ! null) {
        if (oc_category($candidate) = bones) {
            if (oc_param($candidate, bone_exp) > 0) {
                return($candidate);
            }
        }
    }
    $slot = add($slot, 1);
}
return(null);
