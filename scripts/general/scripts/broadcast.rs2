// SERVER-WIDE ANNOUNCEMENTS: rare drops, pets, capes, and ::yell. Every line that goes to every
// player's chatbox is built here, so they all look like one thing.
//
// It was fourteen copies of broadcast_mes(append(append(displayname(), " received a rare drop: "),
// oc_name($drop))) in fourteen files - plain black text, indistinguishable from "You catch a
// shrimp", with no crown on a staff member and no way to tell a Realism drop from a 10x one. Now a
// drop table says ~broadcast_drop($drop) and this file decides what that looks like.
//
// HOW A LINE LOOKS:
//     [Rare drop!]  <crown><badge>Name  received  Abyssal whip.
//      gold, shadowed   dark blue             dark red
// The chatbox is parchment, and only black, dark blue and dark red read on it - every bright colour
// is under 2.5:1 against it. So the name and the item are the two readable colours, and the label is
// bright but SHADOWED (@sh1@ ... @sh0@), which is what makes it the thing the eye lands on without
// being the thing that is hard to read. The client side of this is jagex2/client/ChatIcons.java.
//
// THE ICONS are markers the client swaps for sprites from mod_icons: @cr1@ the silver crown and
// @cr2@ the gold one, as public chat already used them, then @cr3@ @cr4@ @cr5@ for the Realism, 5x
// and 10x badges, @cr6@ the purple crown for a developer, @cr7@ the red one for the owner and @cr8@ the blue and gold one for
// a second owner. The badge is this server's answer to
// OSRS's ironman helmets on a broadcast: the same drop means more on Realism, and now everyone can
// see which it was.

// The crown for a staff member, the badge for their XP mode, and the name.
//
// The crown is the one this player's name carries in public and private chat - engine
// ChatCrown.chatCrown: 1 the silver crown, 2 and 3 the gold, 4 the purple developer crown, 5 the red
// owner's crown, 6 and up the blue and gold owner's crown -
// so a broadcast never shows a different rank from the player's own chat lines. (::yell used to give
// mod level 2 the silver crown while their chat showed gold.)
//
// The mode comes from ~xprate_current, not %xp_rate: gamemodes/ is the only place that reads the
// varp (gamemode_battery holds it to that, so no skill can multiply xp on top of the engine), and
// the proc already answers Realism for a character who was never asked - the rate the engine plays
// them at, so the badge that tells the truth about them.
[proc,broadcast_name]()(string)
// ONE RANK ICON, FROM THE ENGINE'S OWN CHOICE OF IT. This used to read staffmodlevel and rebuild
// the ladder here, which worked for the staff crowns and could not reach the other two ranks at
// all: Veteran and Helper are flags on the account rather than staff levels, so no comparison
// against staffmodlevel finds them, and a veteran's yell and a veteran's rare drop went out with
// the XP badge and nothing else while the same player's icon showed perfectly well over their head
// and on their public chat - because those come from the appearance block, which does know.
//
// chatcrown is that same number: whatever ChatCrown.ts picked for this player, including the ones
// this file cannot see. The switch below only turns a number into a marker, so a rank added later
// needs a line here and nowhere else, and a broadcast can no longer disagree with a chat line
// about who somebody is.
//
// 7 and 8 are NOT above 6 in rank - the low nibble is a set of icon ids, not a ladder - so they
// are matched exactly, the same fencing the client's ChatIcons.forPlayer uses and for the same
// reason: a veteran must not fall through into the second owner's crown.
def_string $icons = "";
switch_int (chatcrown) {
    case 8 : $icons = "@cra@";   // helper, blue roundel
    case 7 : $icons = "@cr9@";   // veteran, grey emblem - gunmetal since 2026-11-11, matching the cape
    case 6 : $icons = "@cr8@";   // second owner
    case 5 : $icons = "@cr7@";   // owner
    case 4 : $icons = "@cr6@";   // developer
    case 2 : $icons = "@cr2@";   // gold crown
    case 1 : $icons = "@cr1@";   // silver crown
}
switch_int (~xprate_current) {
    case ^xprate_10x : $icons = append($icons, "@cr5@");
    case ^xprate_5x : $icons = append($icons, "@cr4@");
    case default : $icons = append($icons, "@cr3@");
}
return("<$icons>@dbl@<displayname>@bla@");

// The one shape every announcement shares: a shadowed gold label, then who, then what happened.
//
// NOTHING GOES OUT WHILE %broadcast_suppressed IS SET. That is ::~droptest, which spawns npcs and
// really kills them - the drops run the real death scripts, so without this a dev asking "how
// often does the King Black Dragon drop a dragon pickaxe" over a hundred kills sent a hundred real
// "[Rare drop!]" lines to everybody on the world, each one naming a drop nobody got.
//
// THE GATE IS HERE AND NOT IN ~broadcast_drop so a broadcast added later is covered without
// anybody remembering this existed. It deliberately does not cover ~yell or ~broadcast_staff: they
// go through broadcast_mes directly, and a staff member running a drop test should still be able
// to talk to the world. Milestones have their own answer - a drop test marks the account
// (general/scripts/milestones.rs2), which is permanent, because the collection log pages those
// kills fill are real.
[proc,broadcast_news](string $label, string $what)
if (%broadcast_suppressed ! 0) {
    return;
}
broadcast_mes("@sh1@@or1@<$label>@sh0@@bla@ <~broadcast_name> <$what>");

// A milestone - a 99, a total level, a max cape, a server first. Same shape as the news above, but
// sent with broadcast_milestone rather than broadcast_mes: these are the one kind of announcement a
// player can turn off (::milestones), and the opt-out is a varp on each RECEIVER, which only the
// engine can read for every player on the world. The label colour is the difference a player sees -
// gold is the rare drops and the pets, green is somebody's own achievement.
[proc,broadcast_milestone_news](string $label, string $what)
broadcast_milestone("@sh1@@gre@<$label>@sh0@@bla@ <~broadcast_name> <$what>");

// A rare drop. The item is in dark red so it reads as the point of the line.
[proc,broadcast_drop](obj $drop)
~broadcast_news("Rare drop!", "received @dre@<oc_name($drop)>@bla@.");
// Every broadcast rare is one the collection log wants, and this is the one place they all pass -
// see collection_log/scripts/collection_log.rs2. Anything the log does not list is ignored there.
~collection_log_add($drop, 1);

// A pet. Every pet announces itself the same way whether it came from a boss, a skill or a cave.
[proc,broadcast_pet](obj $pet)
~broadcast_news("Pet!", "has a funny feeling like they're being followed: @dre@<oc_name($pet)>@bla@.");
// And every pet, boss or skilling, for the log's All Pets page.
~collection_log_add($pet, 1);

// ::yell. The engine has already checked the mute and the length and sent every '@' in the text as
// ChatText.LITERAL_AT (Engine-TS src/wordenc/ChatText.ts), which the client draws as '@' but never
// reads as a tag, so a yell shows "@cr2@" as typed and cannot forge a crown or a colour; the label is
// cyan to tell it apart from the gold of the news at a glance.
[proc,yell](string $text)
broadcast_mes("@sh1@@cya@[Yell]@sh0@@bla@ <~broadcast_name>: <$text>");

// ::broadcast, a staff announcement (engine ClientCheatHandler, rank 4 and up). The loudest of the
// set - shadowed red - because it is the one line that should never be scrolled past. Unlike a yell
// the text keeps its @col@ tags: only staff can send one, and colouring part of it is the point.
[proc,broadcast_staff](string $text)
broadcast_mes("@sh1@@red@[Announcement]@sh0@@bla@ <~broadcast_name>: <$text>");
