// MILESTONE ANNOUNCEMENTS: the lines that tell the world somebody got somewhere.
//
// The server already announces things that FALL to a player - rare drops, pets, the Fire cape, the
// Amulet of eternal glory. This is the other half: the things a player works towards. Every line
// here goes out through ~broadcast_milestone_news (general/scripts/broadcast.rs2), which is the
// only kind of broadcast a player can turn off, with ::milestones.
//
// WHAT IS ANNOUNCED, and why these and not every level:
//
//   every 99          at most 23 per account, ever. The XP curve is the reason the obvious
//                     "every 25 levels" is not here: level 25 is minutes of play and 99 is 13
//                     million experience, so a 25/50/75 ladder is 92 lines per account, almost all
//                     of them for the least impressive half of the climb, and the noise would land
//                     hardest on a new world full of new accounts.
//   total level       1000, 1500, 2000 and 2277. Breadth rather than one skill, and about four
//                     lines per account across its whole life.
//   max cape          all 23 capes. Falls out of the 99 above - no extra pass over the stats.
//   every quest       all of them, by quest points, from ~send_quest_complete.
//   combat 126        the ceiling, announced once.
//   50m/100m/150m/    the only milestones ABOVE 99 this build can have. 99 is 13 million
//   200m XP           experience, so these are the four rungs of the long tail after it, and 200m
//                     is the engine's own cap - there is no more experience to earn in that skill.
//                     Rare enough that an account that reaches one has played for months.
//   collection log    a page completed, and the whole log. The log is the one record of what a
//                     player has actually hunted down, and page completion was previously worth a
//                     single private line.
//   SERVER FIRSTS     "first to 99 Fishing" fires 23 times in this world's entire life, and the
//                     same for the other milestones above. They are the cheapest prestige there
//                     is: the engine's milestone_first settles the claim in the database, so two
//                     players levelling on the same tick cannot both be told they were first.
//
// All XP rates are treated alike. A 10x account reaches 99 sooner, and the broadcast carries that
// player's XP badge (~broadcast_name) so everybody can see which it was.

// ---------------------------------------------------------------------------- thresholds
// Total-level milestones, in order. ~milestone_total walks these, so adding one is a line here.
[proc,milestone_total_steps](int $n)(int)
switch_int ($n) {
    case 1 : return(1000);
    case 2 : return(1500);
    case 3 : return(2000);
    case 4 : return(2277);
}
return(0);

// ---------------------------------------------------------------------------- the hooks
// Every level-up, from [label,levelup] in levelup/scripts/levelup.rs2.
[proc,milestone_levelup](stat $stat)
if (stat_base($stat) = 99) {
    ~milestone_99($stat);
}
~milestone_total;
~milestone_combat;

// A 99, and the max cape when it is the last one.
//
// EXACTLY 99 AND NOT 99-OR-MORE: stat_base stops at 99 and never falls, so this level-up is the
// only one that will ever see it become 99. That is what keeps the 99 and the max cape from
// needing a mark varp of their own, unlike total level and combat.
[proc,milestone_99](stat $stat)
def_string $skill = enum(stat, string, stat_names, $stat);
if (milestone_first("99:<$skill>") = true) {
    ~broadcast_milestone_news("[Server first!]", "is the first to reach level @dre@99 <$skill>@bla@.");
} else {
    ~broadcast_milestone_news("[Milestone]", "has reached level @dre@99 <$skill>@bla@.");
}

// The max cape is every caped skill at 99. ~skillcape_count_99s and ~skillcape_stats are the
// skillcape shop's own counters, so a skill gaining or losing a cape moves both together.
if (~skillcape_count_99s = ~skillcape_stats) {
    if (milestone_first("maxcape") = true) {
        ~broadcast_milestone_news("[Server first!]", "is the first to master every skill. @dre@Max cape@bla@!");
    } else {
        ~broadcast_milestone_news("[Milestone]", "has mastered every skill. @dre@Max cape@bla@!");
    }
}

// Total level. Marked rather than compared exactly, because one advance can carry a player past a
// threshold without ever standing on it.
[proc,milestone_total]
def_int $total = ~milestone_total_level;
def_int $n = 1;
while (~milestone_total_steps($n) > 0) {
    def_int $step = ~milestone_total_steps($n);
    if ($total >= $step & %milestone_total_mark < $step) {
        %milestone_total_mark = $step;
        if (milestone_first("total:<tostring($step)>") = true) {
            ~broadcast_milestone_news("[Server first!]", "is the first to reach @dre@<tostring($step)> total level@bla@.");
        } else {
            ~broadcast_milestone_news("[Milestone]", "has reached @dre@<tostring($step)> total level@bla@.");
        }
    }
    $n = add($n, 1);
}

// Combat 126, the ceiling. Marked for the same reason as the total.
[proc,milestone_combat]
if (%milestone_combat_mark ! 0) {
    return;
}
if (~player_combat_level < 126) {
    return;
}
%milestone_combat_mark = 1;
if (milestone_first("combat:126") = true) {
    ~broadcast_milestone_news("[Server first!]", "is the first to reach @dre@combat level 126@bla@.");
} else {
    ~broadcast_milestone_news("[Milestone]", "has reached @dre@combat level 126@bla@.");
}

// Every quest, from ~send_quest_complete - so it is asked once per quest completed and nowhere
// else. ~count_questpoints and ~max_questpoints are the quest list's own, which is what keeps this
// true as quests are added rather than counting to a number written down here.
[proc,milestone_quests]
if (~count_questpoints < ~max_questpoints) {
    return;
}
if (milestone_first("quests:all") = true) {
    ~broadcast_milestone_news("[Server first!]", "is the first to complete @dre@every quest@bla@.");
} else {
    ~broadcast_milestone_news("[Milestone]", "has completed @dre@every quest@bla@.");
}

// A NEW PLAYER, announced on the first login AFTER THE TUTORIAL rather than on the first login at
// all. Two reasons, and the second is the important one:
//
//   * "has arrived" is true of somebody who finished the tutorial and is standing in Lumbridge. It
//     is not true of an account that was created and never left the island.
//   * an announcement on account creation can be farmed. Anybody can make accounts, and a line to
//     every player on the world per account is a spam channel. The tutorial is half an hour of
//     work, which is not a wall but is enough that nobody does it a hundred times for a joke.
//
// Marked on the account, so it is one line per player ever - not one per login.
[proc,milestone_welcome]
if (%milestone_welcomed ! 0) {
    return;
}
if (%tutorial < ^tutorial_complete) {
    return;
}
%milestone_welcomed = 1;
~broadcast_milestone_news("[New player]", "has arrived on Death Plateau. Say hello!");

// The sum of every skill's base level. There was no total-level proc before this.
[proc,milestone_total_level]()(int)
def_int $total = 0;
def_int $i = 1;
while ($i <= enum_getoutputcount(stats)) {
    $total = add($total, stat_base(enum(int, stat, stats, $i)));
    $i = add($i, 1);
}
return($total);

// ---------------------------------------------------------------------------- experience tiers
// 50m, 100m, 150m and 200m experience in ONE skill, from the engine (Player.addXp).
//
// WHY THE ENGINE AND NOT A HOOK HERE. Every other milestone in this file hangs off a level-up, and
// a skill at 99 never changes level again - [advancestat] and [changestat] both fire on a level
// change, so past 99 there is no content-side hook left to hang anything on. The alternative was a
// softtimer walking all 23 skills every minute for every player on the world, forever, to catch
// four events in an account's lifetime. addXp already has the number in its hand.
//
// The thresholds live in the engine beside the cap rather than in a constant here: experience is
// stored x10 (200m is addXp's 2,000,000,000 clamp), and a content copy would have to repeat the x10
// and could drift from the cap it is supposed to name.
//
// $tier is 0-3 for 50m/100m/150m/200m. The engine sends only the HIGHEST tier a single gain
// crosses, so nothing can fire four lines at once.
[proc,milestone_xp](stat $stat, int $tier)
def_string $skill = enum(stat, string, stat_names, $stat);
def_string $amount = "";
switch_int ($tier) {
    case 0 : $amount = "50m";
    case 1 : $amount = "100m";
    case 2 : $amount = "150m";
    case 3 : $amount = "200m";
    case default : return;
}
// "200m Woodcutting XP" and not "200 million Woodcutting experience" because of the chatbox: a
// broadcast is wrapped at 456 pixels (Player.wrappedMessageGame), and the spelled-out version runs
// to 575 with a long name and a long skill - it would arrive as two lines, the second one starting
// mid-sentence. Every shipped broadcast in this build fits on one line and these do too; the test
// in tools/sim/milestones.ts measures every one of them so that stays true.
if (milestone_first("xp:<$amount>:<$skill>") = true) {
    ~broadcast_milestone_news("[Server first!]", "is the first to earn @dre@<$amount> <$skill> XP@bla@.");
} else {
    ~broadcast_milestone_news("[Milestone]", "has earned @dre@<$amount> <$skill> XP@bla@.");
}

// ---------------------------------------------------------------------------- collection log
// A COLLECTION LOG PAGE COMPLETED, and the whole log. From ~collection_log_add
// (collection_log/scripts/collection_log.rs2), the moment an item is logged for the FIRST time.
//
// WHY THAT CALL SITE IS THE WHOLE GUARD. A page goes from incomplete to complete on exactly one
// item, ever, and ~collection_log_add only reaches here when the item was not already in the log.
// So there is no mark varp and no reward bit: the transition is the guard. That matters, because
// the reward table cannot carry these at all - its paid-flags are bits of one varp, 32 of them for
// the whole system (tools/gencollectionlog.py refuses a 33rd), and there are 36 pages.
//
// IT ANNOUNCES NOTHING RETROACTIVELY, which is the behaviour we want. A player who was already
// complete when a page was added never logs a new item on it, so the test never fires for them -
// and a page finished last month is not news. The private "You have completed the entire
// collection log!" reward line (the spec's `complete` row) is untouched and still pays once to
// anybody who was past it, including on opening the log.
[proc,milestone_collection](namedobj $item)
// The pages. No db_find inside this loop - it is walking a db_listall and a find would replace the
// list underneath it, which is the same rule ~collection_log_rewards is written to; everything
// called from in here reads fields only.
def_int $rows = db_listall_with_count(collection_log_entry);
def_int $i = 0;
while ($i < $rows) {
    def_dbrow $entry = db_findbyindex($i);
    def_int $total = db_getfieldcount($entry, collection_log_entry:items);
    if ($total >= ^milestone_clog_page_min) {
        if (~collection_log_entry_has($entry, $item) = true) {
            if (~collection_log_entry_obtained($entry) = $total) {
                def_string $page = db_getfield($entry, collection_log_entry:name, 0);
                // "filled", and the same verb under both labels, for the 456-pixel line: a page
                // name is up to 22 characters ("Medium Treasure Trails") and "is the first to
                // complete the ... collection log" wraps for 27 of the 31 pages. The label already
                // says which of the two this is, so the sentence does not have to.
                if (milestone_first("clog:<$page>") = true) {
                    ~broadcast_milestone_news("[Server first!]", "filled the @dre@<$page>@bla@ collection log.");
                } else {
                    ~broadcast_milestone_news("[Milestone]", "filled the @dre@<$page>@bla@ collection log.");
                }
            }
        }
    }
    $i = add($i, 1);
}
// And the log itself. Counted from the item list rather than from used slots, the same way the
// window's own "X/Y" is, so an item that leaves the log stops counting instead of leaving this
// permanently true.
if (~collection_log_obtained_total = enum_getoutputcount(collection_log_items)) {
    if (milestone_first("clog:all") = true) {
        ~broadcast_milestone_news("[Server first!]", "completed the @dre@entire collection log@bla@!");
    } else {
        ~broadcast_milestone_news("[Milestone]", "completed the @dre@entire collection log@bla@!");
    }
}
