// FOUR LAMPS, ONE INTERFACE, FOUR DIFFERENT AWARDS. They are all here together on purpose: the
// bug this shape replaces was two of them living in other files and not setting the kind at all,
// so whichever kind the last lamp left behind was the one they paid.
//
//   genie            the skill's own level x 10, any skill          (random event)
//   blessed          flat 5,000, skill at level 30                  (The Great Brain Robbery)
//   antique (RFD)    flat 20,000, skill at level 50                 (Recipe for Disaster)
//   antique (cats)   flat 2,500, skill at level 30                  (A Tail of Two Cats, x2)
//
// Adding a fifth means a kind, a row in xplamp.constant and a branch in ~xplamp_confirm. Leaving
// any of the three out is what this comment exists to prevent.
[opheld1,macro_genilamp]
%xplamp = ^xplamp_none;
%xplamp_kind = ^xplamp_lamp_genie;
if_openmain(xplamp);

// The Great Brain Robbery's blessed lamp is NOT a genie lamp. Old School's grants a flat 5,000
// experience in one skill the player already has level 30 in, where the genie lamp scales with the
// skill's own level, so the two cannot share a payout - only the interface.
[opheld1,tgbr_blessed_lamp]
%xplamp = ^xplamp_none;
%xplamp_kind = ^xplamp_lamp_blessed;
if_openmain(xplamp);

// Recipe for Disaster's antique lamp. Its [opheld1] used to sit in general_use's generated
// item_ops file, where it opened this interface without saying which lamp it was - so the finale's
// 20,000 paid out as a genie lamp's level x 10, which is 990 experience at level 99.
[opheld1,hundred_rewardlamp]
%xplamp = ^xplamp_none;
%xplamp_kind = ^xplamp_lamp_rfd;
if_openmain(xplamp);

// A Tail of Two Cats' antique lamps, two of them, 2,500 each. Same story as the one above: its
// trigger was in the quest's own file and named no kind.
[opheld1,twocats_rewardlamp]
%xplamp = ^xplamp_none;
%xplamp_kind = ^xplamp_lamp_twocats;
if_openmain(xplamp);

// One Small Favour's antique lamps, two of them, 10,000 each. thosf_reward_lamp has been in
// the cache since the quest was imported and nothing rubbed it: the quest paid fixed Crafting
// and Smithing instead, so the one reward the player was supposed to choose was chosen for
// them and the lamp sat unused.
[opheld1,thosf_reward_lamp]
%xplamp = ^xplamp_none;
%xplamp_kind = ^xplamp_lamp_osf;
if_openmain(xplamp);

[if_button,xplamp:attack] @xplamp_select(attack);
[if_button,xplamp:strength] @xplamp_select(strength);
[if_button,xplamp:ranged] @xplamp_select(ranged);
[if_button,xplamp:magic] @xplamp_select(magic);
[if_button,xplamp:defence] @xplamp_select(defence);
[if_button,xplamp:hitpoints] @xplamp_select(hitpoints);
[if_button,xplamp:prayer] @xplamp_select(prayer);
[if_button,xplamp:agility] @xplamp_select(agility);
[if_button,xplamp:herblore] @xplamp_select(herblore);
[if_button,xplamp:thieving] @xplamp_select(thieving);
[if_button,xplamp:crafting] @xplamp_select(crafting);
[if_button,xplamp:runecraft] @xplamp_select(runecraft);
[if_button,xplamp:mining] @xplamp_select(mining);
[if_button,xplamp:smithing] @xplamp_select(smithing);
[if_button,xplamp:fishing] @xplamp_select(fishing);
[if_button,xplamp:cooking] @xplamp_select(cooking);
[if_button,xplamp:firemaking] @xplamp_select(firemaking);
[if_button,xplamp:woodcutting] @xplamp_select(woodcutting);
[if_button,xplamp:fletching] @xplamp_select(fletching);
[if_button,xplamp:slayer] @xplamp_select(slayer);
[if_button,xplamp:farming] @xplamp_select(farming);
[if_button,xplamp:construction] @xplamp_select(construction);
[if_button,xplamp:hunter] @xplamp_select(hunter);

[if_button,xplamp:confirm]
switch_int (%xplamp) {
    case ^xplamp_none :
        mes("You need to choose which skill you wish to be advanced.");
        return;
    case ^xplamp_attack : @xplamp_confirm(attack);
    case ^xplamp_strength : @xplamp_confirm(strength);
    case ^xplamp_ranged : @xplamp_confirm(ranged);
    case ^xplamp_magic : @xplamp_confirm(magic);
    case ^xplamp_defence : @xplamp_confirm(defence);
    case ^xplamp_hitpoints : @xplamp_confirm(hitpoints);
    case ^xplamp_prayer : @xplamp_confirm(prayer);
    case ^xplamp_agility : @xplamp_confirm(agility);
    case ^xplamp_herblore : @xplamp_confirm(herblore);
    case ^xplamp_thieving : @xplamp_confirm(thieving);
    case ^xplamp_crafting : @xplamp_confirm(crafting);
    case ^xplamp_runecraft : @xplamp_confirm(runecraft);
    case ^xplamp_mining : @xplamp_confirm(mining);
    case ^xplamp_smithing : @xplamp_confirm(smithing);
    case ^xplamp_fishing : @xplamp_confirm(fishing);
    case ^xplamp_cooking : @xplamp_confirm(cooking);
    case ^xplamp_firemaking : @xplamp_confirm(firemaking);
    case ^xplamp_woodcutting : @xplamp_confirm(woodcutting);
    case ^xplamp_fletching : @xplamp_confirm(fletching);
    case ^xplamp_slayer : @xplamp_confirm(slayer);
    case ^xplamp_farming : @xplamp_confirm(farming);
    case ^xplamp_construction : @xplamp_confirm(construction);
    case ^xplamp_hunter : @xplamp_confirm(hunter);
}
error("case not found for xplamp varp: <tostring(%xplamp)>");

[label,xplamp_select](stat $stat)
if (map_members = ^false & ~stat_members($stat) = ^true) {
    mes("You need to be on a members' world to gain experience in <~stat_name($stat)>.");
    %xplamp = ^xplamp_none;
    return;
}
switch_stat ($stat) {
    case attack : @xplamp_select_stat(^xplamp_attack);
    case strength : @xplamp_select_stat(^xplamp_strength);
    case ranged : @xplamp_select_stat(^xplamp_ranged);
    case magic : @xplamp_select_stat(^xplamp_magic);
    case defence : @xplamp_select_stat(^xplamp_defence);
    case hitpoints : @xplamp_select_stat(^xplamp_hitpoints);
    case prayer : @xplamp_select_stat(^xplamp_prayer);
    case agility : @xplamp_select_stat(^xplamp_agility);
    case herblore : @xplamp_select_stat(^xplamp_herblore);
    case thieving : @xplamp_select_stat(^xplamp_thieving);
    case crafting : @xplamp_select_stat(^xplamp_crafting);
    case runecraft : @xplamp_select_stat(^xplamp_runecraft);
    case mining : @xplamp_select_stat(^xplamp_mining);
    case smithing : @xplamp_select_stat(^xplamp_smithing);
    case fishing : @xplamp_select_stat(^xplamp_fishing);
    case cooking : @xplamp_select_stat(^xplamp_cooking);
    case firemaking : @xplamp_select_stat(^xplamp_firemaking);
    case woodcutting : @xplamp_select_stat(^xplamp_woodcutting);
    case fletching : @xplamp_select_stat(^xplamp_fletching);
    case slayer : @xplamp_select_stat(^xplamp_slayer);
    case farming : @xplamp_select_stat(^xplamp_farming);
    case construction : @xplamp_select_stat(^xplamp_construction);
    case hunter : @xplamp_select_stat(^xplamp_hunter);
}
error("case not found for stat: <enum(stat, string, stat_names, $stat)>");

[label,xplamp_select_stat](int $selection)
switch_int ($selection) {
    case ^xplamp_herblore :
        if (%druidquest ! ^druid_complete) {
            %xplamp = ^xplamp_none;
            mes("You need to complete the Druidic Ritual quest to choose that option.");
            return;
        }
    case ^xplamp_runecraft :
        if (%runemysteries ! ^runemysteries_complete) {
            %xplamp = ^xplamp_none;
            mes("You need to complete the Rune Mysteries quest to choose that option.");
            return;
        }
}
%xplamp = $selection;

[label,xplamp_confirm](stat $stat)
// sanity check
if (map_members = ^false & ~stat_members($stat) = ^true) {
    mes("You need to be on a members' world to gain experience in <~stat_name($stat)>.");
    %xplamp = ^xplamp_none;
    return;
}

// THE LEVEL READ BEFORE ANYTHING IS GRANTED, because the genie lamp's award is the skill's own
// level and granting it first would pay out against the level the grant itself produced.
def_int $base = stat_base($stat);
def_int $kind = %xplamp_kind;
def_int $need = 0;
def_int $xp = multiply($base, 100); // the genie lamp: level x 10, in tenths
if ($kind = ^xplamp_lamp_blessed) {
    $need = ^tgbr_lamp_level;
    $xp = ^tgbr_lamp_xp;
} else if ($kind = ^xplamp_lamp_rfd) {
    $need = ^xplamp_rfd_level;
    $xp = ^xplamp_rfd_xp;
} else if ($kind = ^xplamp_lamp_twocats) {
    $need = ^xplamp_twocats_level;
    $xp = ^xplamp_twocats_xp;
} else if ($kind = ^xplamp_lamp_osf) {
    $need = ^xplamp_osf_level;
    $xp = ^xplamp_osf_xp;
}

if ($need > 0 & $base < $need) {
    mes("The lamp will only answer for a skill you are already level <tostring($need)> in.");
    return;
}
if_close;
~xplamp_consume($kind);
%xplamp = ^xplamp_none;
%xplamp_kind = ^xplamp_lamp_genie;
stat_advance($stat, $xp);
sound_synth(found_gem, 1, 0);

if ($kind = ^xplamp_lamp_genie) {
    ~mesbox("Your wish has been granted!|You have been awarded <tostring(multiply($base, 10))> <enum(stat, string, stat_names, $stat)> experience!");
} else if ($kind = ^xplamp_lamp_blessed) {
    ~mesbox("The lamp goes out.|You have been awarded 5,000 <enum(stat, string, stat_names, $stat)> experience!");
} else if ($kind = ^xplamp_lamp_rfd) {
    ~mesbox("The lamp goes out.|You have been awarded 20,000 <enum(stat, string, stat_names, $stat)> experience!");
} else if ($kind = ^xplamp_lamp_osf) {
    ~mesbox("The lamp goes out.|You have been awarded 10,000 <enum(stat, string, stat_names, $stat)> experience!");
} else {
    ~mesbox("The lamp goes out.|You have been awarded 2,500 <enum(stat, string, stat_names, $stat)> experience!");
}

// TAKE THE LAMP THAT WAS RUBBED. This used to scan the inventory in a fixed order and delete the
// first lamp it found, which was defended on the grounds that "the two grant identical experience,
// so the only visible difference is which icon leaves the inventory". They do not grant identical
// experience - 20,000 against 5,000 against 2,500 - so a player holding two lamps and rubbing the
// better one would have lost the other and been paid for it.
[proc,xplamp_consume](int $kind)
if ($kind = ^xplamp_lamp_blessed) {
    inv_del(inv, tgbr_blessed_lamp, 1);
    return;
}
if ($kind = ^xplamp_lamp_rfd) {
    inv_del(inv, hundred_rewardlamp, 1);
    return;
}
if ($kind = ^xplamp_lamp_twocats) {
    inv_del(inv, twocats_rewardlamp, 1);
    return;
}
if ($kind = ^xplamp_lamp_osf) {
    inv_del(inv, thosf_reward_lamp, 1);
    return;
}
inv_del(inv, macro_genilamp, 1);
