// Spinning wheel (Corey, 2026-09-05).
//
// The wheel's own loc def has carried op2=Spin since the 377 cache and nothing handled it, so the
// only way to use one was to drag wool or flax onto it, one item at a time. It now opens the real
// "What would you like to make?" panel with Make X / 10 / 5 / 1.
//
// That panel needed a fix of its own first. skillmulti2..5 in interface_chat/scripts/chat.rs2 had
// their whole switch_component written but never registered any resume buttons, so p_pausebutton
// had nothing to wake it - which is what the "only skillmulti1 works for now" comment was about.
// Registering the buttons the switch already handles fixes every make-x menu in the codebase, not
// just this one.
//
// The menu is built from what the player is actually carrying, so it shows one, two or three
// products and picks the matching interface. The panel shows PRODUCTS (a ball of wool, a bow
// string), which is why there is a product -> ingredient map: the crafting data is keyed on the
// ingredient via crafting_spinning_struct.

[oploc2,spinningwheel] ~spinning_menu;

[oplocu,spinningwheel]
switch_obj (last_useitem)
{
    // The Fremennik Trials' golden fleece spins on any wheel, which is what the wiki's route via
    // the Seers' Village wheel assumes. It is a single fixed product rather than a make-x menu.
    case viking_golden_fleece : ~viking_spin_fleece;
    case wool : ~spinning_menu;
    case flax : ~spinning_menu;
    case magic_roots : ~spinning_menu;
    case sinew : ~spinning_menu;
    case ball_of_wool : ~objbox(ball_of_wool, "You have already spun this wool.", 250, 0, divide(^objbox_height, 2));
    case bow_string : ~objbox(bow_string, "You have already spun this bow string.", 250, 0, divide(^objbox_height, 2));
    case magic_string : ~objbox(magic_string, "You have already spun these magic roots.", 250, 0, divide(^objbox_height, 2));
    case crossbow_string : ~objbox(crossbow_string, "You have already spun this sinew.", 250, 0, divide(^objbox_height, 2));
    case default : ~displaymessage(^dm_default);
};

[proc,spinning_menu]
// what the player carries, in the panel's order; sinew spins into a crossbow string (474)
def_namedobj $o1 = null;
def_namedobj $o2 = null;
def_namedobj $o3 = null;
def_namedobj $o4 = null;
def_int $n = 0;
def_int $i = 0;
def_namedobj $product = null;
while ($i < 4) {
    $product = null;
    switch_int ($i) {
        case 0 :
            if (inv_total(inv, wool) > 0) {
                $product = ball_of_wool;
            }
        case 1 :
            if (inv_total(inv, flax) > 0) {
                $product = bow_string;
            }
        case 2 :
            if (inv_total(inv, magic_roots) > 0) {
                $product = magic_string;
            }
        case 3 :
            if (inv_total(inv, sinew) > 0) {
                $product = crossbow_string;
            }
    }
    if ($product ! null) {
        switch_int ($n) {
            case 0 : $o1 = $product;
            case 1 : $o2 = $product;
            case 2 : $o3 = $product;
            case 3 : $o4 = $product;
        }
        $n = add($n, 1);
    }
    $i = add($i, 1);
}

if ($n = 0) {
    mes("You have nothing you can spin.");
    return;
}

def_int $count = 0;
if ($n = 1) {
    $product, $count = ~skillmulti1($o1);
} else if ($n = 2) {
    $product, $count = ~skillmulti2($o1, $o2);
} else if ($n = 3) {
    $product, $count = ~skillmulti3($o1, $o2, $o3);
} else {
    $product, $count = ~skillmulti4($o1, $o2, $o3, $o4);
}
if ($product = null | $count < 1) {
    return;
}
~craft_spinning_batch($product, $count);

// The panel offers products; the crafting data hangs off the ingredient.
[proc,spinning_ingredient](obj $product)(namedobj)
switch_obj ($product) {
    case ball_of_wool : return(wool);
    case bow_string : return(flax);
    case magic_string : return(magic_roots);
    case crossbow_string : return(sinew);
    case default : return(null);
}
return(null);

[proc,craft_spinning_batch](obj $product, int $count)
def_namedobj $ingredient = ~spinning_ingredient($product);
if ($ingredient = null) {
    ~displaymessage(^dm_default);
    return;
}
if ($ingredient ! wool & map_members = ^false) {
    mes(^mes_members_feature);
    return;
}
def_struct $struct = oc_param($ingredient, crafting_spinning_struct);
def_int $level = struct_param($struct, levelrequire);
if (stat(crafting) < $level) {
    ~mesbox("You need level <tostring($level)> Crafting to make that.");
    return;
}
if (afk_event = ^true) {
    ~macro_event_general_spawn(~macro_event_set_random);
    return;
}

// One loc_anim before the chain rather than one per item: the active loc reference is not worth
// relying on once the repeat is a queue, and the player animation carries the rest.
loc_anim(spinningwheel);

// THE REPEAT IS A QUEUE, NOT p_delay, and spinning was the last place in the build that had not
// caught up with that. skill_fletching/scripts/bows.rs2 states the rule in capitals and gives one
// of the two reasons: p_delay sets player.delayed, and while it is set MoveClickHandler and
// OpLocHandler drop the player's input, so a batch paced that way cannot be stopped.
//
// The other reason is tracker issue 23. Player.addXp ENQUEUES the [advancestat,crafting] script
// instead of running it inline, and a delayed player's queue does not drain - so every level
// earned during a p_delay batch waited for the batch to end, and then [label,levelup] read
// stat_base() as it finally ran, which is the level the batch FINISHED on. Spinning 27 flax from
// level 10 with 1180 xp earned 11 and 12 and announced "Your crafting level is now 12." twice.
//
// One item now and the next on a weakqueue is how cooking (skill_cooking/scripts/cooking.rs2) and
// strung bows carry theirs. Four ticks, not three: p_delay(3) set delayedUntil to tick + 1 + 3, so
// four is the cadence this wheel already span at.
if ($count <= 1) {
    ~spin_one($product);
    return;
}
weakqueue*(spin_more, 4)(sub($count, 1), $product);
~spin_one($product);

[queue,spin_more](int $count, obj $product)
if ($count < 1) {
    return;
}
def_namedobj $ingredient = ~spinning_ingredient($product);
if ($ingredient = null) {
    return;
}
if (inv_total(inv, $ingredient) < 1) {
    return;
}
weakqueue*(spin_more, 4)(sub($count, 1), $product);
~spin_one($product);

// Deliberately silent when the last one is spun: the loop this replaced printed nothing either,
// and cooking's "You don't have any more..." line has a video behind it that this does not.
[proc,spin_one](obj $product)
def_namedobj $ingredient = ~spinning_ingredient($product);
if ($ingredient = null) {
    return;
}
if (inv_total(inv, $ingredient) < 1) {
    return;
}
def_struct $struct = oc_param($ingredient, crafting_spinning_struct);
anim(human_spinningwheel, 0);
sound_synth(spinning, 1, 0);
inv_del(inv, $ingredient, 1);
inv_add(inv, struct_param($struct, product), 1);
mes(struct_param($struct, processmessage));
stat_advance(crafting, struct_param($struct, productexp));
