[oploc1,trapdoor]
mes("The trapdoor opens...");
sound_synth(door_open, 0, 0);
// Temp note: dur does not need updated ? @indio
loc_change(trapdoor_open, 500);

[oploc1,trapdoor_open]
mes("You climb down through the trapdoor...");
anim(human_pickupfloor, 0);
p_delay(0);
p_telejump(movecoord(coord(), 0, 0, 6400));

[oploc2,trapdoor_open]
mes("You close the trapdoor.");
sound_synth(door_close, 0,0 );
// Temp note: dur does not need updated ? @indio
loc_change(trapdoor, 500);

[oploc1,roguesden_trapdoor_entrance]
mes("You climb down through the trapdoor...");
anim(human_pickupfloor, 0);
p_delay(0);
p_telejump(1_47_77_53_56);

[oploc1,roguesden_passage_to_pub]
mes("You walk through the passage...");
p_delay(0);
p_telejump(0_45_55_26_16);

[oploc1,loc_9472]
mes("You climb down through the trapdoor...");
anim(human_pickupfloor, 0);
p_delay(0);
p_telejump(0_46_149_63_13);
