[opnpc3,_shop_keeper] ~openshop_activenpc;

// ADDED 2026-09-08 (dead-op audit): 29 npcs carried category=shop_keeper and op1=Talk-to with no
// [opnpc1,<name>] behind it, so Talk-to did nothing at all - the farming and seed merchants, the
// TzHaar traders, the wilderness cape sellers, the Rogues' Den trader, the Smithing Guild pair, the
// Lletya traders, and others. getByTrigger resolves type before category, so every shopkeeper that
// already has its own [opnpc1,<name>] keeps its own dialogue and this never runs for them; it only
// fills the gap, and it fills it for any shopkeeper added later too.
//
// The exchange is the standard 2006 shopkeeper one.
[opnpc1,_shop_keeper] @shop_keeper_talk;

// a label so npcs with their own Talk-to (skill cape sellers) can fall through to it
[label,shop_keeper_talk]
if (~shop_keeper_asks = false) {
    return;
}
~openshop_activenpc;

// THE QUESTION, SPLIT FROM THE OPENING, so that a shopkeeper whose till is chosen by SCRIPT rather
// than by its owned_shop param can ask the same thing and then open its own. Fortunato in Draynor
// is the only one of the 175 shopkeepers in this category like that - he has three tills (free,
// members, and members once Rag and Bone Man has started) - and the category Talk-to above used to
// reach him, find no param, and transmit inv -1, which logs the player out. See
// DeathPlateau-Bugs#94 and area_draynor/scripts/fortunato.rs2.
//
// The five existing @shop_keeper_talk callers are unaffected: the label still asks and still opens
// the active npc's own till, in that order, with the same words.
[proc,shop_keeper_asks]()(boolean)
~chatnpc("<p,happy>Can I help you at all?");
def_int $choice = ~p_choice2("Yes please. What are you selling?", 1, "No thanks.", 2);
if ($choice = 2) {
    ~chatplayer("<p,neutral>No thanks.");
    ~chatnpc("<p,neutral>Well, come back if you change your mind.");
    return(false);
}
~chatplayer("<p,quiz>Yes please. What are you selling?");
~chatnpc("<p,happy>Take a look at my wares.");
return(true);

// COINS, and not a sixth argument: all 38 callers of this are coin shops, and a shop that trades
// in anything else is opened by its own shopkeeper below, where the param says what.
[proc,openshop](inv $shop, int $shop_buy, int $shop_sell, int $shop_haggle, string $title)
%shop_currency = coins;
%shop_wallet = ^shop_wallet_inv;
%shop = $shop;
%shop_buy = $shop_buy;
%shop_sell = $shop_sell;
%shop_haggle = $shop_haggle;
if_settext(shop_template:com_76, $title);
inv_transmit(inv, shop_template_side:inv);
inv_transmit($shop, shop_template:inv);
if_openmain_side(shop_template, shop_template_side);

// AND ONE FOR A SHOPKEEPER WITH TWO COUNTERS, which no param can describe: owned_shop names a
// single inv, so an npc offering both Trade-Co-op and Trade-Drinks - as Gabooty of Tai Bwo Wannai
// does - can only have one of them on a param and has to open the other itself. Same body as
// ~openshop, with the currency as an argument instead of coins.
[proc,openshop_obj](inv $shop, namedobj $currency, int $shop_buy, int $shop_sell, int $shop_haggle, string $title)
%shop_currency = $currency;
%shop_wallet = ^shop_wallet_inv;
%shop = $shop;
%shop_buy = $shop_buy;
%shop_sell = $shop_sell;
%shop_haggle = $shop_haggle;
if_settext(shop_template:com_76, $title);
inv_transmit(inv, shop_template_side:inv);
inv_transmit($shop, shop_template:inv);
if_openmain_side(shop_template, shop_template_side);

[proc,openshop_activenpc]
// null rather than coins would make every existing shopkeeper's till empty, so the param's own
// default is coins and this reads it straight.
%shop_currency = npc_param(shop_currency);
// Where the money comes from, which is not the same question as which money - see
// shop/scripts/shop_wallet.rs2. The param defaults to the inventory, so every shopkeeper that
// predates the vote shop keeps paying out of inv without being edited.
%shop_wallet = npc_param(shop_wallet);
%shop = npc_param(owned_shop);
// A SHOPKEEPER WITH NO TILL USED TO LOG THE PLAYER OUT. owned_shop defaults to null, inv_transmit
// is handed -1, and ScriptRunner's error path calls self.logout() under NODE_PRODUCTION - so a
// missing param on one npc is a disconnect rather than a message (DeathPlateau-Bugs#94). Every
// shopkeeper in the category has the param today and a sweep says so, but this is one line against
// the next one added without it, and "Nothing interesting happens." is what the rest of the game
// says when an option has nothing behind it.
if (%shop = null) {
    ~displaymessage(^dm_default);
    return;
}
%shop_buy = npc_param(shop_buy_multiplier);
%shop_sell = npc_param(shop_sell_multiplier);
%shop_haggle = npc_param(shop_delta);
if_settext(shop_template:com_76, npc_param(shop_title));
inv_transmit(inv, shop_template_side:inv);
inv_transmit(%shop, shop_template:inv);
if_openmain_side(shop_template, shop_template_side);

[if_close,shop_template]
inv_stoptransmit(shop_template_side:inv);
inv_stoptransmit(shop_template:inv);

[proc,can_sell_obj](obj $item)(boolean)
def_boolean $item_is_tradable = oc_tradeable(oc_uncert($item));
// A SHOP PAID IN VOTE POINTS BUYS NOTHING. There is no ~shop_wallet_gain, deliberately: anything
// this could pay out for would be a way to mint points. The stock list at the vote shop is
// untradeable anyway, so this is the rule for whatever gets added to it later.
if (%shop_wallet = ^shop_wallet_vote_points) {
    mes("This shop only takes vote points. It isn't buying.");
    return (false);
}
// Tradeable between players, but no shop anywhere will put a price on it (shop/configs/
// shopitem.param). Checked before the allstock rule below, because it is the allstock shops that
// would otherwise buy it.
if (oc_param(oc_uncert($item), shop_will_not_buy) = true) {
    mes("You can't sell this item to a shop.");
    return (false);
}
if ($item = %shop_currency) {
    mes("You can't sell this item to a shop.");
    return (false);
} else if ($item = macro_cube) {
    // Guess it works like trying to bank it but unconfirmed
    ~try_add_macro_cube;
    return (false);
} else if ($item_is_tradable = false | (map_members = ^false & oc_members($item) = true)) {
    mes("You can't sell this item.");
    return (false);
} else if ((%shop = generalshop3 & $item = silk) | inv_allstock(%shop) = false & inv_stockbase(%shop, oc_uncert($item)) = -1) { // can't sell silk to al-kharid general store
    mes("You can't sell this item to this shop.");
    return (false);
}
return (true);

// sell value
[inv_button1,shop_template_side:inv]
def_obj $item = oc_uncert(inv_getobj(inv, last_slot));
def_string $item_name = oc_name($item);
def_int $item_value = ~adjusted_item_cost_selling($item, inv_total(%shop, $item));
if(~can_sell_obj($item) = false) {
    return;
}
// "gp" was the last place in this file that named a currency rather than reading it. A TzHaar
// trader pays in Tokkul (param=shop_currency,tzhaar_token) and quoted the price in gp,
// which is the same bug the wallet was built to end - it just was not in the buy path.
mes("<$item_name>: shop will buy for <tostring($item_value)> <~shop_wallet_name>.");

// Buy value
[inv_button1,shop_template:inv]
def_obj $item = inv_getobj(%shop, last_slot);
def_string $item_name = oc_name($item);
def_int $item_value = ~adjusted_item_cost_buying($item, inv_total(%shop, $item));
mes("<$item_name>: currently costs <tostring($item_value)> <~shop_wallet_name>.");

// Buy an item from the shop
[label,buy_item](obj $obj, int $amount)
def_int $i = 0;
def_int $current_gp = ~shop_wallet_total;
def_int $shop_stock = calc(inv_total(%shop, $obj));
def_int $space_overflow = inv_itemspace2(inv, $obj, $amount, inv_size(inv));
def_int $total_cost = 0;
// Since pricing and stock will change constantly we will have to iterate here to calc
while($i < $amount) {
    def_int $added_amt = ~adjusted_item_cost_buying($obj, calc($shop_stock - $i));
    def_int $current_stock = calc($shop_stock - $i);
    if(calc($total_cost + $added_amt) > $current_gp) {
        if ($i > 0) {
            wealth_event(^wealth_shop_buy, oc_debugname($obj), $i, $total_cost);
        }
        mes("You don't have enough <~shop_wallet_name>.");
        return;
    }
    if($current_stock <= 0) {
        if ($i > 0) {
            wealth_event(^wealth_shop_buy, oc_debugname($obj), $i, $total_cost);
        }
        mes("The shop has run out of stock.");
        return;
    }
    // The exemption for spending exactly what you are holding: the currency stack empties and frees
    // the slot it was in, so a full inventory is not full after all. ~shop_wallet_exact_change is
    // where that lives now, because it is only true of a currency that OCCUPIES a slot - a varp
    // balance frees nothing. (Whether 2004 did this at all is still unverified.)
    if($space_overflow >= calc($amount - $i) & ~shop_wallet_exact_change(calc($total_cost + $added_amt), $current_gp) = false) {
        if ($i > 0) {
            wealth_event(^wealth_shop_buy, oc_debugname($obj), $i, $total_cost);
        }
        mes("You don't have enough inventory space.");
        return;
    }
    $total_cost = calc($total_cost + $added_amt);
    ~shop_wallet_spend($added_amt);
    inv_moveitem_uncert(%shop, inv, $obj, 1);
    $i = calc($i + 1);
}
wealth_event(^wealth_shop_buy, oc_debugname($obj), $i, $total_cost);
// TWO SHELVES ARE COLLECTION LOG SOURCES. An item is logged where it is DROPPED OR HANDED OUT - a
// drop table, a casket, a chest, a shop that pays in tickets - and picking one up does not log it,
// so a generic shop purchase logs nothing. These two are the cases in this build where buying IS
// the only way an item exists, which is the rule the log's own pages are written to:
//
//   the Undertaker  the outfit, the cape and the Gravedigger kit have no other source at all, and
//                   nor do the whip kits, the ancient fabric or the fighter torso.
//   the Vote clerk  the ten elite diary rewards and the seed box. There is no achievement diary
//                   here to hand the first ten out and no Tithe Farm for the eleventh.
//
// THE VOTE CLERK WAS MISSING AND HIS PAGE COULD NOT FILL (23 November). The log has had a Vote Shop
// page since the clerk was built, and this test named only the Undertaker - so every one of those
// ten slots was unfillable, and nothing said so: ~collection_log_add returns quietly for an item
// the log does not list, and the log lists these, so the silence came from the call never happening
// at all. Found while adding the seed box to the page, which did not record either.
//
// The Agility Arena and Castle Wars ticket traders do the same thing from their own exchange
// scripts; these two use the ordinary shop, so the line lives here.
//
// NAMED SHELVES rather than inferred from shop_currency: Grace and the TzHaar traders also take
// something other than coins, and neither of their stocks belongs in the log.
if ((%shop = death_token_shop | %shop = vote_shop) & $i > 0) {
    ~collection_log_add($obj, 1);
}

// Sell an item to the shop
[label,sell_item](obj $obj, int $amount)
def_int $shop_total = inv_total(%shop, oc_uncert($obj));
def_int $total_value = 0;
def_int $sell_amount = ~calculate_items_amount_sold($obj, $amount);
if(~can_sell_obj($obj) = false) {
    return;
}
// Check if you will have space in your inventory to hold the payment after selling
if(inv_itemspace(inv, %shop_currency, $sell_amount, inv_size(inv)) = false & oc_stackable($obj) = true & inv_total(inv, $obj) > $sell_amount) {
    mes("You don't have enough inventory space.");
    return;
}
// Check if the shop will have enough space to hold the obj
if(inv_itemspace(%shop, oc_uncert($obj), $sell_amount, inv_size(%shop)) = false) {
    mes("The shop has run out of space.");
    return;
}
// Iteration to calc the total value of the sale
def_int $i = 0;
while($i < $sell_amount) {
    def_int $added_amt = ~adjusted_item_cost_selling(oc_uncert($obj), calc($shop_total + $i));
    $total_value = calc($total_value + $added_amt);
    $i = calc($i + 1);
}
// now perform the transaction 
inv_moveitem_uncert(inv, %shop, $obj, $sell_amount);
wealth_event(^wealth_shop_sell, oc_debugname($obj), $sell_amount, $total_value);
if($total_value > 0) {
    inv_add(inv, %shop_currency, $total_value);
}

[proc,price_mod](inv $inv, int $diff, obj $obj)(int)
def_int $base = inv_stockbase($inv, $obj);
if($base = -1) {
    return ($diff);
}
return (calc($diff - $base));

// Purchase cost at a specifc stack count
[proc,adjusted_item_cost_buying](obj $obj, int $diff)(int)
def_int $cost = oc_cost($obj);
def_int $value = ~calc_shop_value($cost, %shop_haggle, %shop_sell, ~price_mod(%shop, $diff, $obj));
// Unlike sell values, shop purchase values can't be 0 (I believe...), not entirely sure if this is how
// it's supposed to be handled or if the formula needs to be altered somehow
if($value < 1) { 
    $value = 1;
}
return ($value);

// Sell value at a specific stack count
[proc,adjusted_item_cost_selling](obj $obj, int $diff)(int)
def_int $cost = oc_cost($obj);
return (~calc_shop_value($cost, %shop_haggle, %shop_buy, ~price_mod(%shop, $diff, $obj)));

// Calculate the amount of items a player has to sell relative to a desired amount
[proc,calculate_items_amount_sold](obj $item, int $sell_amount)(int)
def_int $player_amount = inv_total(inv, $item);
if ($sell_amount > $player_amount) {
    return ($player_amount);
}
return ($sell_amount);

// Sell buttons
[inv_button2,shop_template_side:inv] @shop_request(inv, last_slot, 1);
[inv_button3,shop_template_side:inv] @shop_request(inv, last_slot, 5);
[inv_button4,shop_template_side:inv] @shop_request(inv, last_slot, 10);

// Buy buttons
[inv_button2,shop_template:inv] @shop_request(%shop, last_slot, 1);
[inv_button3,shop_template:inv] @shop_request(%shop, last_slot, 5);
[inv_button4,shop_template:inv] @shop_request(%shop, last_slot, 10);

// verify a request to buy or sell from a shop, and then perform the transaction if all passed
[label,shop_request](inv $shop_inv, int $slot, int $amount)
// Check if the slot was empty.
def_obj $item = inv_getobj($shop_inv, $slot);
if($shop_inv = %shop) {
    @buy_item($item, $amount);
} else {
    @sell_item($item, $amount);
}

// Calculate the gp value for the shop operation
[proc,calc_shop_value](int $base_cost, int $shophaggle, int $shopbuy, int $int3)(int)
def_int $int4 = 0;
def_int $int5 = min(1000, max(-5000, calc($int3 * $shophaggle)));
$int5 = max(100, calc($shopbuy - $int5));
$int4 = scale($int5, 1000, $base_cost);
if ($int4 < 0) {
    $int4 = 2000000000;
    error("Cost overflowed with base_cost=<tostring($base_cost)>, for %shopbuy=<tostring($shopbuy)> and %shophaggle=<tostring($shophaggle)>. Corrected to 2 billion.");
}
return($int4);
