// The bank's Swap/Insert rearrange mode. scope=perm (Corey, 2026-09-30): it used to be temp,
// so it held for a session and then went back to Swap on the next login - "bank doesnt
// remember swap / insert". clientcode=9 is how the client learns it (Client.bankArrangeMode,
// which decides whether a drag draws as a swap or an insert), and transmit=yes on a perm varp
// is resent on login, so the client is told the saved value before the bank is ever opened.
[bankinsert]
scope=perm
transmit=yes
clientcode=9

