// Withdraw-as-note. scope=perm (Corey, 2026-09-30): the bank's settings are remembered as a
// class - see banktab.varp, where %bankquantity, %bankquantity_x and %bankplaceholders are
// already perm. This one was temp AND force-reset to 0 by bankpin_open_bank_real on every
// single bank open, so it never survived even walking to the next booth. OSRS remembers it
// for good, and this bank has already followed OSRS past 2006 (tabs, search, placeholders).
[bankcert]
scope=perm
transmit=yes

