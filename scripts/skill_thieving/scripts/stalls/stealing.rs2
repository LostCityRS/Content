// THE FIVE IN MARIM, on Ape Atoll, which carried "Steal from" with nothing behind it.
[oploc2,mm_stall_food] // Monkey food stall
@attempt_steal_from_stall(loc_type, loc_coord, loc_angle, loc_shape);

