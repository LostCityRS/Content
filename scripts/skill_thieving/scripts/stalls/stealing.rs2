[queue,stolen_from_stall_gem]
%thieving_stall_timer = clearbit(%thieving_stall_timer, ^gem_stall_index);

[queue,stolen_from_stall_seed]
%thieving_stall_timer = clearbit(%thieving_stall_timer, ^seed_stall_index);

// THE DRAYNOR SEED STALL (2026-10-15), the last loc in the game advertising "Steal from" with
// nothing behind it - tools/silentops.py has had it on one line of its own for months.
[oploc2,seed_stall] // Seed stall
@attempt_steal_from_stall(loc_type, loc_coord, loc_angle, loc_shape);
