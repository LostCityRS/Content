[debugproc,addobj]
if_close;
if (p_finduid(uid) = true) {
    obj_add(movecoord(coord, 0, 0, 5), logs, 1, ^lootdrop_duration);
    p_opobj(4);
} else {
    @please_finish;
}

// Drops a pile of 20 cowhides on the player's own tile for spam-click
// interaction testing (MoveClick/OpObj packet-split repro).
[debugproc,dropcowhides]
obj_add(coord, cow_hide, 20, ^lootdrop_duration);
mes("Dropped 20 cowhides on your tile.");

[debugproc,addobj2](int $size)
def_int $half = calc(($size / 2) * -1);

def_int $x = 0;
while ($x < $size) {
    def_int $z = 0;
    while ($z < $size) {
        if (random(2) = 0) {
            obj_addall(movecoord(coord, calc($half + $x), 0, calc($half + $z)), ~cracker_partyhat, 1, 30);
        } else {
            obj_addall(movecoord(coord, calc($half + $x), 0, calc($half + $z)), ~cracker_other, 30);
        }
        $z = calc($z + 1);
    }
    $x = calc($x + 1);
}

[debugproc,testloc2]
if (loc_find(0_49_52_41_38, silverrock2) = true) {
    loc_change(loc_param(next_loc_stage_mining), 2);
}

if (p_finduid(uid) = true) {
    p_telejump(movecoord(coord, 0, 0, 25));
    p_delay(2);
    p_telejump(movecoord(coord, 0, 0, -25));
} else {
    @please_finish;
}
