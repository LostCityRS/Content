// Construction room templates, imported from the rev 474 cache (tools/models/import474map.py).
// Each house style is one level of one square; each room one 8x8 zone at the same offset in every style.
//   m29_79 levels 0-3 and m30_79 levels 0-1 = the six styles.
^poh_templates_a = 0_29_79_0_0
^poh_templates_b = 0_30_79_0_0
// Where a player lands leaving a house. This is Rimmington's, and it is no longer the only one:
// poh_loc_exit in poh_locations.enum holds all six and %poh_location picks between them. Kept as
// the fallback for a %poh_location that somehow answers null.
^poh_exit = 0_46_50_9_24
// How many house locations there are. Anything that walks the list reads this rather than 6.
^poh_location_count = 6

// ---- the windows (poh.rs2 ~poh_window_refresh, 2026-09-14) ----
// How many window kinds there are per house style: shuttered, four decorative and four
// stained-glass. %poh_window is style * this + the choice, and poh_dynamic_window has one child
// for every one of the 6 * 9 combinations.
^poh_window_kinds = 9

// ---- hedging (poh_hedge.rs2, 2026-09-15) ----
// Which piece of the hedge a tile takes: two straights and a corner. These index ~poh_hedge_loc
// three at a time, so they must stay 0, 1, 2 - and the order is the one the three hotspot ghosts
// name, which tools/genhedge.py re-derives from the models before it writes anything.
^poh_hedge_a = 0
^poh_hedge_corner = 1
^poh_hedge_b = 2

// ---- rugs (poh_rug.rs2, 2026-09-15) ----
// Which piece of the rug a tile takes. The rug is one piece of furniture over a rectangle of
// floor, and these index ~poh_rug_loc three at a time, so they must stay 0, 1, 2.
^poh_rug_corner = 0
^poh_rug_side = 1
^poh_rug_middle = 2

// The room tile a rug is STORED at. Not a tile the rug covers: an anchored piece needs one slot
// key per room whichever of its hotspots was clicked, and (7,7) is the only tile that carries no
// hotspot in any of the five rooms that have a Rug space - so a rug and a statue can never want
// the same slot. Battery group 60 is what keeps that true.
^poh_rug_anchor = 7

// ---- the portal chamber (poh_portal_chamber.rs2, 2026-09-14) ----
// Which of the three Portal spaces, named by the side of the room it stands on. These index
// %poh_portals three bits at a time, so they must stay 0, 1, 2.
^poh_portal_north = 0
^poh_portal_east = 1
^poh_portal_west = 2

// Where a portal leads. 0 is undirected, which is what a save written before %poh_portals
// existed reads and is the right answer for a frame nobody has pointed anywhere. Seven fits in
// the three bits each portal gets.
^poh_portal_varrock = 1
^poh_portal_lumbridge = 2
^poh_portal_falador = 3
^poh_portal_camelot = 4
^poh_portal_ardougne = 5
^poh_portal_yanille = 6
^poh_portal_trollheim = 7

// ---- the costume room's treasure chest (poh_costume.rs2, 2026-09-14) ----
// How many treasure trail reward items the chest knows about, and how many sets they fall into.
// Both are the length of the tables in poh_costume.enum, which are derived from the clue reward
// tables - battery group 55 re-derives them and fails if either number drifts.
^poh_costume_items = 96
^poh_costume_sets = 20

// ---- the archery target and the dartboard (poh_games.rs2, 2026-09-14) ----
// Indices into poh_range_ammo: the six arrows first, then the six darts.
^poh_arrow_first = 0
^poh_arrow_last = 5
^poh_dart_first = 6
^poh_dart_last = 11
// Ranged experience for one shot that lands, before the bullseye multiplier. NOT cache data - the
// tunable part, like the altar percentages and the room prices. A shot is three ticks, so this is a
// few thousand an hour at best: the target is a thing to build, not a way to train.
^poh_range_xp = 8

// ---- the saved house layout (poh.rs2, 2026-09-11) ----
// The grid is ^poh_grid x ^poh_grid rooms on the ground floor. Eight is more than OSRS ever needs
// and still fits four rooms to a varp with the 8x8-zone instance slot to spare.
^poh_grid = 8
// Where the grid starts inside the 16x16-zone instance slot. The margin matters: a wall on a room's
// edge flags the tile across that edge, so the outermost rooms need somewhere to spill into.
^poh_grid_origin = 4
// Where inside a room the player lands. (3,2) is what the test house used and is proven walkable in
// a garden; it is floor in every room template that has one.
^poh_spawn_x = 3
^poh_spawn_z = 2

// Door sides. The order is the rotation order - rotating a room 90 degrees rotates the mask left
// by one - so these four values may not be renumbered independently.
^poh_door_n = 1
^poh_door_e = 2
^poh_door_s = 4
^poh_door_w = 8

// Room types; the tables live in poh_rooms.enum.
^poh_room_garden = 1
^poh_room_parlour = 2
^poh_room_kitchen = 3
^poh_room_dining_room = 4
^poh_room_bedroom = 5
^poh_room_workshop = 6
^poh_room_chapel = 7
^poh_room_study = 8
^poh_room_throne_room = 9
^poh_room_portal_chamber = 10
^poh_room_combat_room = 11
^poh_room_games_room = 12
^poh_room_skill_hall = 13
^poh_room_quest_hall = 14
^poh_room_costume_room = 15
^poh_room_formal_garden = 16
// How many room types there are. Anything that walks the list reads this rather than 16.
^poh_room_count = 16

// ---- the portal round (poh_portal.rs2, 2026-09-11) ----
// What the estate agent charges for the plot, the garden and the parlour.
^poh_house_cost = 1000
// Where the exit portal stands inside the entry room, in that room's own 8x8 tiles: (3,3) to (4,4),
// the middle. That is the garden's CENTREPIECE slot - loc474_15361 "Centrepiece space", 2x2, sits on
// exactly those tiles in the template - and OSRS loc 4525 is a centrepiece, one of the same family as
// the Tree, Pond and Statue in category 206. Putting it in a corner (the first attempt) was avoiding
// the door hotspots, which sit in the MIDDLE of each SIDE (x 3-4 north and south, z 3-4 east and
// west) and are nowhere near the middle of the room.
// The player lands at (3,2), directly south of it.
^poh_exit_portal_x = 3
^poh_exit_portal_z = 3
// How long a spawned loc inside a house lasts. loc_add rejects 0, and there is no "forever" - but
// the instance is purged on the way out, which takes the portal with it, so this only has to
// outlast one visit. Two million cycles is about a fortnight.
^poh_loc_duration = 2000000

// How long ::~pohportal's probe stands. 300 ticks is three minutes - long enough to walk round it
// and look, short enough that a forgotten one does not block the road.
^poh_portal_probe_ticks = 300

// ---- the sawmill (sawmill.rs2, 2026-09-11) ----
// What the operator charges to cut one plank. These are NOT invented: they are the `cost` the OSRS
// cache carries on each plank item (oak 250, teak 500, mahogany 1500). Obj 960 "Plank" has no cost
// at all in the cache, so 100 is the one number here that is a choice.
^sawmill_fee_plank = 100
^sawmill_fee_oak = 250
^sawmill_fee_teak = 500
^sawmill_fee_mahogany = 1500
// The two tools Construction needs. The saw's cache cost is 10, which is a shop's buy price rather
// than what a player pays; both are priced to be a non-event next to a 1000-coin house.
^sawmill_cost_saw = 100
^sawmill_cost_hammer = 100
// A bolt of cloth, the same 650 OSRS charges for one at this same shop.
^sawmill_cost_cloth = 650

// ---- furniture (poh_furniture.rs2) ----
// GENERATED by tools/genfurn.py from tools/furnspec.json, along with the varps, the enum
// tables and all of poh_furniture.rs2.
//
// How many pieces one house can hold, and how many buildable things there are.
^poh_furn_slots = 256
^poh_furn_items = 351

// How many level bands the skill guide pages into (poh_guide_lo/hi in the enum). One
// more button than this is used, for the Rooms page, and the interface has thirteen.
^poh_guide_bands = 11

// The bit layout of one packed piece. 30 bits, so it fits an int with room to spare.
^poh_furn_bit_rx = 0
^poh_furn_bit_rz = 3
^poh_furn_bit_lx = 6
^poh_furn_bit_lz = 9
^poh_furn_bit_angle = 12
^poh_furn_bit_item = 14
^poh_furn_bit_lit = 22
^poh_furn_bit_item_hi = 23

// Construction experience per plank. OSRS's furniture xp is very nearly planks x this, so it
// is one rule rather than 351 rows of remembered numbers - and it is the obvious thing to tune.
^poh_xp_plank = 29
^poh_xp_oak = 60
^poh_xp_teak = 90
^poh_xp_mahogany = 140


// ---- what the furniture does (poh_furn_ops.rs2) ----
// What a house altar pays for bones, as a percentage of the burying experience: the base for
// the plainest altar, a step per tier above it, and a bonus for every lit thing in the same
// room. OSRS pays 250% to 350% and another 50% a burner. NOT cache data - tune away.
^poh_altar_base = 250
^poh_altar_step = 15
^poh_altar_burner = 25

// The furniture families, one per hotspot kind. A hotspot's trigger passes its own family in,
// so nothing has to look one up. NEVER REORDER: item numbers follow family order and item
// numbers are what is stored in a save.
^poh_fam_stove = 1
^poh_fam_sink = 2
^poh_fam_larder = 3
^poh_fam_shelves = 4
^poh_fam_kitchentable = 5
^poh_fam_barrel = 6
^poh_fam_diningtable = 7
^poh_fam_bench = 8
^poh_fam_bellpull = 9
^poh_fam_bed = 10
^poh_fam_wardrobe = 11
^poh_fam_clock = 12
^poh_fam_chair = 13
^poh_fam_bookcase = 14
^poh_fam_fireplace = 15
^poh_fam_dresser = 16
^poh_fam_catbasket = 17
^poh_fam_workbench = 18
^poh_fam_tool = 19
^poh_fam_clockmaking = 20
^poh_fam_repair = 21
^poh_fam_heraldry = 22
^poh_fam_altar = 23
^poh_fam_icon = 24
^poh_fam_torch = 25
^poh_fam_statue = 26
^poh_fam_musical = 27
^poh_fam_lectern = 28
^poh_fam_globe = 29
^poh_fam_crystalball = 30
^poh_fam_telescope = 31
^poh_fam_wallchart = 32
^poh_fam_throne = 33
^poh_fam_throneseat = 34
^poh_fam_lever = 35
^poh_fam_thronedecor = 36
^poh_fam_game = 37
^poh_fam_prizechest = 38
^poh_fam_attackstone = 39
^poh_fam_elemental = 40
^poh_fam_ranging = 41
^poh_fam_armourstand = 42
^poh_fam_runecase = 43
^poh_fam_headtrophy = 44
^poh_fam_fishtrophy = 45
^poh_fam_portrait = 46
^poh_fam_landscape = 47
^poh_fam_guildtrophy = 48
^poh_fam_sword = 49
^poh_fam_map = 50
^poh_fam_treasurechest = 51
^poh_fam_centrepiece = 52
^poh_fam_bigtree = 53
^poh_fam_tree = 54
^poh_fam_bigplant1 = 55
^poh_fam_bigplant2 = 56
^poh_fam_smallplant1 = 57
^poh_fam_smallplant2 = 58
^poh_fam_formalcentre = 59
^poh_fam_formalbigplant = 60
^poh_fam_formalbigplant2 = 61
^poh_fam_formalsmallplant = 62
^poh_fam_formalsmallplant2 = 63
^poh_fam_portal_focus = 64
^poh_fam_portal = 65
^poh_fam_combat_ring = 66
^poh_fam_combat_storage = 67
^poh_fam_rug = 68
^poh_fam_curtain = 69
^poh_fam_walldecor = 70
^poh_fam_fence = 71
^poh_fam_thronefloor = 72
^poh_fam_chapelwindow = 73
^poh_fam_caperack = 74
^poh_fam_magicwardrobe = 75
^poh_fam_armourcase = 76
^poh_fam_toybox = 77
^poh_fam_fancydress = 78
^poh_fam_hedge = 79

// The exit portal, as a piece of furniture. It is the garden's level-1 centrepiece, which
// is where OSRS puts it, and ~poh_ensure_exit hands one out free to any house that has no
// portal yet. ~poh_furn_remove will not take out the last one: that is the whole reason
// this number is a constant rather than something the remove path works out.
^poh_furn_exit_portal = 239

// ---- the build windows (poh_roommenu.if, poh_furnmenu.if) ----
// The camera the model icons are drawn with. The two angles are shared; the ZOOM is not, because
// zoom is a divisor and a bed and a bell-pull cannot share one - tools/ifmodels.py solves a zoom
// per model from its own geometry into ~poh_room_zoom and ~poh_furn_zoom.
^poh_menu_xan = 150
^poh_menu_yan = 40
// How many entries each window shows at once. These are the window's geometry, not a preference:
// tools/genmenus.py lays out exactly this many rows and slots and writes the same numbers here.
^poh_menu_rows = 6
^poh_menu_slots = 8

// How a row is drawn, and it is drawn at all either way: the windows list the whole ladder and dim
// what is out of reach, so 0 is buildable, 1 is buildable-if-you-had-the-money-or-the-planks, and 2
// is above your Construction level. poh_menus.enum turns these into @xxx@ colour tags.
^poh_state_ready = 0
^poh_state_poor = 1
^poh_state_locked = 2


// ---- the lecterns (poh_tablets.rs2) ----
// GENERATED by tools/gentablets.py from tools/tabletspec.json.
//
// How many tablets there are, and how many a lectern can list. The second number is also the
// stride of ~poh_tab_nth's switch key and the row count of poh_tabletmenu - the biggest OSRS
// lectern lists exactly eight, so today no lectern needs the second page the window can show.
^poh_tab_items = 14
^poh_tab_max = 8

// How many tablets one Study can make before the window closes and you click again. An
// inventory's worth: the bound exists because a menu loop that cannot end hangs the script,
// not because there is any reason to stop you.
^poh_tab_loops = 28

// The cap on Make X (the window's quantity buttons, tools/genmenus.py). An inventory's
// worth: a tablet costs a soft clay and clay does not stack, so more than this cannot be
// carried to the lectern in the first place. The buttons themselves - 1, 5, 10 - are in
// tools/tabletspec.json, written into the window rather than into constants.
^poh_tab_qty_max = 28

// ---- the garden (poh_garden.rs2) ----
// HAND WRITTEN, and outside the generators' blocks on purpose: tools/genfurn.py rewrites
// everything from "// ---- furniture" to the next marker, and gentablets.py the lectern block.
//
// Where the Centrepiece space sits inside a garden zone. Read out of all six template squares
// (m29_79 levels 0-3 and m30_79 levels 0-1): every one of them has it at 3,3, one tile north of
// where the player lands (^poh_spawn_x/z is 3,2). Battery check 46 reads the maps again.
^poh_garden_cp_x = 3
^poh_garden_cp_z = 3

// What the Garden supplier charges and pays, as a multiple of an item's own cache cost out of
// 1000 (~calc_shop_value). The Garden Centre sells at an item's VALUE and buys back at 40% of it -
// a bagged dead tree is 1,000 and 400, a bagged tall box hedge is 100,000 and 40,000 - so the two
// numbers are 1000 and 400. The same two are literals in poh_garden.npc, because a config param
// has no precedent for taking a ^constant; check 46 compares them.
//
// THESE WERE BOTH WRONG UNTIL 2026-09-15. 400 is the ratio OSRS BUYS at, and it was here as the
// selling multiplier, so the Garden Centre sold every bagged plant at 40% of the real price. The
// comment that used to be here said 400 "is exactly the OSRS price for all ten bagged plants",
// and battery 46 agreed with it, because the wiki table it was read from has a sell column and a
// buy column and the buy column was the one that got written down. Read the row, not the number.
^poh_garden_sell = 1000
^poh_garden_buy = 400

// And what the Stonemason charges and pays. He is not the Garden Centre: he sells at 130% of an
// item's value and buys back at 50%, consistently across all four things he stocks - a limestone
// brick is 26 and 10 on a value of 20, a marble block 325,000 and 125,000 on 250,000, gold leaf
// 130,000 and 50,000 on 100,000, a magic stone 975,000 and 375,000 on 750,000.
//
// SAME MISTAKE, SAME DAY: 500 is his buying ratio and it was here as his selling one, so a marble
// block cost 125,000 instead of 325,000 and a limestone brick 10 instead of 26. Gold leaf came out
// right by coincidence - its cost had been inflated to 260,000 to make the wrong multiplier give
// the right answer, and 260,000 x 0.5 is the same 130,000 as 100,000 x 1.3. The costs are the
// cache's own values again now. Battery 48 checks all four against the shop's own list.
^poh_stone_sell = 1300
^poh_stone_buy = 500

// ---- the instruction budget (poh.rs2, poh_build.rs2, 2026-09-12) ----
// HAND WRITTEN, behind its own marker for the same reason as the block above.
//
// The type fields of the four room slots packed into one layout word, masked together: 0x3F3F3F3F.
// ~poh_house_empty tests whole words against this instead of decoding all 64 slots, and the mask
// matters - clearing a slot writes its rotation back with type 0, so a word can be non-zero with
// no room in it. Tied to ^poh_furn_bit_* only by the 8-bit slot: 6 type bits + 2 rotation bits.
^poh_type_mask = 1061109567
