// Melee
// The dragon sword is 60 Attack and the dragon warhammer 60 STRENGTH - which is the cache
// record's own requirement param (434 names the skill, and 2 is Strength), and matches Old
// School's 2021 change away from Attack.
[opheld2,dragon_sword] @levelrequire_attack(60, last_slot);
[opheld2,dragon_warhammer] @levelrequire_strength(60, last_slot);
[opheld2,dragon_dagger] @levelrequire_zanaris_quest_attack(60, last_slot);
[opheld2,dragon_dagger_p] @levelrequire_zanaris_quest_attack(60, last_slot);
[opheld2,dragon_dagger_p+] @levelrequire_zanaris_quest_attack(60, last_slot);
[opheld2,dragon_dagger_p++] @levelrequire_zanaris_quest_attack(60, last_slot);
[opheld2,dragon_mace] @levelrequire_heroes_quest_attack(60, last_slot);
[opheld2,dragon_longsword] @levelrequire_zanaris_quest_attack(60, last_slot);
[opheld2,dragon_battleaxe] @levelrequire_heroes_quest_attack(60, last_slot);
[opheld2,dragon_spear] @levelrequire_attack_caps(60, last_slot);
[opheld2,dragon_spear_p] @levelrequire_attack_caps(60, last_slot);
[opheld2,dragon_spear_p+] @levelrequire_attack_caps(60, last_slot);
[opheld2,dragon_spear_p++] @levelrequire_attack_caps(60, last_slot);
[opheld2,dragon_halberd] @levelrequire_regicide_quest_attack_strength(60, 30, last_slot);
[opheld2,dragon_scimitar] @levelrequire_mm_quest_attack(60, last_slot);

[opheld2,dragon_med_helm] @levelrequire_defence_caps(60, last_slot);
[opheld2,dragon_sq_shield] @levelrequire_legends_quest_defence(60, last_slot);
[opheld2,dragon_chainbody] @levelrequire_defence_caps(60, last_slot);
[opheld2,dragon_platelegs] @levelrequire_defence_caps(60, last_slot);
[opheld2,dragon_plateskirt] @levelrequire_defence_caps(60, last_slot);

// Ranged
[opheld2,red_dragon_vambraces] @levelrequire_ranged_lower(60, last_slot);
[opheld2,red_dragonhide_chaps] @levelrequire_ranged_lower(60, last_slot);
[opheld2,red_dragonhide_body] @levelrequire_ranged_and_defence(60, 40, last_slot);

// Magic

// --- 60 Attack / 60 Magic gear (2026-09-04) ---
[opheld2,dragon_2h_sword] @levelrequire_attack(60, last_slot);
// The dragon axe was the only axe with no wearpos, so it could never be wielded at all.
// wearpos=righthand added in skill_woodcutting/configs/axes/axes.obj; it needs the same
// 60 Attack gate as the other 60-tier weapons (61 Woodcutting to chop is separate and is
// handled by woodcut.rs2).
[opheld2,dragon_axe] @levelrequire_attack(60, last_slot);
// The three god staves are deliberately NOT gated here. They already have an [opheld2,...]
// in areas/area_mage_arena/scripts/god_gear.rs2 which enforces the god-staff/god-cape
// mutual-exclusion rule, and a second definition is a duplicate-trigger build error.
// A hard 60 Magic wield check would also be wrong: the wiki says the staves require
// 60 Magic "to acquire and therefore wield" - the real gate is Mage Arena entry, not the
// wield itself, so leaving god_gear.rs2 as the sole owner is the accurate behaviour.
[opheld2,tzhaar_staff] @levelrequire_magic_and_attack(60, 60, last_slot);

// --- The rest of the obsidian set (2026-09-21). OSRS's requirements; until now anyone could wield
// them, the staff above being the only one with a check.
[opheld2,tzhaar_splitsword] @levelrequire_attack(60, last_slot);
[opheld2,tzhaar_knife] @levelrequire_attack(60, last_slot);
[opheld2,tzhaar_mace] @levelrequire_attack(60, last_slot);
[opheld2,tzhaar_maul] @levelrequire_strength(60, last_slot);
[opheld2,tzhaar_spikeshield] @levelrequire_defence(60, last_slot);
[opheld2,tzhaar_throwingring] @levelrequire_ranged(60, last_slot);
[opheld2,magictraining_bookofmagic] @levelrequire_magic(60, last_slot);
[opheld2,magictraining_wand_master] @levelrequire_magic(60, last_slot);

// --- Dragon boots (2026-09-09, rev 474 cache). 60 Defence. ---
[opheld2,dragon_boots] @levelrequire_defence(60, last_slot);
[opheld2,dragon_defender] @levelrequire_defence(60, last_slot);

// --- Dragon pickaxe (2026-09-10, OSRS cache). 60 Attack. ---
[opheld2,dragon_pickaxe] @levelrequire_attack(60, last_slot);

// --- OSRS imports (2026-09-21) ---
[opheld2,arkan_blade] @levelrequire_attack(60, last_slot);
// Rum Deal's reward (2026-10-26). 60 Attack and 40 Strength - the one weapon in this file that
// wants two stats. https://oldschool.runescape.wiki/w/Barrelchest_anchor
[opheld2,barrelchest_anchor] @levelrequire_attack_and_strength(60, 40, last_slot);
[opheld2,twinflame_staff] @levelrequire_magic(60, last_slot);

// Repaints and renames of items already in this file, found by tools/wearreq.py:
// same slot, same bonuses, so the same armour and the same requirement. They went
// on at level 1 because nobody had typed a line for them.
[opheld2,dragon_boots_g] @levelrequire_defence(60, last_slot);
[opheld2,dragon_chainbody_g] @levelrequire_defence_caps(60, last_slot);
[opheld2,dragon_defender_t] @levelrequire_defence(60, last_slot);
[opheld2,dragon_platelegs_g] @levelrequire_defence_caps(60, last_slot);
[opheld2,dragon_scimitar_or] @levelrequire_mm_quest_attack(60, last_slot);
[opheld2,dragon_sq_shield_g] @levelrequire_legends_quest_defence(60, last_slot);
[opheld2,red_dhide_body_g] @levelrequire_ranged_and_defence(60, 40, last_slot);
[opheld2,red_dhide_body_t] @levelrequire_ranged_and_defence(60, 40, last_slot);
[opheld2,red_dhide_chaps_g] @levelrequire_ranged_lower(60, last_slot);
[opheld2,red_dhide_chaps_t] @levelrequire_ranged_lower(60, last_slot);
[opheld2,tbwt_dragon_spear_kp] @levelrequire_attack_caps(60, last_slot);
[opheld2,tzhaar_ket_om_t] @levelrequire_strength(60, last_slot);

// Variants that went on at level 1 because nothing gated them (security review, 2026-10-19):
// coloured whips, ornament godswords, trimmed/gold/god skirts and hides, heraldic rune.
// The generic [opheld2,_] equip checks no stats, so every wearable needs its own line.
[opheld2,dragon_plateskirt_g] @levelrequire_defence_caps(60, last_slot);

// The dragon harpoon is the dragon axe over again: 60 Attack to wield it, which is this line,
// and 61 Fishing to fish with it, which is separate and lives in skill_fishing/scripts/fishing.rs2.
[opheld2,dragon_harpoon] @levelrequire_attack(60, last_slot);
